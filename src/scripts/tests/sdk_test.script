Include(_("test_base.script"));

class sdkTest extends script_test_base
{
    function Run()
    {
        clear_global_test_results()
        test_allow_build_without_sources();
        print_global_test_result();
    }

    function test_allow_build_without_sources()
    {
        clear_test_result();

        local projectMgr = GetProjectManager();
        test_false("GetProjectManager", IsNull(projectMgr));

        // Keep all artifacts isolated to a single dedicated temp directory.
        local tempFolder = MakeDir(GetFolder(0x4),
                                     _T("sdk_allow_build_without_sources_tests"));
        FolderCleanup(tempFolder);

        projectMgr.SetDefaultPath(tempFolder);

        local project1 = projectMgr.NewProject(MakePath(tempFolder, _T("Allow1.cbp")));
        local project2 = projectMgr.NewProject(MakePath(tempFolder, _T("Allow2.cbp")));
        test_false("Project1 is not null", IsNull(project1));
        test_false("Project2 is not null", IsNull(project2));

        // Default must be false when the option is absent.
        test_false("project1 default allow_build_without_sources",
                    project1.GetAllowBuildWithoutSources());
        test_false("project2 default allow_build_without_sources",
                    project2.GetAllowBuildWithoutSources());

        // Independence between projects: toggling project1 must not affect project2.
        project1.SetAllowBuildWithoutSources(true);
        test_true("project1 after SetAllowBuildWithoutSources(true)",
                   project1.GetAllowBuildWithoutSources());
        test_false("project2 remains false after project1 toggle",
                    project2.GetAllowBuildWithoutSources());

        // Save-close-reload persistence.
        local project1Filename = clone project1.GetFilename();
        local project2Filename = clone project2.GetFilename();

        test_true("project1 Save", project1.Save());
        test_true("project2 Save", project2.Save());

        test_true("Close project1", projectMgr.CloseProject(project1, true, true));
        test_true("Close project2", projectMgr.CloseProject(project2, true, true));

        local reloaded1 = projectMgr.LoadProject(project1Filename, false);
        local reloaded2 = projectMgr.LoadProject(project2Filename, false);
        test_false("reloaded1 is not null", IsNull(reloaded1));
        test_false("reloaded2 is not null", IsNull(reloaded2));

        test_true("reloaded1 persisted allow_build_without_sources",
                  reloaded1.GetAllowBuildWithoutSources());
        test_false("reloaded2 still default false",
                   reloaded2.GetAllowBuildWithoutSources());

        // Cleanup everything created by this test.
        test_true("Close reloaded1", projectMgr.CloseProject(reloaded1, true, true));
        test_true("Close reloaded2", projectMgr.CloseProject(reloaded2, true, true));
        FolderCleanup(tempFolder);
        
        print_test_result();

        local result =
            _T("AllowBuildWithoutSources test complete.\n\n")
            + _T("Executed: ") + ::made_tests + _T("\n")
            + _T("Passed: ") + ::passed_tests + _T("\n")
            + _T("Failed: ") + ::failed_tests;

        if (::failed_tests == 0)
            ::ShowInfo(result);
        else
            ::ShowError(result);



    }

    function FolderCleanup(folder)
{
    print("FolderCleanup target: '" + folder + "'\n");

    if (::PLATFORM == ::PLATFORM_MSW)
    {
        local allowedRoot = _T("C:\\Users\\thoma\\AppData\\Local\\Temp\\");

        print("FolderCleanup allowed root: '" + allowedRoot + "'\n");

        // Must contain something below the allowed root.
        if (folder.length() <= allowedRoot.length())
            throw "SAFETY: refusing FolderCleanup at or above allowed temp root: '" + folder + "'";

        // Compare the prefix character by character.
        for (local i = 0; i < allowedRoot.length(); ++i)
        {
            if (folder.GetChar(i) != allowedRoot.GetChar(i))
                throw "SAFETY: refusing FolderCleanup outside allowed temp root: '" + folder + "'";
        }
    }

    if (IO.DirectoryExists(folder))
    {
        print("Note: Deleting recursively '" + folder + "'\n");

        if (::PLATFORM != ::PLATFORM_MSW)
            IO.Execute(_T("rm -rf \"") + folder + _T("\""));
        else
            IO.Execute(_T("cmd /c rd /s /q \"") + folder + _T("\""));

        if (IO.DirectoryExists(folder))
            throw "Cannot delete folder: '" + folder + "'! Aborting!";
    }

    print("Note: Creating '" + folder + "'\n");
    IO.CreateDirectory(folder, 0755);

    if (!IO.DirectoryExists(folder))
        throw "Cannot create folder: '" + folder + "'! Aborting!";
}


	

    function MakePath(folder, name)
    {
        if (folder.IsEmpty())
            return name;
        else if (folder.GetChar(folder.length() - 1) != ::wxFILE_SEP_PATH.GetChar(0))
            return folder + ::wxFILE_SEP_PATH + name;
        else
            return folder + name;
    }

    function MakeDir(folder, name)
    {
        local result = MakePath(folder, name);
        if (!result.IsEmpty()
            && (result.GetChar(result.length() - 1) != ::wxFILE_SEP_PATH.GetChar(0)))
        {
            result += ::wxFILE_SEP_PATH;
        }
        return result;
    }

   

  

    }

////////////////////////////////////////////////////////////////////////////////
//
// GTK project wizard
// macOS modernised for GTK 4 through Homebrew.
// Windows and other Unix behaviour intentionally remain unchanged for later work.
//
////////////////////////////////////////////////////////////////////////////////

// globals (Windows location page)
GtkPathDefault    <- _T("$(#gtk)");
GtkPathDefaultInc <- _T("$(#gtk.include)");
GtkPathDefaultLib <- _T("$(#gtk.lib)");
GtkPath           <- _T("");
// GtkVersion <- 1; // 0 - GTK+, 1 - GTK+-2.0

// macOS: filled only after the installed Homebrew GTK 4 tree is accepted.
GtkMacPrefix       <- _T("");
GtkMacInclude      <- _T("");
GtkMacLib          <- _T("");
GtkMacPkgConfig    <- _T("");
GtkMacState        <- _T("");
GtkMacAccess       <- _T("");
GtkMacExecutable   <- _T("");

function BeginWizard()
{
    local intro_msg = _("Welcome to the new GTK project wizard!\n") +
                      _("This wizard will guide you to create a new GTK project\nusing the GTK cross-platform GUI toolkit.\n\n") +
                      _("On macOS this wizard uses GTK 4 supplied by Homebrew.\n\n") +
                      _("When you're ready to proceed, please click \"Next\"...");

    Wizard.AddInfoPage(_T("GtkIntro"), intro_msg);

    // On macOS the accepted Homebrew prefix replaces $(#gtk), so no location
    // page is registered. An unavailable dependency blocks project creation.
    if (PLATFORM == PLATFORM_MAC)
    {
        local reason = GtkMacBlockReason();
        if (!reason.IsEmpty())
            Wizard.AddInfoPage(_T("GtkMacDiag"), GtkMacPageText(reason));
    }

    Wizard.AddProjectPathPage();

    if (PLATFORM == PLATFORM_MSW)
    {
        local gtkpath_msg = _("Please select the location of GTK on your computer.\n") +
                            _("This is the top-level folder where GTK was installed.\n") +
                            _("To help you, this folder must contain the subfolders\n\"include\" and \"lib\".\n\n") +
                            _("You can also use a global variable, e.g. $(#gtk).\n");

        Wizard.AddGenericSelectPathPage(_T("GtkPath"), gtkpath_msg,
                                        _("GTK's location:"), GtkPathDefault);
    }
    /*else
    {
        Wizard.AddGenericSingleChoiceListPage(_T("GtkVersionPage"), _("Please select the GTK+ version you want to use."), _T("GTK+ 1.x;GTK+ 2.x"), GtkVersion);
    }*/

    Wizard.AddCompilerPage(_T(""), _T("gcc*"), true, true);
}

////////////////////////////////////////////////////////////////////////////////
// GTK path page (Windows, unchanged)
////////////////////////////////////////////////////////////////////////////////

function OnLeave_GtkPath(fwd)
{
    if (fwd)
    {
        local dir         = Wizard.GetTextControlValue(_T("txtFolder"));
        local dir_nomacro = VerifyDirectory(dir);

        if (dir_nomacro.IsEmpty())
            return false;

        // verify include dependencies
        local dir_nomacro_inc = GetCompilerIncludeDir(dir, GtkPathDefault, GtkPathDefaultInc);
        if (dir_nomacro_inc.IsEmpty())
            return false;
        if (!VerifyFile(dir_nomacro_inc + wxFILE_SEP_PATH + _T("gtk-2.0") + wxFILE_SEP_PATH + _T("gtk"), _T("gtk.h"), _("GTK's include")))
            return false;

        // verify library dependencies
        local dir_nomacro_lib = GetCompilerLibDir(dir, GtkPathDefault, GtkPathDefaultLib);
        if (dir_nomacro_lib.IsEmpty())
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("gtk-win32-2.0"), _("GTK's")))
            return false;

        GtkPath = dir;

        local is_macro = _T("");

        is_macro = GetCompilerIncludeMacro(dir, GtkPathDefault, GtkPathDefaultInc);
        if (is_macro.IsEmpty())
            GtkPathDefaultInc = dir_nomacro_inc;

        is_macro = GetCompilerLibMacro(dir, GtkPathDefault, GtkPathDefaultLib);
        if (is_macro.IsEmpty())
            GtkPathDefaultLib = dir_nomacro_lib;
    }
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// GTK version page (other Unix, retained unchanged)
////////////////////////////////////////////////////////////////////////////////

function OnLeave_GtkVersionPage(fwd)
{
    if (fwd)
        GtkVersion = Wizard.GetListboxSelection(_T("GenericChoiceList"));
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// macOS Homebrew support
////////////////////////////////////////////////////////////////////////////////

function GtkReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");
    local from = at + needle.Length();
    local rest = report.Mid(from, report.Length() - from);
    local nl = rest.Find(_T("\n"));
    if (nl == -1)
        return rest;
    return rest.Mid(0, nl);
}

function GtkMacClear()
{
    GtkMacPrefix    = _T("");
    GtkMacInclude   = _T("");
    GtkMacLib       = _T("");
    GtkMacPkgConfig = _T("");
}

// Empty string means that GTK 4 and pkg-config are complete and may be used by
// the project. Any other string is a blocking diagnostic.
function GtkMacPrefixDecision(prefix)
{
    GtkMacClear();
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0)
        return _("GTK 4's prefix is not a directory. No project was created.");

    local includeDir = prefix + _T("/include/gtk-4.0");
    local libDir     = prefix + _T("/lib");

    if (!IO.FileExists(includeDir + _T("/gtk/gtk.h")))
        return _("GTK 4 was found, but include/gtk-4.0/gtk/gtk.h is not under ") + prefix + _(". No project was created.");
    if (!IO.FileExists(libDir + _T("/libgtk-4.dylib")))
        return _("GTK 4 was found, but libgtk-4.dylib is not under ") + prefix + _("/lib. No project was created.");
    if (!IO.FileExists(libDir + _T("/pkgconfig/gtk4.pc")))
        return _("GTK 4 was found, but lib/pkgconfig/gtk4.pc is not under ") + prefix + _(". No project was created.");

    // Homebrew GTK 4 depends on pkgconf. Resolve its executable separately so
    // the generated project does not depend on the GUI application's PATH.
    local pkgReport = Wizard.MacBrewFormula(_T("pkgconf"));
    if (!GtkReportField(pkgReport, _T("access")).Matches(_T("works")) ||
        !GtkReportField(pkgReport, _T("state")).Matches(_T("installed")))
        return _("GTK 4 was found, but Homebrew pkgconf is unavailable. No project was created.");

    local pkgPrefix = GtkReportField(pkgReport, _T("prefix"));
    local pkgConfig = pkgPrefix + _T("/bin/pkg-config");
    if (!IO.FileExists(pkgConfig))
        return _("GTK 4 was found, but pkg-config is not under ") + pkgPrefix + _("/bin. No project was created.");

    GtkMacPrefix    = prefix;
    GtkMacInclude   = includeDir;
    GtkMacLib       = libDir;
    GtkMacPkgConfig = pkgConfig;
    return _T("");
}

function GtkMacBlockReason()
{
    local report = Wizard.MacBrewFormula(_T("gtk4"));
    GtkMacState      = GtkReportField(report, _T("state"));
    GtkMacAccess     = GtkReportField(report, _T("access"));
    GtkMacExecutable = GtkReportField(report, _T("executable"));

    if (GtkMacState.Matches(_T("installed")))
        return GtkMacPrefixDecision(GtkReportField(report, _T("prefix")));

    GtkMacClear();
    if (GtkMacState.Matches(_T("missing")))
        return _("Homebrew reports that GTK 4 is not installed. This wizard will not create a project.");
    if (GtkMacState.Matches(_T("brew_unavailable")))
        return _("Homebrew could not be used. This wizard will not create a project.");
    return _("Homebrew could not be asked about GTK 4. This wizard will not create a project.");
}

function GtkMacPageText(reason)
{
    local text = _("Some project templates obtain libraries through Homebrew.\n") +
                 _("Code::Blocks does not install Homebrew.\n\n");

    if (GtkMacAccess.Matches(_T("works")))
    {
        text = text + _("Homebrew\n    Found: ") + GtkMacExecutable +
               _("\n    Access from Code::Blocks: OK\n\n");
    }
    else if (GtkMacAccess.Matches(_T("present_unusable")))
    {
        text = text + _("Homebrew\n    Found: ") + GtkMacExecutable +
               _("\n    Access from Code::Blocks: failed\n") +
               _("That executable was left in place.\n\n");
    }
    else
        text = text + _("Homebrew\n    Not detected\n\n");

    if (GtkMacState.Matches(_T("missing")))
        text = text + _("GTK 4\n    Not installed\n\n");
    else if (GtkMacAccess.Matches(_T("works")) && !reason.IsEmpty())
        text = text + reason + _("\n\n");

    text = text + _("No project is created from this page.\n");
    if (GtkMacState.Matches(_T("missing")))
        text = text + _("Press Next to install the gtk4 formula with Homebrew.\n") +
                      _("Cancel on that dialog does not start the install.\n") +
                      _("Use Cancel on this page to close the wizard.\n");
    else if (GtkMacAccess.Matches(_T("works")))
        text = text + _("Use Cancel to close the wizard.\n");
    else
        text = text + _("Press Next to choose an existing brew executable, or to open https://brew.sh.\n") +
                      _("Use Cancel to close the wizard.\n");
    return text;
}

function GtkMacConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacBrewTry(path, true);
    if (GtkReportField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }
    return _("That file did not pass brew --version, so it was not remembered.") +
           _("\n\n") + GtkReportField(report, _T("executable")) +
           _("\n") + GtkReportField(report, _T("version"));
}

function GtkMacOfferInstall()
{
    local explanation = _("This project needs GTK 4.\n\n") +
                        _("Code::Blocks will ask Homebrew to install the formula \"gtk4\".\n") +
                        _("Nothing is installed until you choose Install GTK 4 using Homebrew.\n") +
                        _("Cancel on this dialog does not start Homebrew.");
    local report = Wizard.MacBrewInstall(_T("gtk4"), explanation,
                                         _("Install GTK 4 using Homebrew"));
    if (GtkReportField(report, _T("success")).Matches(_T("1")))
    {
        local reason = GtkMacBlockReason();
        if (reason.IsEmpty())
            return true;
        ShowMessage(GtkMacPageText(reason));
        return false;
    }
    if (GtkReportField(report, _T("password")).Matches(_T("1")))
    {
        ShowError(_("Homebrew asked for a password. The install was stopped and is not treated as successful. No project was created."));
        return false;
    }
    if (GtkReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The install was stopped. That does not undo files Homebrew may already have written. No project was created."));
        return false;
    }
    if (GtkReportField(report, _T("launched")).Matches(_T("1")))
        ShowError(_("Homebrew did not finish successfully. GTK 4 was not marked installed. No project was created.\n\n") +
                  GtkReportField(report, _T("output")));
    return false;
}

function OnLeave_GtkMacDiag(fwd)
{
    if (!fwd)
        return true;
    if (GtkMacBlockReason().IsEmpty())
        return true;

    if (!GtkMacAccess.Matches(_T("works")))
    {
        local choice = Wizard.MacBrewChoice(
            _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
            _("Help me find Homebrew"),
            _("Installation instructions"));
        if (choice == 1)
        {
            local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
            local rejected = GtkMacConsiderBrew(picked);
            if (!rejected.IsEmpty())
                ShowError(rejected);
        }
        else if (choice == 2)
            wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);

        if (GtkMacBlockReason().IsEmpty())
            return true;
        return false;
    }

    if (GtkMacState.Matches(_T("missing")))
        return GtkMacOfferInstall();
    return false;
}

function GtkMacAllowForward()
{
    if (PLATFORM != PLATFORM_MAC)
        return true;
    local reason = GtkMacBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowError(reason);
    return false;
}

function OnLeave_ProjectPathPage(fwd)
{
    if (fwd)
        return GtkMacAllowForward();
    return true;
}

function OnLeave_CompilerPage(fwd)
{
    if (fwd)
        return GtkMacAllowForward();
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// project creation
////////////////////////////////////////////////////////////////////////////////

function GetFilesDir()
{
    return _T("gtk/files");
}

function SetupProject(project)
{
    if (PLATFORM == PLATFORM_MAC)
    {
        if (GtkMacPrefix.IsEmpty() || GtkMacInclude.IsEmpty() ||
            GtkMacLib.IsEmpty() || GtkMacPkgConfig.IsEmpty())
            return false;

        // Use GTK 4's pkg-config contract. The absolute Homebrew pkg-config path
        // avoids relying on the GUI application's inherited shell PATH.
        project.AddCompilerOption(_T("`") + GtkMacPkgConfig + _T(" gtk4 --cflags`"));
        project.AddLinkerOption(_T("`") + GtkMacPkgConfig + _T(" gtk4 --libs`"));
    }
    else if (PLATFORM == PLATFORM_MSW)
    {
        // Existing Windows GTK 2 path intentionally retained for later work.
        project.AddIncludeDir(GtkPathDefaultInc);
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("gtk-2.0"));
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("cairo"));
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("gdk"));
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("glib-2.0"));
        project.AddIncludeDir(GtkPathDefaultLib + wxFILE_SEP_PATH + _T("glib-2.0") + wxFILE_SEP_PATH + _T("include"));
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("pango-1.0"));
        project.AddIncludeDir(GtkPathDefaultLib + wxFILE_SEP_PATH + _T("gtk-2.0") + wxFILE_SEP_PATH + _T("include"));
        project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("atk-1.0"));
        if (IO.DirectoryExists(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("gdk-pixbuf-2.0")))
            project.AddIncludeDir(GtkPathDefaultInc + wxFILE_SEP_PATH + _T("gdk-pixbuf-2.0"));

        project.AddLibDir(GtkPathDefaultLib);
        project.AddLinkLib(_T("gtk-win32-2.0"));
        project.AddLinkLib(_T("gobject-2.0"));
        project.AddLinkLib(_T("glib-2.0"));
        project.AddCompilerOption(_T("-mms-bitfields"));
    }
    else
    {
        // Existing Linux/other Unix GTK 2 path intentionally retained for later work.
        project.AddCompilerOption(_T("`pkg-config gtk+-2.0 --cflags`"));
        project.AddLinkerOption(_T("`pkg-config gtk+-2.0 --libs`"));
    }

    WarningsOn(project, Wizard.GetCompilerID());

    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly);
        target.SetOutputFilename(Wizard.GetDebugOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable);
        target.SetOutputFilename(Wizard.GetReleaseOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

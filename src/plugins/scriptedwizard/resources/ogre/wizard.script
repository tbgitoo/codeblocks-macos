////////////////////////////////////////////////////////////////////////////////
// Ogre3D project wizard
// v3.8 / M3.4: prerequisites, source acquisition, native paths,
// CMake configure/build/install, and installed-SDK validation.
////////////////////////////////////////////////////////////////////////////////

OgrePath <- _T("");
OgreIsSource <- false;

OgreMacAccess <- _T("");
OgreMacExecutable <- _T("");
OgreMacCMakeState <- _T("");
OgreMacPkgconfState <- _T("");
OgreMacSDL2State <- _T("");
OgreMacAssimpState <- _T("");

OgreMacCMakePrefix <- _T("");
OgreMacPkgconfPrefix <- _T("");
OgreMacSDL2Prefix <- _T("");
OgreMacAssimpPrefix <- _T("");

OgreMacGitAccess <- _T("");
OgreMacGitExecutable <- _T("");
OgreMacGitVersion <- _T("");

OgreMacPatchId <- _T("ogre-14.6.3-assimp-sidecar");
OgreWinConfigDialogPatchId <- _T("ogre-14.6.3-win-config-dialog");
OgreMacPatchState <- _T("");
OgreMacPatchError <- _T("");
OgreMacRebuildRequired <- false;
OgreMacPatchPendingKey <- _T("/macos/ogre/patch_rebuild_required");


OgreMacNativeCMakeAccess <- _T("");
OgreMacNativeCMakeExecutable <- _T("");
OgreMacNativeCMakeVersion <- _T("");

OgreMacRoot <- _T("");
OgreMacSource <- _T("");
OgreMacBuild <- _T("");
OgreMacInstall <- _T("");
OgreMacPathsValid <- false;
OgreMacBuildSucceeded <- false;
OgreMacInstallSucceeded <- false;

OgreMacRepository <- _T("https://github.com/OGRECave/ogre.git");
OgreMacTag <- _T("v14.6.3");
OgreMacSourceLeaf <- _T("ogre-source-14.6.3");
OgreMacInstallLeaf <- _T("ogre-14.6.3");

function OgreReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1) return _T("");
    local rest = report.Mid(at + needle.Length(), report.Length() - at - needle.Length());
    local nl = rest.Find(_T("\n"));
    return nl == -1 ? rest : rest.Mid(0, nl);
}

////////////////////////////////////////////////////////////////////////////////
// Homebrew prerequisites
////////////////////////////////////////////////////////////////////////////////

function OgreMacClear()
{
    OgreMacAccess = _T(""); OgreMacExecutable = _T("");
    OgreMacCMakeState = _T(""); OgreMacPkgconfState = _T(""); OgreMacSDL2State = _T(""); OgreMacAssimpState = _T("");
    OgreMacCMakePrefix = _T(""); OgreMacPkgconfPrefix = _T(""); OgreMacSDL2Prefix = _T(""); OgreMacAssimpPrefix = _T("");
}

function OgreMacRememberBrew(report)
{
    local access = OgreReportField(report, _T("access"));
    local executable = OgreReportField(report, _T("executable"));
    if (!access.IsEmpty()) OgreMacAccess = access;
    if (!executable.IsEmpty()) OgreMacExecutable = executable;
}

function OgreMacValidateCMake(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0) return _("Homebrew reports CMake as installed, but its prefix is invalid.");
    if (!IO.FileExists(prefix + _T("/bin/cmake"))) return _("CMake was found, but bin/cmake is not present under its Homebrew prefix.");
    OgreMacCMakePrefix = prefix; return _T("");
}

function OgreMacValidatePkgconf(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0) return _("Homebrew reports pkgconf as installed, but its prefix is invalid.");
    if (!IO.FileExists(prefix + _T("/bin/pkgconf")) && !IO.FileExists(prefix + _T("/bin/pkg-config"))) return _("pkgconf was found, but neither bin/pkgconf nor bin/pkg-config is present under its Homebrew prefix.");
    OgreMacPkgconfPrefix = prefix; return _T("");
}

function OgreMacValidateSDL2(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0) return _("Homebrew reports SDL2 as installed, but its prefix is invalid.");
    if (!IO.FileExists(prefix + _T("/include/SDL2/SDL.h"))) return _("SDL2 was found, but include/SDL2/SDL.h is not present under its Homebrew prefix.");
    if (!IO.FileExists(prefix + _T("/lib/libSDL2.dylib"))) return _("SDL2 was found, but lib/libSDL2.dylib is not present under its Homebrew prefix.");
    OgreMacSDL2Prefix = prefix; return _T("");
}

function OgreMacValidateAssimp(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0)
        return _("Homebrew reports Assimp as installed, but its prefix is invalid.");

    if (!IO.FileExists(prefix + _T("/include/assimp/Importer.hpp")))
        return _("Assimp was found, but include/assimp/Importer.hpp is not present under its Homebrew prefix.");

    OgreMacAssimpPrefix = prefix;
    return _T("");
}

function OgreMacBlockReason()
{
    OgreMacClear();
    local report = Wizard.MacBrewFormula(_T("cmake"));
    OgreMacRememberBrew(report); OgreMacCMakeState = OgreReportField(report, _T("state"));
    if (!OgreMacAccess.Matches(_T("works"))) return OgreMacAccess.Matches(_T("present_unusable")) ? _("Homebrew was found but could not be used from Code::Blocks.") : _("Homebrew could not be used.");
    if (OgreMacCMakeState.Matches(_T("installed"))) { local r = OgreMacValidateCMake(OgreReportField(report, _T("prefix"))); if (!r.IsEmpty()) return r; }
    else if (OgreMacCMakeState.Matches(_T("missing"))) return _("CMake is not installed."); else return _("Homebrew could not be asked about CMake.");

    report = Wizard.MacBrewFormula(_T("pkgconf"));
    OgreMacRememberBrew(report); OgreMacPkgconfState = OgreReportField(report, _T("state"));
    if (OgreMacPkgconfState.Matches(_T("installed"))) { local r = OgreMacValidatePkgconf(OgreReportField(report, _T("prefix"))); if (!r.IsEmpty()) return r; }
    else if (OgreMacPkgconfState.Matches(_T("missing"))) return _("pkgconf is not installed."); else return _("Homebrew could not be asked about pkgconf.");

    report = Wizard.MacBrewFormula(_T("sdl2"));
    OgreMacRememberBrew(report); OgreMacSDL2State = OgreReportField(report, _T("state"));
    if (OgreMacSDL2State.Matches(_T("installed"))) { local r = OgreMacValidateSDL2(OgreReportField(report, _T("prefix"))); if (!r.IsEmpty()) return r; }
    else if (OgreMacSDL2State.Matches(_T("missing"))) return _("SDL2 is not installed."); else return _("Homebrew could not be asked about SDL2.");
    
    
     report = Wizard.MacBrewFormula(_T("assimp"));
    OgreMacRememberBrew(report);
    OgreMacAssimpState = OgreReportField(report, _T("state"));

    if (OgreMacAssimpState.Matches(_T("installed")))
    {
        local r = OgreMacValidateAssimp(
            OgreReportField(report, _T("prefix")));

        if (!r.IsEmpty())
            return r;
    }
    else if (OgreMacAssimpState.Matches(_T("missing")))
        return _("Assimp is not installed.");
    else
        return _("Homebrew could not be asked about Assimp.");
        
     return _T("");
    
}

function OgreMacStatusLine(label, state, prefix)
{
    if (state.Matches(_T("installed")) && !prefix.IsEmpty()) return label + _("\n    Installed: ") + prefix + _("\n\n");
    if (state.Matches(_T("missing"))) return label + _("\n    Not installed\n\n");
    return label + _("\n    Could not be checked\n\n");
}

function OgreMacPageText(reason)
{
    local text = _("The macOS OGRE workflow builds the official OGRE v14.6.3 from source.\nRequired Homebrew formulas:\n    cmake\n    pkgconf\n    sdl2\nassimp\n\nCode::Blocks does not install Homebrew.\n\n");
    text += OgreMacAccess.Matches(_T("works")) ? _("Homebrew\n    Found: ") + OgreMacExecutable + _("\n    Access from Code::Blocks: OK\n\n") : _("Homebrew\n    Not usable\n\n");
    text += OgreMacStatusLine(_("CMake"), OgreMacCMakeState, OgreMacCMakePrefix);
    text += OgreMacStatusLine(_("pkgconf"), OgreMacPkgconfState, OgreMacPkgconfPrefix);
    text += OgreMacStatusLine(_("SDL2"), OgreMacSDL2State, OgreMacSDL2Prefix);
    text += OgreMacStatusLine(
    _("Assimp"),
    OgreMacAssimpState,
    OgreMacAssimpPrefix);
    if (!reason.IsEmpty()) text += reason + _("\n\n");
    text += !OgreMacAccess.Matches(_T("works")) ? _("Press Next to choose an existing brew executable or open the Homebrew site.\n") : _("Press Next to install the next missing prerequisite with Homebrew.\n");
    return text;
}

function OgreMacConsiderBrew(path)
{
    if (path.IsEmpty()) return _T("");
    local report = Wizard.MacBrewTry(path, true);
    if (OgreReportField(report, _T("access")).Matches(_T("works"))) { GetConfigManager().Write(_T("/macos/homebrew/executable"), path); return _T(""); }
    return _("That file did not pass brew --version, so it was not remembered.\n\n") + OgreReportField(report, _T("version"));
}

function OgreMacOfferHomebrewHelp()
{
    local choice = Wizard.MacBrewChoice(_("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."), _("Help me find Homebrew"), _("Installation instructions"));
    if (choice == 1) { local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*")); local rejected = OgreMacConsiderBrew(picked); if (!rejected.IsEmpty()) ShowError(rejected); }
    else if (choice == 2) wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
}

function OgreMacInstallFormula(formula, displayName)
{
    local explanation = _("The macOS OGRE workflow needs ") + displayName + _(".\n\nCode::Blocks will ask Homebrew to install the formula \"") + formula + _("\".\nNothing is installed until you approve it.");
    local report = Wizard.MacBrewInstall(formula, explanation, _("Install ") + displayName + _(" using Homebrew"));
    if (OgreReportField(report, _T("success")).Matches(_T("1"))) return true;
    if (OgreReportField(report, _T("password")).Matches(_T("1"))) ShowError(_("Homebrew asked for a password. The install was stopped."));
    else if (OgreReportField(report, _T("cancelled")).Matches(_T("1"))) ShowMessage(_("The install was stopped. Files already written are left in place."));
    else if (OgreReportField(report, _T("launched")).Matches(_T("1"))) ShowError(displayName + _(" was not installed successfully.\n\n") + OgreReportField(report, _T("output")));
    return false;
}

function OgreMacOfferNextMissingInstall()
{
    if (OgreMacCMakeState.Matches(_T("missing")))
        return OgreMacInstallFormula(_T("cmake"), _("CMake"));

    if (OgreMacPkgconfState.Matches(_T("missing")))
        return OgreMacInstallFormula(_T("pkgconf"), _("pkgconf"));

    if (OgreMacSDL2State.Matches(_T("missing")))
        return OgreMacInstallFormula(_T("sdl2"), _("SDL2"));

    if (OgreMacAssimpState.Matches(_T("missing")))
        return OgreMacInstallFormula(_T("assimp"), _("Assimp"));

    return false;
}

function OnLeave_OgreMacPrerequisites(fwd)
{
    if (!fwd) return true;
    local reason = OgreMacBlockReason(); if (reason.IsEmpty()) return true;
    if (!OgreMacAccess.Matches(_T("works"))) { OgreMacOfferHomebrewHelp(); return OgreMacBlockReason().IsEmpty(); }
    if (!OgreMacOfferNextMissingInstall()) return false;
    reason = OgreMacBlockReason(); if (reason.IsEmpty()) return true;
    ShowMessage(OgreMacPageText(reason)); return false;
}

////////////////////////////////////////////////////////////////////////////////
// Native CMake validation, paths, configure, build, install and validation
////////////////////////////////////////////////////////////////////////////////

function OgreMacResolvePaths()
{
    OgreMacPathsValid = false; OgreMacRoot = _T(""); OgreMacSource = _T(""); OgreMacBuild = _T(""); OgreMacInstall = _T("");
    local report = Wizard.MacCMakePaths(OgreMacSourceLeaf, OgreMacInstallLeaf);
    if (!OgreReportField(report, _T("valid")).Matches(_T("1"))) return OgreReportField(report, _T("error"));
    OgreMacRoot = OgreReportField(report, _T("root")); OgreMacSource = OgreReportField(report, _T("source"));
    OgreMacBuild = OgreReportField(report, _T("build")); OgreMacInstall = OgreReportField(report, _T("install"));
    if (OgreMacRoot.IsEmpty() || OgreMacSource.IsEmpty() || OgreMacBuild.IsEmpty() || OgreMacInstall.IsEmpty()) return _("CMake path resolution returned an incomplete result.");
    OgreMacPathsValid = true; return _T("");
}

function OgreMacNativeCMakeBlockReason()
{
    local report = Wizard.MacCMakeProbe();
    OgreMacNativeCMakeAccess = OgreReportField(report, _T("access")); OgreMacNativeCMakeExecutable = OgreReportField(report, _T("executable")); OgreMacNativeCMakeVersion = OgreReportField(report, _T("version"));
    if (OgreMacNativeCMakeAccess.Matches(_T("works"))) return OgreMacResolvePaths();
    if (OgreMacNativeCMakeAccess.Matches(_T("present_unusable"))) return _("CMake was found but failed cmake --version.");
    return _("CMake could not be found by the native CMake helper.");
}

function OgreMacConsiderNativeCMake(path)
{
    if (path.IsEmpty()) return _T("");
    local report = Wizard.MacCMakeTry(path);
    if (OgreReportField(report, _T("access")).Matches(_T("works"))) { GetConfigManager().Write(_T("/macos/cmake/executable"), path); return _T(""); }
    return _("That file did not pass cmake --version, so it was not remembered.\n\n") + OgreReportField(report, _T("version")) + _("\n") + OgreReportField(report, _T("error"));
}

function OgreMacCMakePageText(reason)
{
    local text = _("CMake validation and Code::Blocks-owned paths.\n\n");
    text += OgreMacNativeCMakeAccess.Matches(_T("works")) ? _("CMake\n    Found: ") + OgreMacNativeCMakeExecutable + _("\n    Version: ") + OgreMacNativeCMakeVersion + _("\n\n") : _("CMake\n    Not usable through the native helper\n\n");
    if (OgreMacPathsValid) text += _("Root:\n    ") + OgreMacRoot + _("\n\nSource:\n    ") + OgreMacSource + _("\n\nBuild:\n    ") + OgreMacBuild + _("\n\nInstall:\n    ") + OgreMacInstall + _("\n\n");
    text += !reason.IsEmpty() ? reason + _("\n\nPress Next to choose an existing CMake executable.\n") : _("CMake and paths are ready.\n");
    return text;
}

function OnLeave_OgreMacCMake(fwd)
{
    if (!fwd) return true;
    local reason = OgreMacNativeCMakeBlockReason(); if (reason.IsEmpty()) return true;
    if (!OgreMacNativeCMakeAccess.Matches(_T("works"))) { local picked = IO.SelectFile(_("Choose the CMake executable"), _T(""), _("All files (*)|*")); local rejected = OgreMacConsiderNativeCMake(picked); if (!rejected.IsEmpty()) ShowError(rejected); }
    reason = OgreMacNativeCMakeBlockReason(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    return true;
}

function OgreMacConfigured()
{
    if (!OgreMacPathsValid) { local reason = OgreMacResolvePaths(); if (!reason.IsEmpty()) return false; }
    return IO.FileExists(OgreMacBuild + _T("/CMakeCache.txt"));
}

function OgreMacBuilt()
{
    if (!OgreMacPathsValid)
    {
        local reason = OgreMacResolvePaths();
        if (!reason.IsEmpty())
            return false;
    }

    return IO.FileExists(
               OgreMacBuild +
               _T("/bin/SampleBrowser.app/Contents/MacOS/SampleBrowser")) &&
           IO.FileExists(
               OgreMacBuild +
               _T("/lib/macosx/RenderSystem_GL.framework/RenderSystem_GL")) &&
           IO.FileExists(
               OgreMacBuild +
               _T("/lib/macosx/RenderSystem_GL3Plus.framework/RenderSystem_GL3Plus"));
}

function OgreMacInstalled()
{
    if (!OgreMacPathsValid)
    {
        local reason = OgreMacResolvePaths();
        if (!reason.IsEmpty())
            return false;
    }

    return IO.FileExists(
               OgreMacInstall +
               _T("/CMake/OGREConfig.cmake")) &&
           IO.FileExists(
               OgreMacInstall +
               _T("/bin/resources.cfg"));
}

function OgreMacConfigurePageText()
{
    return _("OGRE 14.6.3 is ready to be configured with CMake.\n\nSource:\n    ") + OgreMacSource + _("\n\nBuild:\n    ") + OgreMacBuild + _("\n\nInstall:\n    ") + OgreMacInstall + _("\n\nBuild type:\n    Release\n\nPress Next to configure OGRE.\nThis step does not build or install OGRE.\n");
}

function OgreMacConfigureOgre()
{
    local reason = OgreMacResolvePaths(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    local explanation = _("Code::Blocks will configure OGRE 14.6.3 with CMake.\n\nSource:\n") + OgreMacSource + _("\n\nBuild:\n") + OgreMacBuild + _("\n\nInstall:\n") + OgreMacInstall + _("\n\nBuild type:\nRelease\n\nThe install prefix is fixed during this configuration step.\nOGRE is not built or installed by this operation.");
    local report = Wizard.MacCMakeConfigure(OgreMacSource, OgreMacBuild, OgreMacInstall, _T("Release"), explanation, _("Configure OGRE 14.6.3"));
    if (OgreReportField(report, _T("success")).Matches(_T("1"))) return OgreMacConfigured();
    if (OgreReportField(report, _T("cancelled")).Matches(_T("1"))) ShowMessage(_("CMake configuration was stopped. Files already written by CMake are left in place."));
    else ShowError(_("OGRE 14.6.3 was not configured successfully.\n\n") + OgreReportField(report, _T("output")));
    return false;
}

function OnLeave_OgreMacConfigure(fwd)
{
    if (!fwd) return true;
    if (OgreMacConfigured()) return true;
    return OgreMacConfigureOgre();
}

function OgreMacBuildPageText()
{
    return _("OGRE 14.6.3 is configured and ready to build.\n\nBuild directory:\n    ") + OgreMacBuild + _("\n\nCode::Blocks will use bounded native parallelism.\n\nPress Next to build OGRE.\nThis step does not install OGRE.\n");
}

function OgreMacBuildOgre()
{
    if (!OgreMacConfigured()) { ShowError(_("OGRE 14.6.3 has not been configured with CMake.")); return false; }
    local explanation = _("Code::Blocks will build OGRE 14.6.3 with CMake.\n\nBuild directory:\n") + OgreMacBuild + _("\n\nThe native helper selects a bounded parallel job count.\nThis operation does not install OGRE.");
    local report = Wizard.MacCMakeBuild(OgreMacBuild, explanation, _("Build OGRE 14.6.3"));
    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        OgreMacBuildSucceeded = OgreMacBuilt();
        if (OgreMacBuildSucceeded) return true;
        ShowError(_("CMake reported a successful build, but the expected OGRE build artefacts were not found."));
        return false;
    }
    if (OgreReportField(report, _T("cancelled")).Matches(_T("1"))) ShowMessage(_("The OGRE build was stopped. Files already produced by the build are left in place."));
    else ShowError(_("OGRE 14.6.3 was not built successfully.\n\n") + OgreReportField(report, _T("output")));
    return false;
}

function OnLeave_OgreMacBuild(fwd)
{
    if (!fwd)
        return true;

    OgreMacLoadPatchBuildState();

    if (OgreMacRebuildRequired)
        return OgreMacBuildOgre();

    if (OgreMacBuildSucceeded || OgreMacBuilt())
    {
        OgreMacBuildSucceeded = true;
        return true;
    }

    return OgreMacBuildOgre();
}

function OgreMacInstallPageText()
{
    return _("OGRE 14.6.3 is built and ready to install.\n\nBuild directory:\n    ") + OgreMacBuild + _("\n\nInstall prefix fixed during configuration:\n    ") + OgreMacInstall + _("\n\nPress Next to install and validate the OGRE SDK.\nNo replacement --prefix is supplied during installation.\n");
}

function OgreMacInstallOgre()
{
    if (!OgreMacBuilt()) { ShowError(_("OGRE 14.6.3 has not been built successfully.")); return false; }
    local explanation = _("Code::Blocks will install OGRE 14.6.3 with CMake.\n\nBuild directory:\n") + OgreMacBuild + _("\n\nInstall prefix:\n") + OgreMacInstall + _("\n\nThe install prefix was fixed during configuration.\nCode::Blocks will not pass a replacement --prefix.\nAfter installation, the native helper validates the installed SDK contract.");
    local report = Wizard.MacCMakeInstall(OgreMacBuild, OgreMacInstall, explanation, _("Install OGRE 14.6.3"));
    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        OgreMacInstallSucceeded = OgreMacInstalled();
        if (OgreMacInstallSucceeded) return true;
        ShowError(_("CMake reported a successful install, but the expected installed OGRE SDK contract was not found."));
        return false;
    }
    if (OgreReportField(report, _T("cancelled")).Matches(_T("1"))) ShowMessage(_("The OGRE install was stopped. Files already installed are left in place."));
    else ShowError(_("OGRE 14.6.3 was not installed successfully.\n\n") + OgreReportField(report, _T("output")));
    return false;
}

function OnLeave_OgreMacInstall(fwd)
{
    if (!fwd)
        return true;

    OgreMacLoadPatchBuildState();

    if (OgreMacRebuildRequired)
    {
        if (!OgreMacInstallOgre())
            return false;

        OgreMacSetRebuildRequired(false);
        return true;
    }

    if (OgreMacInstallSucceeded || OgreMacInstalled())
    {
        OgreMacInstallSucceeded = true;
        return true;
    }

    return OgreMacInstallOgre();
}

////////////////////////////////////////////////////////////////////////////////
// Git and source acquisition
////////////////////////////////////////////////////////////////////////////////

function OgreMacGitBlockReason()
{
    local report = Wizard.MacGitProbe();
    OgreMacGitAccess = OgreReportField(report, _T("access")); OgreMacGitExecutable = OgreReportField(report, _T("executable")); OgreMacGitVersion = OgreReportField(report, _T("version"));
    if (OgreMacGitAccess.Matches(_T("works"))) return _T("");
    if (OgreMacGitAccess.Matches(_T("present_unusable"))) return _("Git was found but could not be used from Code::Blocks.");
    return _("Git could not be found. Code::Blocks does not install Git.");
}

function OgreMacConsiderGit(path)
{
    if (path.IsEmpty()) return _T("");
    local report = Wizard.MacGitTry(path);
    if (OgreReportField(report, _T("access")).Matches(_T("works"))) { GetConfigManager().Write(_T("/macos/git/executable"), path); return _T(""); }
    return _("That file did not pass git --version, so it was not remembered.\n\n") + OgreReportField(report, _T("version")) + _("\n") + OgreReportField(report, _T("error"));
}

function OgreMacGitPageText(reason)
{
    local text = _("OGRE 14.6.3 is obtained from the official upstream Git repository.\n\n");
    text += OgreMacGitAccess.Matches(_T("works")) ? _("Git\n    Found: ") + OgreMacGitExecutable + _("\n    Version: ") + OgreMacGitVersion + _("\n    Access from Code::Blocks: OK\n\n") : _("Git\n    Not usable\n\n");
    if (!reason.IsEmpty()) text += reason + _("\n\n");
    return text + _("Code::Blocks does not install Git.\nPress Next to choose an existing Git executable.\n");
}

function OgreMacSourceReady()
{
    if (!OgreMacPathsValid) { local reason = OgreMacResolvePaths(); if (!reason.IsEmpty()) return false; }
    return IO.FileExists(OgreMacSource + _T("/.git/HEAD")) && IO.FileExists(OgreMacSource + _T("/CMakeLists.txt"));
}

function OgreMacAcquirePageText()
{
    local reason = OgreMacResolvePaths(); if (!reason.IsEmpty()) return reason;
    return _("The official OGRE 14.6.3 source is not present yet.\n\nRepository:\n    ") + OgreMacRepository + _("\n\nRelease tag:\n    ") + OgreMacTag + _("\n\nDestination:\n    ") + OgreMacSource + _("\n\nPress Next to approve a shallow tagged clone.\nThis step downloads source only.\n");
}

function OgreMacCloneOgre()
{
    local reason = OgreMacResolvePaths(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    local explanation = _("Code::Blocks will download the official OGRE 14.6.3 source release.\n\nRepository:\n") + OgreMacRepository + _("\n\nRelease tag:\n") + OgreMacTag + _("\n\nDestination:\n") + OgreMacSource + _("\n\nThis step downloads the source only.");
    local report = Wizard.MacGitClone(OgreMacRepository, OgreMacTag, OgreMacSource, explanation, _("Download OGRE 14.6.3"));
    if (OgreReportField(report, _T("success")).Matches(_T("1"))) return OgreMacSourceReady();
    if (OgreReportField(report, _T("cancelled")).Matches(_T("1"))) ShowMessage(_("The OGRE download was stopped. Partial files are left in place."));
    else ShowError(_("OGRE 14.6.3 was not downloaded successfully.\n\n") + OgreReportField(report, _T("output")));
    return false;
}

function OnLeave_OgreMacGit(fwd)
{
    if (!fwd) return true; if (OgreMacGitBlockReason().IsEmpty()) return true;
    local picked = IO.SelectFile(_("Choose the Git executable"), _T(""), _("All files (*)|*")); local rejected = OgreMacConsiderGit(picked); if (!rejected.IsEmpty()) ShowError(rejected);
    return OgreMacGitBlockReason().IsEmpty();
}

function OnLeave_OgreMacAcquire(fwd)
{
    if (!fwd) return true; if (OgreMacSourceReady()) return true;
    if (!OgreMacGitBlockReason().IsEmpty()) { ShowError(_("Git is not ready.")); return false; }
    return OgreMacCloneOgre();
}

function OgreMacPatchProbe()
{
    OgreMacPatchState = _T("");
    OgreMacPatchError = _T("");

    local reason = OgreMacResolvePaths();

    if (!reason.IsEmpty())
    {
        OgreMacPatchError = reason;
        return _T("");
    }

    if (!OgreMacSourceReady())
    {
        OgreMacPatchError = _("The OGRE source checkout is not present.");
        return _T("");
    }

    local report =
        Wizard.MacPatchProbe(
            OgreMacPatchId,
            OgreMacSource);

    OgreMacPatchState =
        OgreReportField(
            report,
            _T("state"));

    OgreMacPatchError =
        OgreReportField(
            report,
            _T("error"));

    return report;
}


function OgreMacPatchPageText()
{
    OgreMacPatchProbe();

    local text =
    _("Optional OGRE 14.6.3 compatibility patch\n\nThe official OGRE 14.6.3 Assimp integration passes absolute sidecar paths to OGRE's resource system, which expects names relative to the registered model resource location. OgreAssimpConverter also registers that location as non-recursive.\n\nAs a result, OBJ geometry may be converted successfully while referenced material files are not found, including material files beside the OBJ and in child directories beneath the model directory.\n\nThe compatibility patch translates sidecar requests beneath the model directory into OGRE resource names and makes the existing model resource location recursive. It does not add another filesystem root or provide unrestricted filesystem access.\n\nThe patch modifies:\n    PlugIns/Assimp/src/AssimpLoader.cpp\n    Tools/AssimpConverter/main.cpp\n\n");

    if (OgreMacPatchState.Matches(_T("applicable")))
    {
        text +=
            _("Patch state:\n    Available for this exact OGRE 14.6.3 checkout\n\nPress Next to choose whether to apply the patch.\nDeclining leaves the official upstream source unchanged.\n");
    }
    else if (OgreMacPatchState.Matches(_T("already_applied")))
    {
        text +=
            _("Patch state:\n    Already applied\n\nNo additional source change is required.\n");
    }
    else if (OgreMacPatchState.Matches(_T("unsupported_version")))
    {
        text +=
            _("Patch state:\n    Unsupported OGRE source version\n\nThe patch will not be applied.\n");
    }
    else if (OgreMacPatchState.Matches(_T("git_unavailable")))
    {
        text +=
            _("Patch state:\n    Git is unavailable\n\nThe patch will not be applied.\n");
    }
    else if (OgreMacPatchState.Matches(_T("unexpected_source")))
    {
        text +=
            _("Patch state:\n    The target source files are neither pristine nor recognised as already patched.\n\nCode::Blocks will not modify this source tree.\n");

    }
    else
    {
        text +=
            _("Patch state:\n    Not yet available\n\nThe source state will be checked again when leaving this page.\n");
    }

    if (!OgreMacPatchError.IsEmpty())
    {
        text +=
            _("\nDetails:\n    ") +
            OgreMacPatchError +
            _("\n");
    }

    text +=
        _("\nThis local patch is temporary and is intended to be removed once the selected official OGRE release contains the correction.");

    return text;
}

function OgreMacLoadPatchBuildState()
{
    OgreMacRebuildRequired =
        GetConfigManager()
            .Read(
                OgreMacPatchPendingKey,
                _T(""))
            .Matches(_T("1"));
}

function OgreMacSetRebuildRequired(required)
{
    OgreMacRebuildRequired = required;

    GetConfigManager().Write(
        OgreMacPatchPendingKey,
        required ? _T("1") : _T("0"));
}


function OgreMacApplyPatch()
{
    local explanation =
    _("Code::Blocks can apply a compatibility patch to the official OGRE 14.6.3 source checkout.\n\nThe OGRE Assimp integration currently passes absolute sidecar paths to OGRE's resource system, although that system expects resource names relative to the registered model directory. OgreAssimpConverter also registers that directory as a non-recursive resource location.\n\nThe patch translates sidecar requests beneath the model directory into OGRE resource names and makes the existing resource location recursive. This allows material and texture sidecars beside the model and in child directories beneath it to be resolved correctly.\n\nSource:\n") +
    OgreMacSource +
    _("\n\nModified files:\n    PlugIns/Assimp/src/AssimpLoader.cpp\n    Tools/AssimpConverter/main.cpp\n\nThe patch does not add another filesystem root or provide unrestricted filesystem access.\n\nThe source modifications remain visible in Git as uncommitted working-tree changes.\n\nAfter applying the patch, Code::Blocks will rebuild and reinstall OGRE. CMake configuration does not need to be repeated.\n\nChoose Cancel to continue without applying the patch.");

    local report =
        Wizard.MacPatchApply(
            OgreMacPatchId,
            OgreMacSource,
            explanation,
            _("Apply OGRE compatibility patch"));

    if (OgreReportField(
            report,
            _T("success")).Matches(_T("1")))
    {
        OgreMacPatchProbe();

        if (!OgreMacPatchState.Matches(_T("already_applied")))
            return false;

        if (OgreReportField(
                report,
                _T("launched")).Matches(_T("1")))
        {
            OgreMacSetRebuildRequired(true);
            OgreMacBuildSucceeded = false;
            OgreMacInstallSucceeded = false;
        }

        return true;
    }

    if (OgreReportField(
            report,
            _T("cancelled")).Matches(_T("1")))
    {
        return true;
    }

    local error =
        OgreReportField(
            report,
            _T("error"));

    if (error.IsEmpty())
    {
        error =
            OgreReportField(
                report,
                _T("output"));
    }

    ShowError(
        _("The OGRE compatibility patch was not applied.\n\n") +
        error);

    return false;
}

function OnLeave_OgreMacPatch(fwd)
{
    if (!fwd)
        return true;

    OgreMacPatchProbe();

    if (OgreMacPatchState.Matches(_T("already_applied")))
        return true;

    if (OgreMacPatchState.Matches(_T("applicable")))
        return OgreMacApplyPatch();

    if (OgreMacPatchState.Matches(_T("unexpected_source")))
    {
        ShowMessage(
            _("The OGRE source files are neither pristine nor recognised as already patched.\n\nCode::Blocks will not modify the source tree. The wizard will continue without the compatibility patch."));

        return true;
    }

    if (OgreMacPatchState.Matches(_T("unsupported_version")))
    {
        ShowMessage(
            _("The compatibility patch does not support this OGRE source version. The wizard will continue without it."));

        return true;
    }

    if (OgreMacPatchState.Matches(_T("git_unavailable")))
    {
        ShowMessage(
            _("Git is not available for compatibility-patch validation. The wizard will continue without the patch."));

        return true;
    }

    ShowMessage(
        _("The compatibility patch could not be validated. The wizard will continue without modifying the OGRE source tree.\n\n") +
        OgreMacPatchError);

    return true;
}




function OgreMacAllReady()
{
    if (PLATFORM != PLATFORM_MAC) return true;
    local reason = OgreMacBlockReason(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    reason = OgreMacNativeCMakeBlockReason(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    reason = OgreMacGitBlockReason(); if (!reason.IsEmpty()) { ShowError(reason); return false; }
    if (!OgreMacSourceReady()) { ShowError(_("The official OGRE 14.6.3 source has not been acquired.")); return false; }
    if (!OgreMacConfigured()) { ShowError(_("OGRE 14.6.3 has not been configured with CMake.")); return false; }
    if (!OgreMacBuilt()) { ShowError(_("OGRE 14.6.3 has not been built successfully.")); return false; }
    if (!OgreMacInstalled()) { ShowError(_("The OGRE 14.6.3 SDK has not been installed and validated.")); return false; }
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// Windows. Same tag, patch, and page order. No Homebrew and no macOS layout.
////////////////////////////////////////////////////////////////////////////////

OgreWinCompilerState <- _T("");
OgreWinGcc <- _T("");
OgreWinConfiguredGcc <- _T("");
OgreWinGxx <- _T("");
OgreWinMake <- _T("");
OgreWinBin <- _T("");
OgreWinCMakeState <- _T("");
OgreWinCMakeExe <- _T("");
OgreWinPkgconfState <- _T("");
OgreWinPkgconfExe <- _T("");
OgreWinSdl2State <- _T("");
OgreWinSdl2Prefix <- _T("");
OgreWinAssimpState <- _T("");
OgreWinAssimpPrefix <- _T("");
OgreWinImguiState <- _T("");
OgreWinImguiDir <- _T("");
OgreWinPugixmlState <- _T("");
OgreWinPugixmlPrefix <- _T("");
OgreWinFreetypeState <- _T("");
OgreWinFreetypePrefix <- _T("");
OgreWinToolError <- _T("");

OgreWinRoot <- _T("");
OgreWinSource <- _T("");
OgreWinBuild <- _T("");
OgreWinInstall <- _T("");
OgreWinPathsValid <- false;

OgreWinGitAccess <- _T("");
OgreWinGitExecutable <- _T("");
OgreWinGitVersion <- _T("");

OgreWinPatchState <- _T("");
OgreWinPatchError <- _T("");
OgreWinRebuildRequired <- false;
OgreWinPatchPendingKey <- _T("/windows/ogre/patch_rebuild_required");

OgreWinPluginDir <- _T("");
OgreWinLibDir <- _T("");
OgreWinRuntimeDir <- _T("");
OgreWinBuildSucceeded <- false;
OgreWinInstallSucceeded <- false;

function OgreWinSameText(left, right)
{
    return !left.IsEmpty() && left.Find(right) == 0 && left.Length() == right.Length();
}

function OgreWinLoadTools()
{
    local report = Wizard.WinOgreTools(Wizard.GetCompilerID());
    OgreWinCompilerState = OgreReportField(report, _T("compiler"));
    OgreWinGcc = OgreReportField(report, _T("gcc"));

    if (OgreWinConfiguredGcc.IsEmpty() && OgreReportField(report, _T("compiler")).Matches(_T("works")))
        OgreWinConfiguredGcc = OgreWinGcc;
    OgreWinGxx = OgreReportField(report, _T("gxx"));
    OgreWinMake = OgreReportField(report, _T("make"));
    OgreWinBin = OgreReportField(report, _T("bin"));
    OgreWinCMakeState = OgreReportField(report, _T("cmake"));
    OgreWinCMakeExe = OgreReportField(report, _T("cmake_exe"));
    OgreWinPkgconfState = OgreReportField(report, _T("pkgconf"));
    OgreWinPkgconfExe = OgreReportField(report, _T("pkgconf_exe"));
    OgreWinSdl2State = OgreReportField(report, _T("sdl2"));
    OgreWinSdl2Prefix = OgreReportField(report, _T("sdl2_prefix"));
    OgreWinAssimpState = OgreReportField(report, _T("assimp"));
    OgreWinAssimpPrefix = OgreReportField(report, _T("assimp_prefix"));
    OgreWinImguiState = OgreReportField(report, _T("imgui"));
    OgreWinImguiDir = OgreReportField(report, _T("imgui_dir"));
    OgreWinPugixmlState = OgreReportField(report, _T("pugixml"));
    OgreWinPugixmlPrefix = OgreReportField(report, _T("pugixml_prefix"));
    OgreWinFreetypeState = OgreReportField(report, _T("freetype"));
    OgreWinFreetypePrefix = OgreReportField(report, _T("freetype_prefix"));
    OgreWinToolError = OgreReportField(report, _T("error"));
}

function OgreWinToolBlockReason()
{
    OgreWinLoadTools();

    if (!OgreWinCompilerState.Matches(_T("works")))
        return _("The active GNU GCC installation does not contain gcc.exe, g++.exe, and mingw32-make.exe. This wizard does not download a compiler.");

    if (!OgreWinPkgconfState.Matches(_T("works")))
        return _("pkgconf.exe or pkg-config.exe was not found beside that compiler or on PATH.");

    if (!OgreWinSdl2State.Matches(_T("works")))
        return _("SDL2 is not installed under the selected MinGW prefix or %LOCALAPPDATA%\\codeblocks\\sdl2.");

    if (!OgreWinAssimpState.Matches(_T("works")))
        return _("Assimp is not installed under the selected MinGW prefix or %LOCALAPPDATA%\\codeblocks\\assimp.");

    if (!OgreWinImguiState.Matches(_T("works")))
        return _("Dear ImGui v1.92.9b is not cloned under %LOCALAPPDATA%\\codeblocks\\imgui-source-1.92.9b.");

    if (!OgreWinPugixmlState.Matches(_T("works")))
        return _("pugixml is not installed under the selected MinGW prefix or %LOCALAPPDATA%\\codeblocks\\pugixml.");

    if (!OgreWinFreetypeState.Matches(_T("works")))
        return _("FreeType is not installed under the selected MinGW prefix or %LOCALAPPDATA%\\codeblocks\\freetype.");

    return _T("");
}

function OgreWinToolPageText(reason)
{
    local text = _("The Windows OGRE workflow builds official OGRE v14.6.3 with the selected MinGW GCC.\n\nRequired tools:\n    gcc, g++, and mingw32-make from the active GNU GCC\n    CMake\n    pkgconf\n    SDL2 headers\n    Assimp headers\n    Dear ImGui v1.92.9b\n    pugixml 1.15\n    FreeType 2.14.3\n\n");
    text += OgreWinCompilerState.Matches(_T("works")) ? _("Compiler\n    ") + OgreWinGcc + _("\n\n") : _("Compiler\n    Not usable\n\n");
    text += OgreWinPkgconfState.Matches(_T("works")) ? _("pkgconf\n    ") + OgreWinPkgconfExe + _("\n\n") : _("pkgconf\n    Not found\n\n");
    text += OgreWinSdl2State.Matches(_T("works")) ? _("SDL2\n    ") + OgreWinSdl2Prefix + _("\n\n") : _("SDL2\n    Not found\n\n");
    text += OgreWinAssimpState.Matches(_T("works")) ? _("Assimp\n    ") + OgreWinAssimpPrefix + _("\n\n") : _("Assimp\n    Not found\n\n");
    text += OgreWinImguiState.Matches(_T("works")) ? _("Dear ImGui\n    ") + OgreWinImguiDir + _("\n\n") : _("Dear ImGui\n    Not found\n\n");
    text += OgreWinPugixmlState.Matches(_T("works")) ? _("pugixml\n    ") + OgreWinPugixmlPrefix + _("\n\n") : _("pugixml\n    Not found\n\n");
    text += OgreWinFreetypeState.Matches(_T("works")) ? _("FreeType\n    ") + OgreWinFreetypePrefix + _("\n\n") : _("FreeType\n    Not found\n\n");
    if (!reason.IsEmpty())
        text += reason + _("\n\n");
    if (!OgreWinToolError.IsEmpty())
        text += OgreWinToolError + _("\n\n");
    text += _("Press Next to acquire the next missing library with the selected MinGW GCC.\nSDL2 and Assimp are downloaded. Dear ImGui, pugixml, and FreeType are cloned with Git.\nAn existing tree under %LOCALAPPDATA%\\codeblocks is reused.\nCMake, pkgconf, the compiler, and Git are not downloaded.\n");
    return text;
}

OgreWinSdl2Url <- _T("https://github.com/libsdl-org/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz");
OgreWinSdl2Hash <- _T("5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165");
OgreWinSdl2SourceLeaf <- _T("sdl2-source-2.32.10");
OgreWinSdl2InstallLeaf <- _T("sdl2");
OgreWinAssimpUrl <- _T("https://github.com/assimp/assimp/archive/refs/tags/v5.4.3.tar.gz");
OgreWinAssimpHash <- _T("66dfbaee288f2bc43172440a55d0235dfc7bf885dda6435c038e8000e79582cb");
OgreWinAssimpSourceLeaf <- _T("assimp-source-5.4.3");
OgreWinAssimpInstallLeaf <- _T("assimp");
OgreWinImguiUrl <- _T("https://github.com/ocornut/imgui.git");
OgreWinImguiTag <- _T("v1.92.9b");
OgreWinImguiSourceLeaf <- _T("imgui-source-1.92.9b");
OgreWinImguiInstallLeaf <- _T("imgui");
OgreWinPugixmlUrl <- _T("https://github.com/zeux/pugixml.git");
OgreWinPugixmlTag <- _T("v1.15");
OgreWinPugixmlSourceLeaf <- _T("pugixml-source-1.15");
OgreWinPugixmlInstallLeaf <- _T("pugixml");
OgreWinFreetypeUrl <- _T("https://gitlab.freedesktop.org/freetype/freetype.git");
OgreWinFreetypeTag <- _T("VER-2-14-3");
OgreWinFreetypeSourceLeaf <- _T("freetype-source-2.14.3");
OgreWinFreetypeInstallLeaf <- _T("freetype");

function OgreWinRunFailed(report, title)
{
    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("That step was stopped. Files already written are left in place."));
        return false;
    }

    local output = OgreReportField(report, _T("output"));

    if (OgreReportField(report, _T("launched")).Matches(_T("1")) || !output.IsEmpty())
        ShowError(title + _("\n\n") + output);
    else
        ShowMessage(_("That step was stopped before it started."));

    return false;
}

function OgreWinLibraryInstalled(install, header)
{
    local sep = wxFILE_SEP_PATH;

    if (IO.FileExists(install + sep + header))
        return true;

    if (header.Find(_T("ft2build.h")) >= 0)
        return IO.FileExists(install + sep + _T("include") + sep + _T("ft2build.h"))
            || IO.FileExists(install + sep + _T("include") + sep + _T("freetype2") + sep + _T("ft2build.h"));

    return false;
}

function OgreWinAcquireLibrary(libraryId, sourceLeaf, installLeaf, url, hash, markers, header, downloadLabel, configureLabel)
{
    local paths = Wizard.WinCMakePaths(sourceLeaf, installLeaf);

    if (!OgreReportField(paths, _T("valid")).Matches(_T("1")))
    {
        ShowError(OgreReportField(paths, _T("error")));
        return false;
    }

    local source = OgreReportField(paths, _T("source"));
    local build = OgreReportField(paths, _T("build"));
    local install = OgreReportField(paths, _T("install"));
    local sep = wxFILE_SEP_PATH;

    if (!IO.FileExists(source + sep + _T("CMakeLists.txt")))
    {
        local explanation = _("Code::Blocks will download the official source.\n\nNothing is downloaded until you approve it.\nThe selected MinGW GCC will build it.\nAn existing source tree is left untouched.");
        local staged = Wizard.WinSdkStage(url, hash, libraryId, markers, explanation, downloadLabel);

        if (!OgreReportField(staged, _T("success")).Matches(_T("1")))
            return OgreWinRunFailed(staged, downloadLabel + _(" did not finish."));

        local placed = Wizard.WinSdkPlace(libraryId, OgreReportField(staged, _T("prefix")), sourceLeaf);

        if (!OgreReportField(placed, _T("success")).Matches(_T("1")))
        {
            ShowError(OgreReportField(placed, _T("output")));
            return false;
        }
    }

    if (libraryId.Matches(_T("assimp")))
    {
        local explanation = _("Code::Blocks can apply the stored Assimp 5.4.3 compatibility patch to this source tree.\n\nSource:\n") + source + _("\n\nThe official CMake file launches ccache when ccache.exe is found. The MinGW makefile generator does not quote that path. When the path contains a space, mingw32-make stops on the first source file.\n\nThe patch file is applied as stored. ccache stays in use when its path has no space. Declining leaves the official source unchanged.");
        local report = Wizard.WinPatchApply(_T("assimp-5.4.3-ccache-path"), source, explanation, _("Apply Assimp compatibility patch"));

        if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        {
            ShowMessage(_("The Assimp source was left unchanged."));
            return false;
        }

        if (!OgreReportField(report, _T("success")).Matches(_T("1")))
        {
            local error = OgreReportField(report, _T("error"));

            if (error.IsEmpty())
                error = OgreReportField(report, _T("output"));

            ShowError(_("The Assimp compatibility patch was not applied.\n\n") + error);
            return false;
        }
    }

    if (!OgreReportField(Wizard.WinOgreCache(build, install), _T("ready")).Matches(_T("1")))
    {
        local explanation = _("Code::Blocks will configure this library with CMake.\n\nInstall:\n") + install + _("\n\nBuild type:\nRelease");
        local report = Wizard.WinDepConfigure(libraryId, source, build, install, explanation, configureLabel);

        if (!OgreReportField(report, _T("success")).Matches(_T("1")))
            return OgreWinRunFailed(report, configureLabel + _(" did not finish."));
    }

    if (OgreWinLibraryInstalled(install, header))
        return true;

    local built = Wizard.WinDepBuild(libraryId, build, _T(""), _T(""));

    if (!OgreReportField(built, _T("success")).Matches(_T("1")))
        return OgreWinRunFailed(built, configureLabel + _(" did not build."));

    local installed = Wizard.WinDepInstall(libraryId, build, install, _T(""), _T(""));

    if (!OgreReportField(installed, _T("success")).Matches(_T("1")))
        return OgreWinRunFailed(installed, configureLabel + _(" did not install."));

    if (!OgreWinLibraryInstalled(install, header))
    {
        ShowError(_("CMake finished, but the installed headers were not found."));
        return false;
    }

    return true;
}

function OgreWinEnsureGitSource(source, url, tag, sentinel, label)
{
    local sep = wxFILE_SEP_PATH;

    if (IO.FileExists(source + sep + sentinel))
        return true;

    local explanation = _("Code::Blocks will clone the pinned tag with Git.\n\nNothing is cloned until you approve it.\nAn existing source tree is left untouched.\nGit is not installed.");
    local report = Wizard.WinGitClone(url, tag, source, explanation, label);

    if (!OgreReportField(report, _T("success")).Matches(_T("1")))
        return OgreWinRunFailed(report, label + _(" did not finish."));

    if (!IO.FileExists(source + sep + sentinel))
    {
        ShowError(_("Git finished, but the expected source file was not found.\n\n") + sentinel);
        return false;
    }

    return true;
}

function OgreWinAcquireGitLibrary(libraryId, sourceLeaf, installLeaf, url, tag, sentinel, header, downloadLabel, configureLabel)
{
    local paths = Wizard.WinCMakePaths(sourceLeaf, installLeaf);

    if (!OgreReportField(paths, _T("valid")).Matches(_T("1")))
    {
        ShowError(OgreReportField(paths, _T("error")));
        return false;
    }

    if (!OgreWinEnsureGitSource(OgreReportField(paths, _T("source")), url, tag, sentinel, downloadLabel))
        return false;

    return OgreWinAcquireLibrary(
        libraryId,
        sourceLeaf,
        installLeaf,
        _T(""),
        _T(""),
        _T(""),
        header,
        downloadLabel,
        configureLabel);
}

function OnLeave_OgreWinPrerequisites(fwd)
{
    if (!fwd)
        return true;

    local reason = OgreWinToolBlockReason();

    if (reason.IsEmpty())
        return true;

    if (!OgreWinCompilerState.Matches(_T("works")) || !OgreWinPkgconfState.Matches(_T("works")))
    {
        ShowMessage(OgreWinToolPageText(reason));
        return false;
    }

    if (!OgreWinSdl2State.Matches(_T("works")))
    {
        if (!OgreWinAcquireLibrary(
                _T("sdl2"),
                OgreWinSdl2SourceLeaf,
                OgreWinSdl2InstallLeaf,
                OgreWinSdl2Url,
                OgreWinSdl2Hash,
                _T("include/SDL.h;CMakeLists.txt"),
                _T("include") + wxFILE_SEP_PATH + _T("SDL2") + wxFILE_SEP_PATH + _T("SDL.h"),
                _("Download SDL2 2.32.10"),
                _("Configure SDL2 2.32.10")))
            return false;

        reason = OgreWinToolBlockReason();

        if (reason.IsEmpty())
            return true;

        ShowMessage(_("SDL2 is ready.\n\n") + reason + _("\n\nPress Next to continue."));
        return false;
    }

    if (!OgreWinAssimpState.Matches(_T("works")))
    {
        if (!OgreWinAcquireLibrary(
                _T("assimp"),
                OgreWinAssimpSourceLeaf,
                OgreWinAssimpInstallLeaf,
                OgreWinAssimpUrl,
                OgreWinAssimpHash,
                _T("include/assimp/Importer.hpp;CMakeLists.txt"),
                _T("include") + wxFILE_SEP_PATH + _T("assimp") + wxFILE_SEP_PATH + _T("Importer.hpp"),
                _("Download Assimp 5.4.3"),
                _("Configure Assimp 5.4.3")))
            return false;

        reason = OgreWinToolBlockReason();

        if (reason.IsEmpty())
            return true;

        ShowMessage(OgreWinToolPageText(reason));
        return false;
    }

    if (!OgreWinImguiState.Matches(_T("works")))
    {
        local paths = Wizard.WinCMakePaths(OgreWinImguiSourceLeaf, OgreWinImguiInstallLeaf);

        if (!OgreReportField(paths, _T("valid")).Matches(_T("1")))
        {
            ShowError(OgreReportField(paths, _T("error")));
            return false;
        }

        if (!OgreWinEnsureGitSource(
                OgreReportField(paths, _T("source")),
                OgreWinImguiUrl,
                OgreWinImguiTag,
                _T("imgui.h"),
                _("Clone Dear ImGui 1.92.9b")))
            return false;

        if (!IO.FileExists(OgreReportField(paths, _T("source")) + wxFILE_SEP_PATH + _T("imgui.cpp")))
        {
            ShowError(_("Git finished, but imgui.cpp was not found."));
            return false;
        }

        reason = OgreWinToolBlockReason();

        if (reason.IsEmpty())
            return true;

        ShowMessage(_("Dear ImGui is ready.\n\n") + reason + _("\n\nPress Next to continue."));
        return false;
    }

    if (!OgreWinPugixmlState.Matches(_T("works")))
    {
        if (!OgreWinAcquireGitLibrary(
                _T("pugixml"),
                OgreWinPugixmlSourceLeaf,
                OgreWinPugixmlInstallLeaf,
                OgreWinPugixmlUrl,
                OgreWinPugixmlTag,
                _T("CMakeLists.txt"),
                _T("include") + wxFILE_SEP_PATH + _T("pugixml.hpp"),
                _("Clone pugixml 1.15"),
                _("Configure pugixml 1.15")))
            return false;

        reason = OgreWinToolBlockReason();

        if (reason.IsEmpty())
            return true;

        ShowMessage(_("pugixml is ready.\n\n") + reason + _("\n\nPress Next to continue."));
        return false;
    }

    if (!OgreWinFreetypeState.Matches(_T("works")))
    {
        if (!OgreWinAcquireGitLibrary(
                _T("freetype"),
                OgreWinFreetypeSourceLeaf,
                OgreWinFreetypeInstallLeaf,
                OgreWinFreetypeUrl,
                OgreWinFreetypeTag,
                _T("CMakeLists.txt"),
                _T("include") + wxFILE_SEP_PATH + _T("freetype2") + wxFILE_SEP_PATH + _T("ft2build.h"),
                _("Clone FreeType 2.14.3"),
                _("Configure FreeType 2.14.3")))
            return false;

        reason = OgreWinToolBlockReason();

        if (reason.IsEmpty())
            return true;

        ShowMessage(OgreWinToolPageText(reason));
        return false;
    }

    ShowMessage(OgreWinToolPageText(reason));
    return false;
}

function OgreWinResolvePaths()
{
    OgreWinPathsValid = false;
    OgreWinRoot = _T("");
    OgreWinSource = _T("");
    OgreWinBuild = _T("");
    OgreWinInstall = _T("");
    local report = Wizard.WinCMakePaths(OgreMacSourceLeaf, OgreMacInstallLeaf);

    if (!OgreReportField(report, _T("valid")).Matches(_T("1")))
        return OgreReportField(report, _T("error"));

    OgreWinRoot = OgreReportField(report, _T("root"));
    OgreWinSource = OgreReportField(report, _T("source"));
    OgreWinBuild = OgreReportField(report, _T("build"));
    OgreWinInstall = OgreReportField(report, _T("install"));

    if (OgreWinRoot.IsEmpty() || OgreWinSource.IsEmpty() || OgreWinBuild.IsEmpty() || OgreWinInstall.IsEmpty())
        return _("CMake path resolution returned an incomplete result.");

    OgreWinPathsValid = true;
    return _T("");
}

function OgreWinCMakeBlockReason()
{
    OgreWinLoadTools();
    local report = Wizard.WinCMakeProbe();
    OgreWinCMakeState = OgreReportField(report, _T("access"));
    OgreWinCMakeExe = OgreReportField(report, _T("executable"));

    if (!OgreWinCMakeState.Matches(_T("works")) && !OgreReportField(Wizard.WinOgreTools(Wizard.GetCompilerID()), _T("cmake")).Matches(_T("works")))
        return _("CMake could not be found. Code::Blocks also looks for cmake.exe in the selected MinGW bin.");

    if (!OgreWinCMakeState.Matches(_T("works")))
    {
        report = Wizard.WinCMakeProbe();
        OgreWinCMakeState = OgreReportField(report, _T("access"));
        OgreWinCMakeExe = OgreReportField(report, _T("executable"));
    }

    if (!OgreWinCMakeState.Matches(_T("works")))
        return _("CMake could not be found.");

    return OgreWinResolvePaths();
}

function OgreWinCMakePageText(reason)
{
    local text = _("CMake and the Code::Blocks-owned OGRE directories.\n\n");
    text += OgreWinCMakeState.Matches(_T("works")) ? _("CMake\n    ") + OgreWinCMakeExe + _("\n\n") : _("CMake\n    Not usable\n\n");

    if (OgreWinPathsValid)
        text += _("Root:\n    ") + OgreWinRoot + _("\n\nSource:\n    ") + OgreWinSource + _("\n\nBuild:\n    ") + OgreWinBuild + _("\n\nInstall:\n    ") + OgreWinInstall + _("\n\n");

    text += reason.IsEmpty() ? _("CMake and paths are ready.\n") : reason + _("\n\nPress Next to choose an existing cmake.exe.\n");
    return text;
}

function OgreWinConsiderCMake(path)
{
    if (path.IsEmpty())
        return _T("");

    local report = Wizard.WinCMakeTry(path);

    if (OgreReportField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/windows/cmake/executable"), path);
        return _T("");
    }

    return _("That file did not pass cmake --version, so it was not remembered.\n\n") + OgreReportField(report, _T("version")) + _("\n") + OgreReportField(report, _T("error"));
}

function OnLeave_OgreWinCMake(fwd)
{
    if (!fwd)
        return true;

    local reason = OgreWinCMakeBlockReason();

    if (reason.IsEmpty())
        return true;

    if (!OgreWinCMakeState.Matches(_T("works")))
    {
        local picked = IO.SelectFile(_("Choose the CMake executable"), _T("cmake.exe"), _("Executable (*.exe)|*.exe"));
        local rejected = OgreWinConsiderCMake(picked);

        if (!rejected.IsEmpty())
            ShowError(rejected);
    }

    reason = OgreWinCMakeBlockReason();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    return true;
}

function OgreWinGitBlockReason()
{
    local report = Wizard.WinGitProbe();
    OgreWinGitAccess = OgreReportField(report, _T("access"));
    OgreWinGitExecutable = OgreReportField(report, _T("executable"));
    OgreWinGitVersion = OgreReportField(report, _T("version"));

    if (OgreWinGitAccess.Matches(_T("works")))
        return _T("");

    if (OgreWinGitAccess.Matches(_T("present_unusable")))
        return _("Git was found but could not be used from Code::Blocks.");

    return _("Git could not be found. Code::Blocks does not install Git.");
}

function OgreWinConsiderGit(path)
{
    if (path.IsEmpty())
        return _T("");

    local report = Wizard.WinGitTry(path);

    if (OgreReportField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/windows/git/executable"), path);
        return _T("");
    }

    return _("That file did not pass git --version, so it was not remembered.\n\n") + OgreReportField(report, _T("version")) + _("\n") + OgreReportField(report, _T("error"));
}

function OgreWinGitPageText(reason)
{
    local text = _("OGRE 14.6.3 is obtained from the official upstream Git repository.\n\n");
    text += OgreWinGitAccess.Matches(_T("works")) ? _("Git\n    Found: ") + OgreWinGitExecutable + _("\n    Version: ") + OgreWinGitVersion + _("\n\n") : _("Git\n    Not usable\n\n");

    if (!reason.IsEmpty())
        text += reason + _("\n\n");

    return text + _("Code::Blocks does not install Git.\nPress Next to choose an existing git.exe.\n");
}

function OnLeave_OgreWinGit(fwd)
{
    if (!fwd)
        return true;

    if (OgreWinGitBlockReason().IsEmpty())
        return true;

    local picked = IO.SelectFile(_("Choose the Git executable"), _T("git.exe"), _("Executable (*.exe)|*.exe"));
    local rejected = OgreWinConsiderGit(picked);

    if (!rejected.IsEmpty())
        ShowError(rejected);

    return OgreWinGitBlockReason().IsEmpty();
}

function OgreWinSourceReady()
{
    if (!OgreWinPathsValid)
    {
        local reason = OgreWinResolvePaths();

        if (!reason.IsEmpty())
            return false;
    }

    local sep = wxFILE_SEP_PATH;
    return IO.FileExists(OgreWinSource + sep + _T(".git") + sep + _T("HEAD")) && IO.FileExists(OgreWinSource + sep + _T("CMakeLists.txt"));
}

function OgreWinAcquirePageText()
{
    local reason = OgreWinResolvePaths();

    if (!reason.IsEmpty())
        return reason;

    return _("The official OGRE 14.6.3 source is not present yet.\n\nRepository:\n    ") + OgreMacRepository + _("\n\nRelease tag:\n    ") + OgreMacTag + _("\n\nDestination:\n    ") + OgreWinSource + _("\n\nPress Next to approve a shallow tagged clone.\nThis step downloads source only.\nA directory that already exists is left untouched.\n");
}

function OgreWinCloneOgre()
{
    local reason = OgreWinResolvePaths();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    local explanation = _("Code::Blocks will download the official OGRE 14.6.3 source release.\n\nRepository:\n") + OgreMacRepository + _("\n\nRelease tag:\n") + OgreMacTag + _("\n\nDestination:\n") + OgreWinSource + _("\n\nThis step downloads the source only.");
    local report = Wizard.WinGitClone(OgreMacRepository, OgreMacTag, OgreWinSource, explanation, _("Download OGRE 14.6.3"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
        return OgreWinSourceReady();

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        ShowMessage(_("The OGRE download was stopped. Partial files are left in place."));
    else
        ShowError(_("OGRE 14.6.3 was not downloaded successfully.\n\n") + OgreReportField(report, _T("output")));

    return false;
}

function OnLeave_OgreWinAcquire(fwd)
{
    if (!fwd)
        return true;

    if (OgreWinSourceReady())
        return true;

    if (!OgreWinGitBlockReason().IsEmpty())
    {
        ShowError(_("Git is not ready."));
        return false;
    }

    return OgreWinCloneOgre();
}

function OgreWinPatchProbe()
{
    OgreWinPatchState = _T("");
    OgreWinPatchError = _T("");
    local reason = OgreWinResolvePaths();

    if (!reason.IsEmpty())
    {
        OgreWinPatchError = reason;
        return _T("");
    }

    if (!OgreWinSourceReady())
    {
        OgreWinPatchError = _("The OGRE source checkout is not present.");
        return _T("");
    }

    local report = Wizard.WinPatchProbe(OgreMacPatchId, OgreWinSource);
    OgreWinPatchState = OgreReportField(report, _T("state"));
    OgreWinPatchError = OgreReportField(report, _T("error"));
    return report;
}

function OgreWinPatchPageText()
{
    OgreWinPatchProbe();
    local text = _("Optional OGRE 14.6.3 compatibility patch\n\nThe official OGRE 14.6.3 Assimp integration passes absolute sidecar paths to OGRE's resource system, which expects names relative to the registered model resource location. OgreAssimpConverter also registers that location as non-recursive.\n\nThe patch is the stored macOS patch, applied unchanged. It modifies:\n    PlugIns/Assimp/src/AssimpLoader.cpp\n    Tools/AssimpConverter/main.cpp\n\n");

    if (OgreWinPatchState.Matches(_T("applicable")))
        text += _("Patch state:\n    Available for this exact OGRE 14.6.3 checkout\n\nPress Next to choose whether to apply the patch.\nDeclining leaves the official upstream source unchanged.\n");
    else if (OgreWinPatchState.Matches(_T("already_applied")))
        text += _("Patch state:\n    Already applied\n\nNo additional source change is required.\n");
    else if (OgreWinPatchState.Matches(_T("unsupported_version")))
        text += _("Patch state:\n    Unsupported OGRE source version\n\nThe patch will not be applied.\n");
    else if (OgreWinPatchState.Matches(_T("git_unavailable")))
        text += _("Patch state:\n    Git is unavailable\n\nThe patch will not be applied.\n");
    else if (OgreWinPatchState.Matches(_T("unexpected_source")))
        text += _("Patch state:\n    The target source files are neither pristine nor recognised as already patched.\n\nCode::Blocks will not modify this source tree.\n");
    else
        text += _("Patch state:\n    Not yet available\n\nThe source state will be checked again when leaving this page.\n");

    if (!OgreWinPatchError.IsEmpty())
        text += _("\nDetails:\n    ") + OgreWinPatchError + _("\n");

    return text;
}

function OgreWinLoadPatchBuildState()
{
    OgreWinRebuildRequired = GetConfigManager().Read(OgreWinPatchPendingKey, _T("")).Matches(_T("1"));
}

function OgreWinSetRebuildRequired(required)
{
    OgreWinRebuildRequired = required;
    GetConfigManager().Write(OgreWinPatchPendingKey, required ? _T("1") : _T("0"));
}

function OgreWinApplyPatch()
{
    local explanation = _("Code::Blocks can apply the stored OGRE 14.6.3 compatibility patch to this checkout.\n\nSource:\n") + OgreWinSource + _("\n\nThe patch file is applied as stored. Declining leaves the source unchanged.");
    local report = Wizard.WinPatchApply(OgreMacPatchId, OgreWinSource, explanation, _("Apply OGRE compatibility patch"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        OgreWinPatchProbe();

        if (!OgreWinPatchState.Matches(_T("already_applied")))
            return false;

        if (OgreReportField(report, _T("launched")).Matches(_T("1")))
        {
            OgreWinSetRebuildRequired(true);
            OgreWinBuildSucceeded = false;
            OgreWinInstallSucceeded = false;
        }

        return true;
    }

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        return true;

    local error = OgreReportField(report, _T("error"));

    if (error.IsEmpty())
        error = OgreReportField(report, _T("output"));

    ShowError(_("The OGRE compatibility patch was not applied.\n\n") + error);
    return false;
}

function OgreWinApplyConfigDialogPatch()
{
    local report = Wizard.WinPatchProbe(OgreWinConfigDialogPatchId, OgreWinSource);
    local state = OgreReportField(report, _T("state"));

    if (state.Matches(_T("already_applied")))
        return true;

    if (!state.Matches(_T("applicable")))
    {
        ShowError(_("The Windows configuration dialog patch could not be applied.\n\n") + OgreReportField(report, _T("error")));
        return false;
    }

    local explanation = _("The MinGW configuration dialog looks for its window layout in OgreMain.dll.\nThat layout is linked into OgreBites.dll, so the dialog cannot open.\n\nThe patch changes the lookup to OgreBites.dll.\n\nSource:\n") + OgreWinSource;
    report = Wizard.WinPatchApply(OgreWinConfigDialogPatchId, OgreWinSource, explanation, _("Apply Windows configuration dialog patch"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        if (OgreReportField(report, _T("launched")).Matches(_T("1")))
        {
            OgreWinSetRebuildRequired(true);
            OgreWinBuildSucceeded = false;
            OgreWinInstallSucceeded = false;
        }

        return true;
    }

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowError(_("The configuration dialog patch was not applied. The generated program cannot open the OGRE configuration window without it."));
        return false;
    }

    ShowError(_("The Windows configuration dialog patch was not applied.\n\n") + OgreReportField(report, _T("error")));
    return false;
}

function OnLeave_OgreWinPatch(fwd)
{
    if (!fwd)
        return true;

    if (!OgreWinApplyConfigDialogPatch())
        return false;

    OgreWinPatchProbe();

    if (OgreWinPatchState.Matches(_T("already_applied")))
        return true;

    if (OgreWinPatchState.Matches(_T("applicable")))
        return OgreWinApplyPatch();

    if (OgreWinPatchState.Matches(_T("unexpected_source")))
    {
        ShowMessage(_("The OGRE source files are neither pristine nor recognised as already patched.\n\nCode::Blocks will not modify the source tree. The wizard will continue without the compatibility patch."));
        return true;
    }

    if (OgreWinPatchState.Matches(_T("unsupported_version")))
    {
        ShowMessage(_("The compatibility patch does not support this OGRE source version. The wizard will continue without it."));
        return true;
    }

    if (OgreWinPatchState.Matches(_T("git_unavailable")))
    {
        ShowMessage(_("Git is not available for compatibility-patch validation. The wizard will continue without the patch."));
        return true;
    }

    ShowMessage(_("The compatibility patch could not be validated. The wizard will continue without modifying the OGRE source tree.\n\n") + OgreWinPatchError);
    return true;
}

function OgreWinCacheReady()
{
    if (!OgreWinPathsValid && !OgreWinResolvePaths().IsEmpty())
        return false;

    local report = Wizard.WinOgreCache(OgreWinBuild, OgreWinInstall);
    return OgreReportField(report, _T("ready")).Matches(_T("1"));
}

function OgreWinBuilt()
{
    if (!OgreWinPathsValid && !OgreWinResolvePaths().IsEmpty())
        return false;

    local report = Wizard.WinOgreBuilt(OgreWinBuild);
    return OgreReportField(report, _T("valid")).Matches(_T("1"));
}

function OgreWinRememberLayout(report)
{
    OgreWinPluginDir = OgreReportField(report, _T("plugin"));
    OgreWinLibDir = OgreReportField(report, _T("lib"));
    OgreWinRuntimeDir = OgreReportField(report, _T("runtime"));
}

function OgreWinInstalled()
{
    if (!OgreWinPathsValid && !OgreWinResolvePaths().IsEmpty())
        return false;

    local report = Wizard.WinOgreLayout(OgreWinInstall);

    if (!OgreReportField(report, _T("valid")).Matches(_T("1")))
        return false;

    OgreWinRememberLayout(report);
    return !OgreWinPluginDir.IsEmpty() && !OgreWinLibDir.IsEmpty();
}

function OgreWinConfigurePageText()
{
    return _("OGRE 14.6.3 is ready to be configured with CMake.\n\nSource:\n    ") + OgreWinSource + _("\n\nBuild:\n    ") + OgreWinBuild + _("\n\nInstall:\n    ") + OgreWinInstall + _("\n\nBuild type:\n    Release\n\nCompiler:\n    ") + OgreWinGcc + _("\n\nPress Next to configure OGRE.\nThis step does not build or install OGRE.\n");
}

function OgreWinConfigureOgre()
{
    local reason = OgreWinResolvePaths();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    local explanation = _("Code::Blocks will configure OGRE 14.6.3 with CMake.\n\nSource:\n") + OgreWinSource + _("\n\nBuild:\n") + OgreWinBuild + _("\n\nInstall:\n") + OgreWinInstall + _("\n\nBuild type:\nRelease\n\nThe install prefix is fixed during this configuration step.\nOGRE is not built or installed by this operation.");
    local report = Wizard.WinOgreConfigure(OgreWinSource, OgreWinBuild, OgreWinInstall, explanation, _("Configure OGRE 14.6.3"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
        return OgreWinCacheReady();

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        ShowMessage(_("CMake configuration was stopped. Files already written by CMake are left in place."));
    else
        ShowError(_("OGRE 14.6.3 was not configured successfully.\n\n") + OgreReportField(report, _T("output")));

    return false;
}

function OnLeave_OgreWinConfigure(fwd)
{
    if (!fwd)
        return true;

    if (OgreWinCacheReady())
        return true;

    return OgreWinConfigureOgre();
}

function OgreWinBuildPageText()
{
    return _("OGRE 14.6.3 is configured and ready to build.\n\nBuild directory:\n    ") + OgreWinBuild + _("\n\nCode::Blocks will use bounded native parallelism.\n\nPress Next to build OGRE.\nThis step does not install OGRE.\n");
}

function OgreWinBuildOgre()
{
    if (!OgreWinCacheReady())
    {
        ShowError(_("OGRE 14.6.3 has not been configured with CMake."));
        return false;
    }

    local explanation = _("Code::Blocks will build OGRE 14.6.3 with CMake.\n\nBuild directory:\n") + OgreWinBuild + _("\n\nThe native helper selects a bounded parallel job count.\nThis operation does not install OGRE.");
    local report = Wizard.WinOgreBuild(OgreWinBuild, explanation, _("Build OGRE 14.6.3"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        OgreWinBuildSucceeded = OgreWinBuilt();

        if (OgreWinBuildSucceeded)
            return true;

        ShowError(_("CMake reported a successful build, but RenderSystem_GL.dll was not found in the build tree."));
        return false;
    }

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        ShowMessage(_("The OGRE build was stopped. Files already produced by the build are left in place."));
    else
        ShowError(_("OGRE 14.6.3 was not built successfully.\n\n") + OgreReportField(report, _T("output")));

    return false;
}

function OnLeave_OgreWinBuild(fwd)
{
    if (!fwd)
        return true;

    OgreWinLoadPatchBuildState();

    if (OgreWinRebuildRequired)
        return OgreWinBuildOgre();

    if (OgreWinBuildSucceeded || OgreWinBuilt())
    {
        OgreWinBuildSucceeded = true;
        return true;
    }

    return OgreWinBuildOgre();
}

function OgreWinInstallPageText()
{
    return _("OGRE 14.6.3 is built and ready to install.\n\nBuild directory:\n    ") + OgreWinBuild + _("\n\nInstall prefix fixed during configuration:\n    ") + OgreWinInstall + _("\n\nPress Next to install and validate the OGRE SDK.\nNo replacement --prefix is supplied during installation.\n");
}

function OgreWinInstallOgre()
{
    if (!OgreWinBuilt())
    {
        ShowError(_("OGRE 14.6.3 has not been built successfully."));
        return false;
    }

    local explanation = _("Code::Blocks will install OGRE 14.6.3 with CMake.\n\nBuild directory:\n") + OgreWinBuild + _("\n\nInstall prefix:\n") + OgreWinInstall + _("\n\nThe install prefix was fixed during configuration.\nCode::Blocks will not pass a replacement --prefix.\nAfter installation, the installed SDK is validated.");
    local report = Wizard.WinOgreInstall(OgreWinBuild, OgreWinInstall, explanation, _("Install OGRE 14.6.3"));

    if (OgreReportField(report, _T("success")).Matches(_T("1")))
    {
        OgreWinInstallSucceeded = OgreWinInstalled();

        if (OgreWinInstallSucceeded)
            return true;

        ShowError(_("CMake reported a successful install, but the installed OGRE SDK contract was not found."));
        return false;
    }

    if (OgreReportField(report, _T("cancelled")).Matches(_T("1")))
        ShowMessage(_("The OGRE install was stopped. Files already installed are left in place."));
    else
        ShowError(_("OGRE 14.6.3 was not installed successfully.\n\n") + OgreReportField(report, _T("output")));

    return false;
}

function OgreWinStageSdkRuntime()
{
    OgreWinLoadTools();

    if (OgreWinRuntimeDir.IsEmpty() && !OgreWinInstalled())
        return false;

    local sep = wxFILE_SEP_PATH;
    local items = [
        [OgreWinSdl2Prefix, _T("SDL2.dll")],
        [OgreWinFreetypePrefix, _T("libfreetype.dll")],
        [OgreWinAssimpPrefix, _T("libassimp-5.dll")]
    ];

    foreach (i, item in items)
    {
        local dir = item[0];
        local name = item[1];

        if (dir.IsEmpty())
            continue;

        local src = dir + sep + _T("bin") + sep + name;

        if (!IO.FileExists(src))
            continue;

        local dst = OgreWinRuntimeDir + sep + name;

        if (IO.FileExists(dst))
            continue;

        if (!IO.CopyFile(src, dst, true))
        {
            ShowError(_("Could not copy ") + name + _(" beside SampleBrowser.\n\nFrom:\n") + src);
            return false;
        }
    }

    // The executable directory is searched before PATH. Another MinGW on PATH,
    // such as MSYS2, would otherwise supply a different libstdc++.
    local compilerBin = OgreWinGcc.BeforeLast(sep);
    local runtime = [
        _T("libgcc_s_seh-1.dll"),
        _T("libstdc++-6.dll"),
        _T("libwinpthread-1.dll")
    ];

    if (!compilerBin.IsEmpty())
    {
        foreach (i, name in runtime)
        {
            local src = compilerBin + sep + name;

            if (!IO.FileExists(src))
                continue;

            local dst = OgreWinRuntimeDir + sep + name;

            if (IO.FileExists(dst))
                continue;

            if (!IO.CopyFile(src, dst, true))
            {
                ShowError(_("Could not copy ") + name + _(" beside SampleBrowser.\n\nFrom:\n") + src);
                return false;
            }
        }
    }

    return true;
}

function OnLeave_OgreWinInstall(fwd)
{
    if (!fwd)
        return true;

    OgreWinLoadPatchBuildState();

    if (OgreWinRebuildRequired)
    {
        if (!OgreWinInstallOgre())
            return false;

        OgreWinSetRebuildRequired(false);
        return OgreWinStageSdkRuntime();
    }

    if (OgreWinInstallSucceeded || OgreWinInstalled())
    {
        OgreWinInstallSucceeded = true;
        return OgreWinStageSdkRuntime();
    }

    if (!OgreWinInstallOgre())
        return false;

    return OgreWinStageSdkRuntime();
}

function OgreWinAllReady()
{
    if (PLATFORM != PLATFORM_MSW)
        return true;

    local reason = OgreWinToolBlockReason();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    reason = OgreWinCMakeBlockReason();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    reason = OgreWinGitBlockReason();

    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }

    if (!OgreWinSourceReady())
    {
        ShowError(_("The official OGRE 14.6.3 source has not been acquired."));
        return false;
    }

    if (!OgreWinCacheReady())
    {
        ShowError(_("OGRE 14.6.3 has not been configured with CMake."));
        return false;
    }

    if (!OgreWinBuilt())
    {
        ShowError(_("OGRE 14.6.3 has not been built successfully."));
        return false;
    }

    if (!OgreWinInstalled())
    {
        ShowError(_("The OGRE 14.6.3 SDK has not been installed and validated."));
        return false;
    }

    return true;
}

function AddOgreWinSetupPages()
{
    if (PLATFORM != PLATFORM_MSW)
        return;

    OgreWinLoadPatchBuildState();
    local reason = OgreWinToolBlockReason();

    if (!reason.IsEmpty())
        Wizard.AddInfoPage(_T("OgreWinPrerequisites"), OgreWinToolPageText(reason));

    reason = OgreWinCMakeBlockReason();
    Wizard.AddInfoPage(_T("OgreWinCMake"), OgreWinCMakePageText(reason));
    local gitReason = OgreWinGitBlockReason();

    if (!gitReason.IsEmpty())
        Wizard.AddInfoPage(_T("OgreWinGit"), OgreWinGitPageText(gitReason));

    if (!OgreWinSourceReady())
        Wizard.AddInfoPage(_T("OgreWinAcquire"), OgreWinAcquirePageText());

    Wizard.AddInfoPage(_T("OgreWinPatch"), OgreWinPatchPageText());
    Wizard.AddInfoPage(_T("OgreWinConfigure"), OgreWinConfigurePageText());
    Wizard.AddInfoPage(_T("OgreWinBuild"), OgreWinBuildPageText());
    Wizard.AddInfoPage(_T("OgreWinInstall"), OgreWinInstallPageText());
}

function OgreWinQueueDll(project, dir, name)
{
    if (dir.IsEmpty())
        return;

    local path = dir + wxFILE_SEP_PATH + name;

    if (!IO.FileExists(path))
        return;

    project.AddCommandsAfterBuild(_T("cmd /c copy /Y \"") + path + _T("\" \"$(TARGET_OUTPUT_DIR)") + name + _T("\""));
}

function OgreWinSelectedCompilerMatches()
{
    local report = Wizard.WinSdkCompiler(Wizard.GetCompilerID());
    local exe = OgreReportField(report, _T("executable"));

    if (OgreWinSameText(exe, OgreWinConfiguredGcc))
        return true;

    ShowError(_("The selected compiler is not the GNU GCC this OGRE SDK was configured with.\n\nRequired:\n") + OgreWinConfiguredGcc);
    return false;
}

function SetupWinOgreProject(project)
{
    if (!OgreWinAllReady())
        return false;

    if (!OgreWinSelectedCompilerMatches())
        return false;

    local sep = wxFILE_SEP_PATH;
    project.AddIncludeDir(OgreWinInstall + sep + _T("include") + sep + _T("OGRE") + sep + _T("Bites"));
    project.AddIncludeDir(OgreWinInstall + sep + _T("include") + sep + _T("OGRE"));
    project.AddIncludeDir(OgreWinInstall + sep + _T("include") + sep + _T("OGRE") + sep + _T("Overlay"));
    project.AddIncludeDir(OgreWinInstall + sep + _T("include") + sep + _T("OGRE") + sep + _T("RTShaderSystem"));

    if (!OgreWinSdl2Prefix.IsEmpty())
        project.AddIncludeDir(OgreWinSdl2Prefix + sep + _T("include"));

    project.AddLibDir(OgreWinLibDir);

    if (!OgreWinSdl2Prefix.IsEmpty())
        project.AddLibDir(OgreWinSdl2Prefix + sep + _T("lib"));

    project.AddCompilerOption(_T("-std=gnu++17"));
    project.AddCompilerOption(_T("-DWIN32"));

    local sdlLib = OgreWinSdl2Prefix + sep + _T("lib");

    if (IO.FileExists(sdlLib + sep + _T("libSDL2main.a")) || IO.FileExists(sdlLib + sep + _T("libSDL2main.dll.a")))
    {
        project.AddLinkLib(_T("mingw32"));
        project.AddLinkLib(_T("SDL2main"));
    }

    project.AddLinkLib(_T("OgreBites"));
    project.AddLinkLib(_T("OgreOverlay"));
    project.AddLinkLib(_T("OgreRTShaderSystem"));
    project.AddLinkLib(_T("OgreMain"));

    if (IO.FileExists(sdlLib + sep + _T("libSDL2.dll.a")) || IO.FileExists(sdlLib + sep + _T("libSDL2.a")))
        project.AddLinkLib(_T("SDL2"));

    WarningsOn(project, Wizard.GetCompilerID());
    CppExceptionsOn(project, Wizard.GetCompilerID());

    local names = [
        _T("OgreMain.dll"),
        _T("OgreBites.dll"),
        _T("OgreOverlay.dll"),
        _T("OgreRTShaderSystem.dll"),
        _T("OgrePaging.dll"),
        _T("OgreTerrain.dll"),
        _T("OgreMeshLodGenerator.dll"),
        _T("OgreProperty.dll"),
        _T("RenderSystem_GL.dll"),
        _T("RenderSystem_GL3Plus.dll"),
        _T("Plugin_ParticleFX.dll"),
        _T("Plugin_BSPSceneManager.dll"),
        _T("Codec_STBI.dll"),
        _T("Plugin_PCZSceneManager.dll"),
        _T("Plugin_OctreeZone.dll"),
        _T("Plugin_OctreeSceneManager.dll"),
        _T("Plugin_DotScene.dll"),
        _T("SDL2.dll"),
        _T("zlib1.dll"),
        _T("libzlib.dll"),
        _T("libpng16.dll")
    ];

    foreach (i, name in names)
    {
        OgreWinQueueDll(project, OgreWinRuntimeDir, name);
        OgreWinQueueDll(project, OgreWinPluginDir, name);
    }

    if (!OgreWinSdl2Prefix.IsEmpty())
        OgreWinQueueDll(project, OgreWinSdl2Prefix + sep + _T("bin"), _T("SDL2.dll"));

    // OgreOverlay imports this exact filename from the FreeType prefix.
    if (!OgreWinFreetypePrefix.IsEmpty())
        OgreWinQueueDll(project, OgreWinFreetypePrefix + sep + _T("bin"), _T("libfreetype.dll"));

    // Keep the compiler that built OGRE ahead of any other MinGW on PATH.
    if (!OgreWinGcc.IsEmpty())
    {
        local compilerBin = OgreWinGcc.BeforeLast(sep);
        OgreWinQueueDll(project, compilerBin, _T("libgcc_s_seh-1.dll"));
        OgreWinQueueDll(project, compilerBin, _T("libstdc++-6.dll"));
        OgreWinQueueDll(project, compilerBin, _T("libwinpthread-1.dll"));
    }

    local target = project.GetBuildTarget(Wizard.GetDebugName());

    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly);
        // resources.cfg and plugins.cfg are written beside the project file.
        target.SetWorkingDir(project.GetBasePath());
        target.SetOutputFilename(target.SuggestOutputFilename());
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    target = project.GetBuildTarget(Wizard.GetReleaseName());

    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable);
        target.SetWorkingDir(project.GetBasePath());
        target.SetOutputFilename(target.SuggestOutputFilename());
        target.AddCompilerOption(_T("-DNDEBUG"));
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

function SetupCustom()
{
    if (PLATFORM == PLATFORM_MSW)
        return OgreWinAllReady();

    return OgreMacAllReady();
}

function AddOgreMacSetupPages()
{
    if (PLATFORM != PLATFORM_MAC)
        return;

    OgreMacLoadPatchBuildState();

    local reason = OgreMacBlockReason();

    if (!reason.IsEmpty())
    {
        Wizard.AddInfoPage(
            _T("OgreMacPrerequisites"),
            OgreMacPageText(reason));
    }

    reason = OgreMacNativeCMakeBlockReason();

    Wizard.AddInfoPage(
        _T("OgreMacCMake"),
        OgreMacCMakePageText(reason));

    local gitReason = OgreMacGitBlockReason();

    if (!gitReason.IsEmpty())
    {
        Wizard.AddInfoPage(
            _T("OgreMacGit"),
            OgreMacGitPageText(gitReason));
    }

    if (!OgreMacSourceReady())
    {
        Wizard.AddInfoPage(
            _T("OgreMacAcquire"),
            OgreMacAcquirePageText());
    }

    Wizard.AddInfoPage(
        _T("OgreMacPatch"),
        OgreMacPatchPageText());

    Wizard.AddInfoPage(
        _T("OgreMacConfigure"),
        OgreMacConfigurePageText());

    Wizard.AddInfoPage(
        _T("OgreMacBuild"),
        OgreMacBuildPageText());

    Wizard.AddInfoPage(
        _T("OgreMacInstall"),
        OgreMacInstallPageText());
}

////////////////////////////////////////////////////////////////////////////////
// Wizard
////////////////////////////////////////////////////////////////////////////////

function BeginWizard()
{
    local wiz_type = Wizard.GetWizardType();

    if (wiz_type == wizCustom)
    {
        Wizard.AddInfoPage(
            _T("OgreSetupIntro"),
            _("OGRE SDK setup\n\nThis wizard installs, repairs and validates the Code::Blocks-managed OGRE 14.6.3 SDK.\n\nNo project will be created."));

        if (PLATFORM == PLATFORM_MSW)
            AddOgreWinSetupPages();
        else
            AddOgreMacSetupPages();

        return;
    }

    Wizard.AddInfoPage(
        _T("OgreIntro"),
        _("Welcome to the OGRE project wizard!\n\nThis wizard uses the official OGRE 14.6.3 source release.\n\nv3.8.2 validates prerequisites, optionally applies the OGRE compatibility patch, configures, builds, installs and validates the OGRE SDK."));

    if (PLATFORM == PLATFORM_MSW)
        AddOgreWinSetupPages();
    else
        AddOgreMacSetupPages();

    Wizard.AddProjectPathPage();

    if (PLATFORM != PLATFORM_MAC && PLATFORM != PLATFORM_MSW)
    {
        Wizard.AddGenericSingleChoiceListPage(
            _T("OgreSDKType"),
            _("OGRE may exist as a source package or as a pre-made SDK."),
            _("I have a folder with the OGRE source code;"
              "I have installed a pre-made OGRE SDK"),
            OgreIsSource ? 0 : 1);

        Wizard.AddGenericSelectPathPage(
            _T("OgrePath"),
            _("Please select the top-level OGRE folder."),
            _("Please select OGRE's location:"),
            _T("$(OGRE_HOME)"));
    }

    local compilers =
        PLATFORM == PLATFORM_MSW
            ? _T("gcc*")
            : _T("*");

    Wizard.AddCompilerPage(
        _T(""),
        compilers,
        true,
        true);
}

function OnGetNextPage_OgreSDKType() { OgreIsSource = Wizard.GetListboxSelection(_T("lstSelections")) == 0; if (PLATFORM != PLATFORM_MSW && !OgreIsSource) return _T("CompilerPage"); return _T("OgrePath"); }
function OnGetPrevPage_CompilerPage() { if (PLATFORM == PLATFORM_MAC || PLATFORM == PLATFORM_MSW) return _T("ProjectPathPage"); if (PLATFORM != PLATFORM_MSW && !OgreIsSource) return _T("OgreSDKType"); return _T("OgrePath"); }
function OnLeave_OgrePath(fwd) { if (fwd) { local dir = Wizard.GetTextControlValue(_T("txtFolder")); local raw = ReplaceMacros(dir); if ((OgreIsSource && !IO.FileExists(raw + _T("/OgreMain/include/Ogre.h"))) || (!OgreIsSource && !IO.FileExists(raw + _T("/include/Ogre.h")))) { ShowError(_("This wizard cannot locate OGRE files in that path.")); return false; } OgrePath = dir; } return true; }
function OnLeave_ProjectPathPage(fwd)
{
    if (!fwd)
        return true;

    if (PLATFORM == PLATFORM_MSW)
        return OgreWinAllReady();

    return OgreMacAllReady();
}

function OnLeave_CompilerPage(fwd)
{
    if (!fwd)
        return true;

    if (PLATFORM == PLATFORM_MSW)
        return OgreWinAllReady() && OgreWinSelectedCompilerMatches();

    return OgreMacAllReady();
}


function GetFilesDir()
{
    if (PLATFORM == PLATFORM_MAC || PLATFORM == PLATFORM_MSW)
        return _T("");

    return _T("ogre/files");
}

// Each call returns "filename;contents".
// Return an empty string when there are no more files.
function GetGeneratedFile(file_index)
{
    if (PLATFORM != PLATFORM_MAC && PLATFORM != PLATFORM_MSW)
        return _T("");

    local filename = _T("");
    local templateFile = _T("");

    switch (file_index)
    {
        case 0:
            filename = _T("main.cpp");
            templateFile = _T("ogre/files/main.cpp");
            break;

        case 1:
            filename = _T("plugins.cfg");
            templateFile = _T("ogre/files/plugins.cfg");
            break;

        case 2:
            filename = _T("resources.cfg");
            templateFile = _T("ogre/files/resources.cfg");
            break;

        default:
            return _T("");
    }

    local path =
        Wizard.FindTemplateFile(
            templateFile);

    local buffer =
        IO.ReadFileContents(
            path);

    if (PLATFORM == PLATFORM_MAC)
    {
        buffer.Replace(
            _T("[OGRE_PLUGIN_FOLDER]"),
            OgreMacInstall +
            _T("/lib/macosx/Release"));

        buffer.Replace(
            _T("[OGRE_MEDIA_FOLDER]"),
            OgreMacInstall +
            _T("/Media"));
    }
    else
    {
        local tests = buffer.Find(_T("[Tests]"));

        if (tests != -1)
            buffer = buffer.Mid(0, tests);

        buffer.Replace(
            _T("[OGRE_PLUGIN_FOLDER]"),
            OgreWinPluginDir);

        buffer.Replace(
            _T("[OGRE_MEDIA_FOLDER]"),
            OgreWinInstall +
            wxFILE_SEP_PATH +
            _T("Media"));
    }

    return filename +
           _T(";") +
           buffer;
}

function SetupMacOgreProject(project)
{
    if (!OgreMacAllReady())
        return false;

    local frameworkDir =
        OgreMacInstall +
        _T("/lib/macosx/Release");

    project.AddIncludeDir(
        OgreMacInstall +
        _T("/include/OGRE/Bites"));

    project.AddIncludeDir(
        OgreMacInstall +
        _T("/include/OGRE"));

    project.AddIncludeDir(
        OgreMacInstall +
        _T("/include/OGRE/Overlay"));

    project.AddIncludeDir(
        OgreMacInstall +
        _T("/include/OGRE/RTShaderSystem"));

    project.AddCompilerOption(
        _T("-std=gnu++17"));

    project.AddCompilerOption(
        _T("-iframework ") +
        frameworkDir);

    project.AddLinkerOption(
        _T("-F") +
        frameworkDir);

    project.AddLinkerOption(
        _T("-Wl,-rpath,") +
        frameworkDir);

    project.AddLinkerOption(
        frameworkDir +
        _T("/OgreBites.framework/OgreBites"));

    project.AddLinkerOption(
        frameworkDir +
        _T("/OgreOverlay.framework/OgreOverlay"));

    project.AddLinkerOption(
        frameworkDir +
        _T("/OgreRTShaderSystem.framework/OgreRTShaderSystem"));

    project.AddLinkerOption(
        frameworkDir +
        _T("/Ogre.framework/Ogre"));

    project.AddLinkerOption(
        _T("-framework CoreFoundation"));

    project.AddLinkerOption(
        _T("-framework Foundation"));

    project.AddLinkerOption(
        _T("-Wl,-search_paths_first"));

    project.AddLinkerOption(
        _T("-Wl,-headerpad_max_install_names"));

    WarningsOn(
        project,
        Wizard.GetCompilerID());

    CppExceptionsOn(
        project,
        Wizard.GetCompilerID());

    local target =
        project.GetBuildTarget(
            Wizard.GetDebugName());

    if (!IsNull(target))
    {
        target.SetTargetType(
            ttConsoleOnly);

        target.SetWorkingDir(
    		Wizard.GetProjectPath());

	target.SetOutputFilename(
    		target.SuggestOutputFilename());

        DebugSymbolsOn(
            target,
            Wizard.GetCompilerID());
    }

    target =
        project.GetBuildTarget(
            Wizard.GetReleaseName());

    if (!IsNull(target))
    {
        target.SetTargetType(
            ttExecutable);

        target.SetWorkingDir(
    		Wizard.GetProjectPath());

	target.SetOutputFilename(
    		target.SuggestOutputFilename());

        target.AddCompilerOption(
            _T("-DNDEBUG"));

        OptimizationsOn(
            target,
            Wizard.GetCompilerID());
    }

    return true;
}


////////////////////////////////////////////////////////////////////////////////
// Legacy project setup retained for non-macOS.
////////////////////////////////////////////////////////////////////////////////

function SetupProject(project)
{
   if (PLATFORM == PLATFORM_MAC)
    return SetupMacOgreProject(project);
    if (PLATFORM == PLATFORM_MSW)
        return SetupWinOgreProject(project);
    if (!OgreIsSource) { project.AddCompilerOption(_T("`pkg-config --cflags OGRE`")); project.AddLinkerOption(_T("`pkg-config --libs OGRE`")); }
    project.AddLinkLib(_T("GL"));
    if (OgreIsSource) { project.AddIncludeDir(OgrePath + _T("/OgreMain/include")); project.AddIncludeDir(OgrePath + _T("/Samples/Common/include")); }
    WarningsOn(project, Wizard.GetCompilerID()); CppExceptionsOn(project, Wizard.GetCompilerID());
    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly); if (OgreIsSource) target.SetWorkingDir(OgrePath + _T("/Samples/Common/bin/Debug")); else if (PLATFORM == PLATFORM_MSW) target.SetWorkingDir(OgrePath + _T("/bin/Debug")); project.AddLibDir(OgrePath + _T("/bin/Debug"));
        if (target.GetWorkingDir().Matches(_T(""))) target.SetOutputFilename(target.SuggestOutputFilename()); else target.SetOutputFilename(target.GetWorkingDir() + wxFILE_SEP_PATH + target.SuggestOutputFilename());
        if (PLATFORM == PLATFORM_MSW) { target.AddLinkLib(_T("OgreMain_d")); target.AddLinkLib(_T("OIS_d")); target.AddCompilerOption(_T("-D_DEBUG")); } else { target.AddLinkLib(_T("OgreMain")); target.AddLinkLib(_T("OIS")); }
        if (OgreIsSource) target.AddLibDir(OgrePath + _T("/OgreMain/lib/Debug")); DebugSymbolsOn(target, Wizard.GetCompilerID());
    }
    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable); if (OgreIsSource) target.SetWorkingDir(OgrePath + _T("/Samples/Common/bin/Release")); else if (PLATFORM == PLATFORM_MSW) target.SetWorkingDir(OgrePath + _T("/bin/Release")); project.AddLibDir(OgrePath + _T("/bin/Release"));
        if (target.GetWorkingDir().Matches(_T(""))) target.SetOutputFilename(target.SuggestOutputFilename()); else target.SetOutputFilename(target.GetWorkingDir() + wxFILE_SEP_PATH + target.SuggestOutputFilename());
        target.AddLinkLib(_T("OgreMain")); target.AddLinkLib(_T("OIS")); if (PLATFORM == PLATFORM_MSW) target.AddCompilerOption(_T("-DNDEBUG")); if (OgreIsSource) target.AddLibDir(OgrePath + _T("/OgreMain/lib/Release")); OptimizationsOn(target, Wizard.GetCompilerID());
    }
    return true;
}

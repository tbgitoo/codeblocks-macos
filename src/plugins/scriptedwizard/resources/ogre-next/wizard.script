////////////////////////////////////////////////////////////////////////////////
// OGRE-Next project wizard
//
// macOS only. Acquires the pinned dependency and engine checkouts, applies
// the packaged patches, configures, builds, and installs both trees, then
// generates an ordinary C++ project against the installed engine SDK.
//
// This is not the OGRE 1.x wizard. It does not edit that wizard's files.
////////////////////////////////////////////////////////////////////////////////

OgreNextRoot <- _T("");
OgreNextDepsSource <- _T("");
OgreNextDepsInstall <- _T("");
OgreNextEngineSource <- _T("");
OgreNextEngineBuild <- _T("");
OgreNextInstall <- _T("");
OgreNextPathsValid <- false;

OgreNextBrewAccess <- _T("");
OgreNextBrewExecutable <- _T("");
OgreNextCMakeState <- _T("");
OgreNextPkgconfState <- _T("");
OgreNextCMakePrefix <- _T("");
OgreNextPkgconfPrefix <- _T("");

OgreNextGitAccess <- _T("");
OgreNextGitExecutable <- _T("");
OgreNextGitVersion <- _T("");

OgreNextNativeCMakeAccess <- _T("");
OgreNextNativeCMakeExecutable <- _T("");
OgreNextNativeCMakeVersion <- _T("");

function OgreNextField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");
    local rest = report.Mid(at + needle.Length(), report.Length() - at - needle.Length());
    local nl = rest.Find(_T("\n"));
    return nl == -1 ? rest : rest.Mid(0, nl);
}

function OgreNextJoin(left, right)
{
    if (left.Length() > 0 && left.Mid(left.Length() - 1, 1) == _T("/"))
        return left + right;
    return left + _T("/") + right;
}

function OgreNextResolvePaths()
{
    OgreNextPathsValid = false;
    OgreNextRoot = _T("");
    OgreNextDepsSource = _T("");
    OgreNextDepsInstall = _T("");
    OgreNextEngineSource = _T("");
    OgreNextEngineBuild = _T("");
    OgreNextInstall = _T("");

    local report = Wizard.MacCMakePaths(
        _T("ogre-next-source-3.0.0"),
        _T("ogre-next-3.0.0"));

    if (!OgreNextField(report, _T("valid")).Matches(_T("1")))
        return OgreNextField(report, _T("error"));

    OgreNextRoot = OgreNextField(report, _T("root"));
    OgreNextEngineSource = OgreNextField(report, _T("source"));
    OgreNextEngineBuild = OgreNextField(report, _T("build"));
    OgreNextInstall = OgreNextField(report, _T("install"));
    OgreNextDepsSource = OgreNextJoin(OgreNextRoot, _T("ogre-next-deps-source-3.0.0"));
    OgreNextDepsInstall = OgreNextJoin(
        OgreNextJoin(OgreNextDepsSource, _T("build-codeblocks")),
        _T("ogredeps"));

    if (OgreNextRoot.IsEmpty() || OgreNextEngineSource.IsEmpty() || OgreNextInstall.IsEmpty())
        return _("CMake path resolution returned an incomplete result.");

    OgreNextPathsValid = true;
    return _T("");
}

////////////////////////////////////////////////////////////////////////////////
// Homebrew: cmake and pkgconf only
////////////////////////////////////////////////////////////////////////////////

function OgreNextRememberBrew(report)
{
    local access = OgreNextField(report, _T("access"));
    local executable = OgreNextField(report, _T("executable"));
    if (!access.IsEmpty())
        OgreNextBrewAccess = access;
    if (!executable.IsEmpty())
        OgreNextBrewExecutable = executable;
}

function OgreNextValidateCMake(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0)
        return _("Homebrew reports CMake as installed, but its prefix is invalid.");
    if (!IO.FileExists(prefix + _T("/bin/cmake")))
        return _("CMake was found, but bin/cmake is not present under its Homebrew prefix.");
    OgreNextCMakePrefix = prefix;
    return _T("");
}

function OgreNextValidatePkgconf(prefix)
{
    if (prefix.IsEmpty() || prefix.Find(_T("/")) != 0)
        return _("Homebrew reports pkgconf as installed, but its prefix is invalid.");
    if (!IO.FileExists(prefix + _T("/bin/pkgconf")) && !IO.FileExists(prefix + _T("/bin/pkg-config")))
        return _("pkgconf was found, but neither bin/pkgconf nor bin/pkg-config is present under its Homebrew prefix.");
    OgreNextPkgconfPrefix = prefix;
    return _T("");
}

function OgreNextBrewBlock()
{
    OgreNextBrewAccess = _T("");
    OgreNextBrewExecutable = _T("");
    OgreNextCMakeState = _T("");
    OgreNextPkgconfState = _T("");
    OgreNextCMakePrefix = _T("");
    OgreNextPkgconfPrefix = _T("");

    local report = Wizard.MacBrewFormula(_T("cmake"));
    OgreNextRememberBrew(report);
    OgreNextCMakeState = OgreNextField(report, _T("state"));
    if (!OgreNextBrewAccess.Matches(_T("works")))
    {
        if (OgreNextBrewAccess.Matches(_T("present_unusable")))
            return _("Homebrew was found but could not be used from Code::Blocks.");
        return _("Homebrew could not be used.");
    }
    if (OgreNextCMakeState.Matches(_T("installed")))
    {
        local reason = OgreNextValidateCMake(OgreNextField(report, _T("prefix")));
        if (!reason.IsEmpty())
            return reason;
    }
    else if (OgreNextCMakeState.Matches(_T("missing")))
        return _("CMake is not installed.");
    else
        return _("Homebrew could not be asked about CMake.");

    report = Wizard.MacBrewFormula(_T("pkgconf"));
    OgreNextRememberBrew(report);
    OgreNextPkgconfState = OgreNextField(report, _T("state"));
    if (OgreNextPkgconfState.Matches(_T("installed")))
    {
        local reason = OgreNextValidatePkgconf(OgreNextField(report, _T("prefix")));
        if (!reason.IsEmpty())
            return reason;
    }
    else if (OgreNextPkgconfState.Matches(_T("missing")))
        return _("pkgconf is not installed.");
    else
        return _("Homebrew could not be asked about pkgconf.");

    return _T("");
}

function OgreNextStatusLine(label, state, prefix)
{
    if (state.Matches(_T("installed")) && !prefix.IsEmpty())
        return label + _("\n    Installed: ") + prefix + _("\n\n");
    if (state.Matches(_T("missing")))
        return label + _("\n    Not installed\n\n");
    return label + _("\n    Could not be checked\n\n");
}

function OgreNextBrewPage(reason)
{
    local text = _("The OGRE-Next workflow uses Homebrew only for cmake and pkgconf.\n\nCode::Blocks does not install Homebrew, SDL2, or shaderc.\n\n");
    if (OgreNextBrewAccess.Matches(_T("works")))
        text += _("Homebrew\n    Found: ") + OgreNextBrewExecutable + _("\n    Access from Code::Blocks: OK\n\n");
    else
        text += _("Homebrew\n    Not usable\n\n");
    text += OgreNextStatusLine(_("CMake"), OgreNextCMakeState, OgreNextCMakePrefix);
    text += OgreNextStatusLine(_("pkgconf"), OgreNextPkgconfState, OgreNextPkgconfPrefix);
    if (!reason.IsEmpty())
        text += reason + _("\n\n");
    if (!OgreNextBrewAccess.Matches(_T("works")))
        text += _("Press Next to choose an existing brew executable or open the Homebrew site.\n");
    else
        text += _("Press Next to install the next missing prerequisite with Homebrew.\n");
    return text;
}

function OgreNextConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacBrewTry(path, true);
    if (OgreNextField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }
    return _("That file did not pass brew --version, so it was not remembered.\n\n") + OgreNextField(report, _T("version"));
}

function OgreNextOfferHomebrewHelp()
{
    local choice = Wizard.MacBrewChoice(
        _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
        _("Help me find Homebrew"),
        _("Installation instructions"));
    if (choice == 1)
    {
        local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
        local rejected = OgreNextConsiderBrew(picked);
        if (!rejected.IsEmpty())
            ShowError(rejected);
    }
    else if (choice == 2)
        wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
}

function OgreNextInstallFormula(formula, displayName)
{
    local explanation = _("The OGRE-Next workflow needs ") + displayName + _(".\n\nCode::Blocks will ask Homebrew to install the formula \"") + formula + _("\".\nNothing is installed until you approve it.");
    local report = Wizard.MacBrewInstall(formula, explanation, _("Install ") + displayName + _(" using Homebrew"));
    if (OgreNextField(report, _T("success")).Matches(_T("1")))
        return true;
    if (OgreNextField(report, _T("password")).Matches(_T("1")))
        ShowError(_("Homebrew asked for a password. The install was stopped."));
    else if (OgreNextField(report, _T("cancelled")).Matches(_T("1")))
        ShowMessage(_("The install was stopped. Files already written are left in place."));
    else if (OgreNextField(report, _T("launched")).Matches(_T("1")))
        ShowError(displayName + _(" was not installed successfully.\n\n") + OgreNextField(report, _T("output")));
    return false;
}

function OnLeave_OgreNextPrerequisites(fwd)
{
    if (!fwd)
        return true;
    local reason = OgreNextBrewBlock();
    if (reason.IsEmpty())
        return true;
    if (!OgreNextBrewAccess.Matches(_T("works")))
    {
        OgreNextOfferHomebrewHelp();
        return OgreNextBrewBlock().IsEmpty();
    }
    if (OgreNextCMakeState.Matches(_T("missing")))
    {
        if (!OgreNextInstallFormula(_T("cmake"), _("CMake")))
            return false;
    }
    else if (OgreNextPkgconfState.Matches(_T("missing")))
    {
        if (!OgreNextInstallFormula(_T("pkgconf"), _("pkgconf")))
            return false;
    }
    else
        return false;
    reason = OgreNextBrewBlock();
    if (reason.IsEmpty())
        return true;
    ShowMessage(OgreNextBrewPage(reason));
    return false;
}

////////////////////////////////////////////////////////////////////////////////
// Git and CMake
////////////////////////////////////////////////////////////////////////////////

function OgreNextGitBlock()
{
    local report = Wizard.MacGitProbe();
    OgreNextGitAccess = OgreNextField(report, _T("access"));
    OgreNextGitExecutable = OgreNextField(report, _T("executable"));
    OgreNextGitVersion = OgreNextField(report, _T("version"));
    if (OgreNextGitAccess.Matches(_T("works")))
        return _T("");
    if (OgreNextGitAccess.Matches(_T("present_unusable")))
        return _("Git was found but could not be used from Code::Blocks.");
    return _("Git could not be found. Code::Blocks does not install Git.");
}

function OgreNextConsiderGit(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacGitTry(path);
    if (OgreNextField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/git/executable"), path);
        return _T("");
    }
    return _("That file did not pass git --version, so it was not remembered.\n\n") + OgreNextField(report, _T("version")) + _("\n") + OgreNextField(report, _T("error"));
}

function OgreNextGitPage(reason)
{
    local text = _("OGRE-Next is obtained from the official upstream Git repositories.\n\n");
    if (OgreNextGitAccess.Matches(_T("works")))
        text += _("Git\n    Found: ") + OgreNextGitExecutable + _("\n    Version: ") + OgreNextGitVersion + _("\n    Access from Code::Blocks: OK\n\n");
    else
        text += _("Git\n    Not usable\n\n");
    if (!reason.IsEmpty())
        text += reason + _("\n\n");
    return text + _("Code::Blocks does not install Git.\nPress Next to choose an existing Git executable.\n");
}

function OnLeave_OgreNextGit(fwd)
{
    if (!fwd)
        return true;
    if (OgreNextGitBlock().IsEmpty())
        return true;
    local picked = IO.SelectFile(_("Choose the Git executable"), _T(""), _("All files (*)|*"));
    local rejected = OgreNextConsiderGit(picked);
    if (!rejected.IsEmpty())
        ShowError(rejected);
    return OgreNextGitBlock().IsEmpty();
}

function OgreNextCMakeBlock()
{
    local report = Wizard.MacCMakeProbe();
    OgreNextNativeCMakeAccess = OgreNextField(report, _T("access"));
    OgreNextNativeCMakeExecutable = OgreNextField(report, _T("executable"));
    OgreNextNativeCMakeVersion = OgreNextField(report, _T("version"));
    if (OgreNextNativeCMakeAccess.Matches(_T("works")))
        return OgreNextResolvePaths();
    if (OgreNextNativeCMakeAccess.Matches(_T("present_unusable")))
        return _("CMake was found but failed cmake --version.");
    return _("CMake could not be found by the native CMake helper.");
}

function OgreNextConsiderCMake(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacCMakeTry(path);
    if (OgreNextField(report, _T("access")).Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/cmake/executable"), path);
        return _T("");
    }
    return _("That file did not pass cmake --version, so it was not remembered.\n\n") + OgreNextField(report, _T("version")) + _("\n") + OgreNextField(report, _T("error"));
}

function OgreNextCMakePage(reason)
{
    local text = _("CMake validation and Code::Blocks-owned paths.\n\n");
    if (OgreNextNativeCMakeAccess.Matches(_T("works")))
        text += _("CMake\n    Found: ") + OgreNextNativeCMakeExecutable + _("\n    Version: ") + OgreNextNativeCMakeVersion + _("\n\n");
    else
        text += _("CMake\n    Not usable through the native helper\n\n");
    if (OgreNextPathsValid)
    {
        text += _("Dependency checkout:\n    ") + OgreNextDepsSource + _("\n\n");
        text += _("Dependency SDK:\n    ") + OgreNextDepsInstall + _("\n\n");
        text += _("Engine checkout:\n    ") + OgreNextEngineSource + _("\n\n");
        text += _("Engine install:\n    ") + OgreNextInstall + _("\n\n");
    }
    if (!reason.IsEmpty())
        text += reason + _("\n\nPress Next to choose an existing CMake executable.\n");
    else
        text += _("CMake and paths are ready.\n");
    return text;
}

function OnLeave_OgreNextCMake(fwd)
{
    if (!fwd)
        return true;
    local reason = OgreNextCMakeBlock();
    if (reason.IsEmpty())
        return true;
    if (!OgreNextNativeCMakeAccess.Matches(_T("works")))
    {
        local picked = IO.SelectFile(_("Choose the CMake executable"), _T(""), _("All files (*)|*"));
        local rejected = OgreNextConsiderCMake(picked);
        if (!rejected.IsEmpty())
            ShowError(rejected);
    }
    reason = OgreNextCMakeBlock();
    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// Checkout, patch, configure, build, install
////////////////////////////////////////////////////////////////////////////////

function OgreNextAcquire(sourceId, explanation, confirmLabel)
{
    local report = Wizard.MacGitAcquire(sourceId, explanation, confirmLabel);
    if (OgreNextField(report, _T("success")).Matches(_T("1")))
        return true;
    if (OgreNextField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The checkout was stopped. Partial files are left in place."));
        return false;
    }
    ShowError(_("The pinned checkout was not acquired.\n\n") + OgreNextField(report, _T("output")));
    return false;
}

function OgreNextCheckoutReady(sourceId, path)
{
    local gitDir = OgreNextJoin(path, _T(".git"));
    if (!IO.DirectoryExists(gitDir) && !IO.FileExists(gitDir))
        return false;
    if (!IO.FileExists(OgreNextJoin(path, _T("CMakeLists.txt"))))
        return false;
    // The directory already exists, so this does not ask to clone.
    // A different commit is refused and left untouched.
    local report = Wizard.MacGitAcquire(sourceId, _T("unused"), _T("unused"));
    return OgreNextField(report, _T("success")).Matches(_T("1"));
}

function OgreNextPatchState(patchId, source)
{
    local report = Wizard.MacPatchProbe(patchId, source);
    return OgreNextField(report, _T("state"));
}

function OgreNextApplyRequired(patchId, source, explanation, confirmLabel)
{
    local state = OgreNextPatchState(patchId, source);
    if (state.Matches(_T("already_applied")))
        return true;
    if (!state.Matches(_T("applicable")))
    {
        local report = Wizard.MacPatchProbe(patchId, source);
        ShowError(_("This patch cannot be applied, so configuration will not start.\n\n") + OgreNextField(report, _T("error")));
        return false;
    }
    local report = Wizard.MacPatchApply(patchId, source, explanation, confirmLabel);
    if (OgreNextField(report, _T("success")).Matches(_T("1")))
        return true;
    if (OgreNextField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The patch was not applied. Configuration will not start."));
        return false;
    }
    local error = OgreNextField(report, _T("error"));
    if (error.IsEmpty())
        error = OgreNextField(report, _T("output"));
    ShowError(_("The patch was not applied.\n\n") + error);
    return false;
}

function OgreNextDepsInstalled()
{
    if (!OgreNextPathsValid)
        return false;
    local root = OgreNextDepsInstall;
    return IO.FileExists(OgreNextJoin(root, _T("include/FreeImage.h")))
        && IO.FileExists(OgreNextJoin(root, _T("include/ft2build.h")))
        && IO.FileExists(OgreNextJoin(root, _T("include/Remotery.h")))
        && IO.DirectoryExists(OgreNextJoin(root, _T("include/rapidjson")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/libFreeImage.a")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/libfreetype.a")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/libzziplib.a")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/libzlib.a")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/libRemotery.dylib")));
}

function OgreNextEngineInstalled()
{
    if (!OgreNextPathsValid)
        return false;
    local root = OgreNextInstall;
    return IO.FileExists(OgreNextJoin(root, _T("include/OGRE/OgreRoot.h")))
        && IO.DirectoryExists(OgreNextJoin(root, _T("include/OGRE/Hlms/Common")))
        && IO.FileExists(OgreNextJoin(root, _T("include/OGRE/Hlms/Unlit/OgreHlmsUnlit.h")))
        && IO.FileExists(OgreNextJoin(root, _T("include/OGRE/Hlms/Pbs/OgreHlmsPbs.h")))
        && IO.DirectoryExists(OgreNextJoin(root, _T("include/OGRE/Compositor")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/Ogre.framework/Versions/3.0/Ogre")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/OgreHlmsPbs.framework/Versions/3.0/OgreHlmsPbs")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/OgreHlmsUnlit.framework/Versions/3.0/OgreHlmsUnlit")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/RenderSystem_Metal.framework/Versions/3.0/RenderSystem_Metal")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/RenderSystem_GL3Plus.framework/Versions/3.0/RenderSystem_GL3Plus")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/RenderSystem_NULL.framework/Versions/3.0/RenderSystem_NULL")))
        && IO.FileExists(OgreNextJoin(root, _T("lib/Release/Plugin_ParticleFX.framework/Versions/3.0/Plugin_ParticleFX")))
        && IO.FileExists(OgreNextJoin(root, _T("bin/plugins.cfg")))
        && IO.FileExists(OgreNextJoin(root, _T("bin/resources2.cfg")))
        && IO.DirectoryExists(OgreNextJoin(root, _T("Media/Hlms/Pbs/Metal")))
        && IO.DirectoryExists(OgreNextJoin(root, _T("Media/Hlms/Unlit/Metal")))
        && IO.FileExists(OgreNextJoin(root, _T("Media/models/ogrehead.mesh")))
        && IO.FileExists(OgreNextJoin(root, _T("Media/materials/textures/GreenSkin.jpg")))
        && IO.FileExists(OgreNextJoin(root, _T("Media/materials/textures/tusk.jpg")));
}

function OgreNextRun(projectId, operation, explanation, confirmLabel)
{
    local report = Wizard.MacCMakeOgreNext(projectId, operation, explanation, confirmLabel);
    if (OgreNextField(report, _T("success")).Matches(_T("1")))
        return true;
    if (OgreNextField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("CMake was stopped. Files already written are left in place."));
        return false;
    }
    ShowError(_("OGRE-Next ") + operation + _(" did not succeed.\n\n") + OgreNextField(report, _T("output")));
    return false;
}

function OgreNextBuildTree(projectId, title)
{
    local configure = _("Code::Blocks will configure ") + title + _(".\n\nThe options are fixed by Code::Blocks. This page does not accept extra CMake arguments.");
    if (projectId.Matches(_T("ogre-next")))
    {
        configure += _("\n\nInstall prefix:\n") + OgreNextInstall;
        configure += _("\n\nDependencies:\n") + OgreNextDepsInstall;
        configure += _("\n\nSamples and tests stay off. The prefix is fixed before the build.");
    }
    else
    {
        configure += _("\n\nThe dependency project selects its own ogredeps directory. Code::Blocks does not pass CMAKE_INSTALL_PREFIX.");
    }
    if (!OgreNextRun(projectId, _T("configure"), configure, _("Configure ") + title))
        return false;

    local build = _("Code::Blocks will build ") + title + _(".\n\nThis step does not install it.");
    if (!OgreNextRun(projectId, _T("build"), build, _("Build ") + title))
        return false;

    local install = _("Code::Blocks will install ") + title + _(" with cmake --install.\n\nNo replacement prefix is passed. The prefix from configuration is used.");
    if (!OgreNextRun(projectId, _T("install"), install, _("Install ") + title))
        return false;

    return true;
}

function OnLeave_OgreNextAcquireDeps(fwd)
{
    if (!fwd)
        return true;
    if (OgreNextCheckoutReady(_T("ogre-next-deps"), OgreNextDepsSource))
        return true;
    local explanation = _("Code::Blocks will check out the pinned OGRE-Next dependency sources.\n\nDestination:\n") + OgreNextDepsSource + _("\n\nThe commit and the SDL2 submodule pin are fixed. This step downloads source only.");
    return OgreNextAcquire(_T("ogre-next-deps"), explanation, _("Download OGRE-Next dependencies"));
}

function OnLeave_OgreNextPatchDeps(fwd)
{
    if (!fwd)
        return true;
    if (!OgreNextCheckoutReady(_T("ogre-next-deps"), OgreNextDepsSource))
    {
        ShowError(_("The dependency checkout is not the pinned revision."));
        return false;
    }
    local mingw = _("Code::Blocks will apply the packaged MinGW dependency patch to the pinned checkout.\n\nThe Apple Remotery patch is applied after this one.\nDeclining leaves the checkout unchanged and does not start configuration.");
    if (!OgreNextApplyRequired(_T("ogre-next-deps-mingw"), OgreNextDepsSource, mingw, _("Apply dependency patch")))
        return false;
    local apple = _("Code::Blocks will apply the Remotery framework link after the MinGW dependency patch.\n\nIt links Foundation, Metal, and QuartzCore. Declining does not start configuration.");
    return OgreNextApplyRequired(_T("ogre-next-deps-apple"), OgreNextDepsSource, apple, _("Apply Remotery patch"));
}

function OnLeave_OgreNextBuildDeps(fwd)
{
    if (!fwd)
        return true;
    if (OgreNextDepsInstalled())
        return true;
    if (!OgreNextBuildTree(_T("ogre-next-deps"), _("the OGRE-Next dependencies")))
        return false;
    if (OgreNextDepsInstalled())
        return true;
    ShowError(_("CMake finished, but the dependency SDK file list is not present."));
    return false;
}

function OnLeave_OgreNextAcquireEngine(fwd)
{
    if (!fwd)
        return true;
    if (OgreNextCheckoutReady(_T("ogre-next"), OgreNextEngineSource))
        return true;
    local explanation = _("Code::Blocks will check out the pinned OGRE-Next engine sources.\n\nDestination:\n") + OgreNextEngineSource + _("\n\nThe commit is fixed. This step downloads source only.");
    return OgreNextAcquire(_T("ogre-next"), explanation, _("Download OGRE-Next"));
}

function OnLeave_OgreNextPatchEngine(fwd)
{
    if (!fwd)
        return true;
    if (!OgreNextCheckoutReady(_T("ogre-next"), OgreNextEngineSource))
    {
        ShowError(_("The engine checkout is not the pinned revision."));
        return false;
    }
    local mingw = _("Code::Blocks will apply the packaged OGRE-Next engine patch to the pinned checkout.\n\nThe Mac engine patch is applied after this one.\nDeclining leaves the checkout unchanged and does not start configuration.");
    if (!OgreNextApplyRequired(_T("ogre-next-v3-0-mingw"), OgreNextEngineSource, mingw, _("Apply engine patch")))
        return false;
    local apple = _("Code::Blocks will apply the Mac engine patch after the MinGW engine patch.\n\nIt closes the Metal window brace and moves include/GL out of the Apple guard. Declining does not start configuration.");
    return OgreNextApplyRequired(_T("ogre-apple"), OgreNextEngineSource, apple, _("Apply Mac engine patch"));
}

function OnLeave_OgreNextBuildEngine(fwd)
{
    if (!fwd)
        return true;
    if (OgreNextEngineInstalled())
        return true;
    if (!OgreNextDepsInstalled())
    {
        ShowError(_("The dependency SDK is not installed."));
        return false;
    }
    if (!OgreNextBuildTree(_T("ogre-next"), _("OGRE-Next")))
        return false;
    if (OgreNextEngineInstalled())
        return true;
    ShowError(_("CMake finished, but the OGRE-Next SDK file list is not present."));
    return false;
}

function OgreNextAllReady()
{
    local reason = OgreNextBrewBlock();
    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }
    reason = OgreNextCMakeBlock();
    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }
    reason = OgreNextGitBlock();
    if (!reason.IsEmpty())
    {
        ShowError(reason);
        return false;
    }
    if (!OgreNextCheckoutReady(_T("ogre-next-deps"), OgreNextDepsSource))
    {
        ShowError(_("The pinned dependency checkout is not present."));
        return false;
    }
    if (!OgreNextPatchState(_T("ogre-next-deps-mingw"), OgreNextDepsSource).Matches(_T("already_applied"))
        || !OgreNextPatchState(_T("ogre-next-deps-apple"), OgreNextDepsSource).Matches(_T("already_applied")))
    {
        ShowError(_("The dependency patches are not applied."));
        return false;
    }
    if (!OgreNextDepsInstalled())
    {
        ShowError(_("The dependency SDK is not installed."));
        return false;
    }
    if (!OgreNextCheckoutReady(_T("ogre-next"), OgreNextEngineSource))
    {
        ShowError(_("The pinned OGRE-Next checkout is not present."));
        return false;
    }
    if (!OgreNextPatchState(_T("ogre-next-v3-0-mingw"), OgreNextEngineSource).Matches(_T("already_applied"))
        || !OgreNextPatchState(_T("ogre-apple"), OgreNextEngineSource).Matches(_T("already_applied")))
    {
        ShowError(_("The engine patches are not applied."));
        return false;
    }
    if (!OgreNextEngineInstalled())
    {
        ShowError(_("The OGRE-Next SDK is not installed."));
        return false;
    }
    return true;
}

////////////////////////////////////////////////////////////////////////////////
// Generated project
////////////////////////////////////////////////////////////////////////////////

function GetFilesDir()
{
    return _T("");
}

function GetGeneratedFile(file_index)
{
    local filename = _T("");
    local templateFile = _T("");

    switch (file_index)
    {
        case 0:
            filename = _T("main.cpp");
            templateFile = _T("ogre-next/files/main.cpp");
            break;
        case 1:
            filename = _T("plugins.cfg");
            templateFile = _T("ogre-next/files/plugins.cfg");
            break;
        case 2:
            filename = _T("resources2.cfg");
            templateFile = _T("ogre-next/files/resources2.cfg");
            break;
        default:
            return _T("");
    }

    local path = Wizard.FindTemplateFile(templateFile);
    local buffer = IO.ReadFileContents(path);
    buffer.Replace(_T("[OGRE_NEXT_MEDIA]"), OgreNextJoin(OgreNextInstall, _T("Media")));
    buffer.Replace(_T("[OGRE_NEXT_TEXTURES]"), OgreNextJoin(OgreNextInstall, _T("Media/materials/textures")));
    return filename + _T(";") + buffer;
}

function OgreNextBundleOutput(outputDir, name)
{
    return outputDir + name + _T(".app/Contents/MacOS/") + name;
}

function SetupProject(project)
{

if (PLATFORM == PLATFORM_MSW)
{
    ShowError(_("The Windows project is added in a later step. Press Cancel."));
    return false;
}

    if (!OgreNextAllReady())
        return false;

    local includeRoot = OgreNextJoin(OgreNextInstall, _T("include/OGRE"));
    local frameworkDir = OgreNextJoin(OgreNextInstall, _T("lib/Release"));

    project.AddIncludeDir(includeRoot);
    project.AddIncludeDir(OgreNextJoin(includeRoot, _T("Hlms/Common")));
    project.AddIncludeDir(OgreNextJoin(includeRoot, _T("Hlms/Unlit")));
    project.AddIncludeDir(OgreNextJoin(includeRoot, _T("Hlms/Pbs")));
    project.AddCompilerOption(_T("-std=gnu++17"));

    project.AddLinkerOption(_T("-F") + frameworkDir);
    project.AddLinkerOption(_T("-framework Ogre"));
    project.AddLinkerOption(_T("-framework OgreHlmsPbs"));
    project.AddLinkerOption(_T("-framework OgreHlmsUnlit"));
    project.AddLinkerOption(_T("-Wl,-search_paths_first"));
    project.AddLinkerOption(_T("-Wl,-headerpad_max_install_names"));

    // The frameworks' install names are @executable_path/../Frameworks.
    // plugins.cfg, resources2.cfg, and ogrehead.mesh live in the created
    // project folder. GetProjectPath() is the parent folder chosen on the
    // path page, so the working directory is the folder that contains the
    // project file.
    local afterBuild =
        _T("/bin/ln -sfn \"") + frameworkDir + _T("\" \"$(TARGET_OUTPUT_DIR)../Frameworks\" && /bin/cp -f \"")
        + OgreNextJoin(OgreNextInstall, _T("Media/models/ogrehead.mesh"))
        + _T("\" \"$(PROJECT_DIR)/ogrehead.mesh\"");
    project.AddCommandsAfterBuild(afterBuild);

    WarningsOn(project, Wizard.GetCompilerID());
    CppExceptionsOn(project, Wizard.GetCompilerID());

    local name = Wizard.GetProjectName();
    local projectDir = Wizard.GetProjectFullFilename().BeforeLast(_T("/"));
    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly);
        target.SetWorkingDir(projectDir);
        target.SetOutputFilename(OgreNextBundleOutput(Wizard.GetDebugOutputDir(), name));
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable);
        target.SetWorkingDir(projectDir);
        target.SetOutputFilename(OgreNextBundleOutput(Wizard.GetReleaseOutputDir(), name));
        target.AddCompilerOption(_T("-DNDEBUG"));
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

////////////////////////////////////////////////////////////////////////////////
// Wizard pages
////////////////////////////////////////////////////////////////////////////////
function BeginWinOgreNext()
{
    local intro = _("Welcome to the OGRE-Next project wizard.\n\nThis creates a C++ project for OGRE-Next 3.0.0.\n\nI'm not doing anything useful yet. Your wizard truly\n\nPress Cancel.");
    Wizard.AddInfoPage(_T("OgreNextWinIntro"), intro);
    Wizard.AddProjectPathPage();
    Wizard.AddCompilerPage(_T(""), _T("*"), true, true);
}

function BeginWizard()
{

if (PLATFORM == PLATFORM_MSW)
{
    BeginWinOgreNext();
    return;
}
    local intro = _("Welcome to the OGRE-Next project wizard.\n\nThis creates an ordinary C++ project for the pinned OGRE-Next 3.0.0 SDK. It is separate from the OGRE project wizard.\n\nCode::Blocks checks out the dependency and engine sources, applies the packaged patches, and installs the SDK under Library/CodeBlocks. The generated project links only that installed SDK.\n\nThe engine MinGW patch is applied first. The Mac engine patch is applied after it. That patch closes the Metal window brace and moves include/GL out of the Apple guard.\n\nCompleted checkout, patch, build, and install stages are skipped.");
    Wizard.AddInfoPage(_T("OgreNextIntro"), intro);

    local reason = OgreNextResolvePaths();
    if (!reason.IsEmpty())
    {
        Wizard.AddInfoPage(_T("OgreNextPaths"), reason);
        return;
    }

    reason = OgreNextBrewBlock();
    if (!reason.IsEmpty())
        Wizard.AddInfoPage(_T("OgreNextPrerequisites"), OgreNextBrewPage(reason));

    reason = OgreNextCMakeBlock();
    if (!reason.IsEmpty())
        Wizard.AddInfoPage(_T("OgreNextCMake"), OgreNextCMakePage(reason));

    local gitReason = OgreNextGitBlock();
    if (!gitReason.IsEmpty())
        Wizard.AddInfoPage(_T("OgreNextGit"), OgreNextGitPage(gitReason));

    if (!OgreNextCheckoutReady(_T("ogre-next-deps"), OgreNextDepsSource))
    {
        Wizard.AddInfoPage(
            _T("OgreNextAcquireDeps"),
            _("The pinned OGRE-Next dependency checkout is not present.\n\nDestination:\n    ") + OgreNextDepsSource + _("\n\nPress Next to download it. The commit and SDL2 submodule are fixed."));
    }

    if (!OgreNextPatchState(_T("ogre-next-deps-mingw"), OgreNextDepsSource).Matches(_T("already_applied"))
        || !OgreNextPatchState(_T("ogre-next-deps-apple"), OgreNextDepsSource).Matches(_T("already_applied")))
    {
        Wizard.AddInfoPage(
            _T("OgreNextPatchDeps"),
            _("The dependency checkout needs its packaged patches.\n\nThe MinGW patch is applied first. The Remotery framework patch is applied after it.\n\nPress Next to review each patch. Declining either one does not start configuration."));
    }

    if (!OgreNextDepsInstalled())
    {
        Wizard.AddInfoPage(
            _T("OgreNextBuildDeps"),
            _("The OGRE-Next dependency SDK is not installed.\n\nDestination:\n    ") + OgreNextDepsInstall + _("\n\nPress Next to configure, build, and install it. The dependency project chooses the ogredeps directory itself."));
    }

    if (!OgreNextCheckoutReady(_T("ogre-next"), OgreNextEngineSource))
    {
        Wizard.AddInfoPage(
            _T("OgreNextAcquireEngine"),
            _("The pinned OGRE-Next engine checkout is not present.\n\nDestination:\n    ") + OgreNextEngineSource + _("\n\nPress Next to download it."));
    }

    if (!OgreNextPatchState(_T("ogre-next-v3-0-mingw"), OgreNextEngineSource).Matches(_T("already_applied"))
        || !OgreNextPatchState(_T("ogre-apple"), OgreNextEngineSource).Matches(_T("already_applied")))
    {
        Wizard.AddInfoPage(
            _T("OgreNextPatchEngine"),
            _("The engine checkout needs its packaged patches.\n\nThe MinGW patch is applied first. The Mac patch, which closes the Metal window brace and moves include/GL out of the Apple guard, is applied after it.\n\nPress Next to review each patch. Declining either one does not start configuration."));
    }

    if (!OgreNextEngineInstalled())
    {
        Wizard.AddInfoPage(
            _T("OgreNextBuildEngine"),
            _("The OGRE-Next SDK is not installed.\n\nInstall prefix:\n    ") + OgreNextInstall + _("\n\nDependencies:\n    ") + OgreNextDepsInstall + _("\n\nPress Next to configure, build, and install the engine. The install prefix is fixed during configuration."));
    }

    Wizard.AddProjectPathPage();
    Wizard.AddCompilerPage(_T(""), _T("*"), true, true);
}

function OnLeave_OgreNextPaths(fwd)
{
    if (!fwd)
        return true;
    local reason = OgreNextResolvePaths();
    if (reason.IsEmpty())
        reason = _("The paths are valid now. Close this wizard and start it again.");
    ShowError(reason);
    return false;
}

function OnLeave_ProjectPathPage(fwd)
{
    return !fwd || OgreNextAllReady();
}

function OnLeave_CompilerPage(fwd)
{
    return !fwd || OgreNextAllReady();
}

////////////////////////////////////////////////////////////////////////////////
//
// Code::Blocks new project wizard script
//
// Project: D application
// Original author: Yiannis Mandravellos
// tbgitoo: macOS Homebrew discovery/install support added for DMD, GDC and LDC.
//
////////////////////////////////////////////////////////////////////////////////

// Put LDC first so it is the preferred/default D compiler offered by the
// compiler page. DMD and GDC remain available as explicit alternatives.
DCompilerIDs      <- _T("ldc;dmd;gdc");
DMacFormula       <- _T("");
DMacState         <- _T("");
DMacAccess        <- _T("");
DMacExecutable    <- _T("");
DMacPrefix        <- _T("");

function BeginWizard()
{
    local intro_msg = _("Welcome to the new D application wizard!\n") +
                      _("This wizard will guide you to create a new D application.\n\n") +
                      _("LDC is the preferred compiler; DMD and GDC can also be selected on the compiler page.\n\n") +
                      _("On macOS, the wizard can use Homebrew to install the compiler selected on the compiler page.\n") +
                      _("Code::Blocks does not install Homebrew.\n\n") +
                      _("When you're ready to proceed, please click \"Next\"...");

    Wizard.AddInfoPage(_T("DIntro"), intro_msg);
    Wizard.AddProjectPathPage();

    // The compiler page permits selection and configuration of the supported
    // Code::Blocks D compiler profiles. Ordering makes LDC the first choice.
    Wizard.AddCompilerPage(_T("ldc"), DCompilerIDs, true, true);
}

function DReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");

    local from = at + needle.Length();
    local rest = report.Mid(from, report.Length() - from);
    local nl = rest.Find(_T("\n"));
    if (nl == -1)
        return rest;
    return rest.Mid(0, nl);
}

function DMacClear()
{
    DMacFormula    = _T("");
    DMacState      = _T("");
    DMacAccess     = _T("");
    DMacExecutable = _T("");
    DMacPrefix     = _T("");
}

// Map the Code::Blocks compiler profile to its Homebrew formula.
// Homebrew supplies GDC as part of GCC rather than as a separate formula.
function DMacFormulaForCompiler(compilerID)
{
    if (compilerID.Matches(_T("ldc")))
        return _T("ldc");
    if (compilerID.Matches(_T("dmd")))
        return _T("dmd");
    if (compilerID.Matches(_T("gdc")))
        return _T("gcc");
    return _T("");
}

// Empty string means that the selected compiler formula is installed.
function DMacBlockReason(compilerID)
{
    DMacClear();
    DMacFormula = DMacFormulaForCompiler(compilerID);
    if (DMacFormula.IsEmpty())
        return _("The selected compiler is not supported by the macOS automatic setup.");

    local report = Wizard.MacBrewFormula(DMacFormula);

    DMacState      = DReportField(report, _T("state"));
    DMacAccess     = DReportField(report, _T("access"));
    DMacExecutable = DReportField(report, _T("executable"));
    DMacPrefix     = DReportField(report, _T("prefix"));

    if (DMacState.Matches(_T("installed")))
    {
        if (DMacPrefix.IsEmpty() || DMacPrefix.Find(_T("/")) != 0)
            return _("Homebrew reports the compiler as installed, but its prefix is invalid. No project was created.");

        local detectReport = Wizard.AutoDetectCompiler(compilerID);

        local found    = DReportField(detectReport, _T("found"));
        local detected = DReportField(detectReport, _T("detected"));
        local master   = DReportField(detectReport, _T("master"));

        if (!found.Matches(_T("1")))
            return _("The selected Code::Blocks compiler profile could not be found.");

        if (!detected.Matches(_T("1")))
            return _("The compiler is installed, but Code::Blocks could not auto-detect its installation directory.");

        if (master.IsEmpty() || master.Find(_T("/")) != 0)
            return _("Code::Blocks detected the compiler, but returned an invalid installation directory.");

        return _T("");
    }

    if (DMacState.Matches(_T("missing")))
        return _("The selected D compiler is not installed.");
    if (DMacState.Matches(_T("brew_unavailable")))
        return _("Homebrew could not be used.");
    return _("Homebrew could not be asked about the selected D compiler.");
}

function DMacConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");

    local report = Wizard.MacBrewTry(path, true);

    local access = DReportField(report, _T("access"));
    if (access.Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }

    return _("That file did not pass brew --version, so it was not remembered.") +
           _("\n\n") + DReportField(report, _T("executable")) +
           _("\n") + DReportField(report, _T("version"));
}

function DMacOfferHomebrewHelp()
{
    local choice = Wizard.MacBrewChoice(
        _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
        _("Help me find Homebrew"),
        _("Installation instructions"));

    if (choice == 1)
    {
        local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
        local rejected = DMacConsiderBrew(picked);
        if (!rejected.IsEmpty())
            ShowError(rejected);
    }
    else if (choice == 2)
    {
        wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
    }
}

function DMacOfferInstall(compilerID)
{
    DMacFormula = DMacFormulaForCompiler(compilerID);
    if (DMacFormula.IsEmpty())
    {
        ShowError(_("The selected compiler is not supported by the macOS automatic setup. No project was created."));
        return false;
    }

    local explanation = _("This project needs the selected D compiler.\n\n") +
                        _("Code::Blocks will ask Homebrew to install the formula \"") +
                        DMacFormula + _("\".\n") +
                        _("Nothing is installed until you choose Install using Homebrew.\n") +
                        _("Cancel on this dialog does not start the install.");

    local report = Wizard.MacBrewInstall(
        DMacFormula,
        explanation,
        _("Install using Homebrew"));

    if (DReportField(report, _T("success")).Matches(_T("1")))
    {
        local reason = DMacBlockReason(compilerID);
        if (reason.IsEmpty())
            return true;
        ShowError(reason + _(" No project was created."));
        return false;
    }
    if (DReportField(report, _T("password")).Matches(_T("1")))
    {
        ShowError(_("Homebrew asked for a password. The install was stopped and is not treated as successful. No project was created."));
        return false;
    }
    if (DReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The install was stopped. That does not undo files Homebrew may already have written. No project was created."));
        return false;
    }
    if (DReportField(report, _T("launched")).Matches(_T("1")))
    {
        ShowError(_("Homebrew did not finish successfully. The compiler was not marked installed. No project was created.\n\n") +
                  DReportField(report, _T("output")));
        return false;
    }

    return false;
}

function DMacAllowForward()
{
    if (PLATFORM != PLATFORM_MAC)
        return true;

    local compilerID = Wizard.GetCompilerID();

    local reason = DMacBlockReason(compilerID);
    if (reason.IsEmpty())
        return true;

    if (!DMacAccess.Matches(_T("works")))
    {
        DMacOfferHomebrewHelp();

        reason = DMacBlockReason(compilerID);
        if (reason.IsEmpty())
            return true;

        ShowError(reason + _(" No project was created."));
        return false;
    }

    if (DMacState.Matches(_T("missing")))
        return DMacOfferInstall(compilerID);

    ShowError(reason + _(" No project was created."));
    return false;
}

function OnLeave_CompilerPage(fwd)
{
    if (fwd)
        return DMacAllowForward();

    return true;
}

function GetFilesDir()
{
    return _T("d/console");
}

function SetupProject(project)
{
    // Keep the original D compiler behaviour.
    if (Wizard.GetCompilerID().Matches(_T("gdc")))
        WarningsOn(project, Wizard.GetCompilerID());

    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly);
        target.SetOutputFilename(Wizard.GetDebugOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly);
        target.SetOutputFilename(Wizard.GetReleaseOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

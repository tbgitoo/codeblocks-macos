////////////////////////////////////////////////////////////////////////////////
//
// GLFW project wizard
//
////////////////////////////////////////////////////////////////////////////////

// globals
GlfwPathDefault    <- _T("$(#glfw)");
GlfwPathDefaultInc <- _T("$(#glfw.include)");
GlfwPathDefaultLib <- _T("$(#glfw.lib)");
GlfwPath <- _T("");
// macOS: filled only after the installed GLFW tree is accepted
GlfwMacPrefix  <- _T("");
GlfwMacInclude <- _T("");
GlfwMacLib     <- _T("");
GlfwMacState   <- _T("");
GlfwMacAccess  <- _T("");
GlfwMacExecutable <- _T("");
// Windows automatic install. 0 keeps the location page and the historical sample.
GlfwWinAuto    <- 0;
GlfwWinInclude <- _T("");
GlfwWinLib     <- _T("");
GlfwWinDll     <- _T("");
GlfwWinState   <- _T("");
GlfwWinEdition <- _T("");
GlfwWinUrl     <- _T("");
GlfwWinHash    <- _T("");
GlfwWinMachine <- _T("");

function BeginWizard()
{
    local intro_msg = _("Welcome to the new GLFW project wizard!\n\n") +
                      _("This wizard will guide you to create a new project\nusing the GLFW OpenGL extensions.\n\n") +
                      _("When you're ready to proceed, please click \"Next\"...");

    local glfwpath_descr = _("Please select the location of GLFW on your computer.\n") +
                           _("This is the top-level folder where GLFW was installed (unpacked).\n") +
                           _("To help you, this folder must contain the subfolders\n\"include\" and \"lib\".");

    Wizard.AddInfoPage(_T("GlfwIntro"), intro_msg);
    // A suitable GLFW install has no dependency page. Anything else stays on this page
    // until Cancel. The location page is not registered on macOS, so $(#glfw) is not expanded.
    if (PLATFORM == PLATFORM_MAC)
    {
        local reason = GlfwMacBlockReason();
        if (!reason.IsEmpty())
            Wizard.AddInfoPage(_T("GlfwMacDiag"), GlfwMacPageText(reason));
    }
    else if (PLATFORM == PLATFORM_MSW && GlfwWinCompilerMatches(Wizard.WinSdkCompiler(Wizard.GetCompilerID())))
    {
        GlfwWinAuto = 1;
        GlfwWinSelectArchive(Wizard.WinSdkCompiler(Wizard.GetCompilerID()));
        local reason = GlfwWinBlockReason();
        if (!reason.IsEmpty())
            Wizard.AddInfoPage(_T("GlfwWinDiag"), GlfwWinPageText(reason));
    }
    else if (PLATFORM == PLATFORM_MSW)
    {
        Wizard.AddInfoPage(_T("GlfwWinManual"),
            _("The automatic GLFW install does not apply to this compiler.\n\n") +
            _("The next page asks for a GLFW folder you already have.\n") +
            _("Nothing is downloaded."));
    }
    Wizard.AddProjectPathPage();
    if (PLATFORM != PLATFORM_MAC && GlfwWinAuto == 0)
        Wizard.AddGenericSelectPathPage(_T("GlfwPath"), glfwpath_descr, _("Please select GLFW's location:"), GlfwPathDefault);
    Wizard.AddCompilerPage(_T(""), _T("*"), true, true);
}

////////////////////////////////////////////////////////////////////////////////
// GLFW's path page (Windows and other Unix)
////////////////////////////////////////////////////////////////////////////////

function OnLeave_GlfwPath(fwd)
{
    if (fwd)
    {
        local dir         = Wizard.GetTextControlValue(_T("txtFolder")); // txtFolder is the text control in GenericSelectPathPage
        local dir_nomacro = VerifyDirectory(dir);

        if (dir_nomacro.IsEmpty())
            return false;

        // verify include dependencies
        local dir_nomacro_inc = GetCompilerIncludeDir(dir, GlfwPathDefault, GlfwPathDefaultInc);
        if (dir_nomacro_inc.IsEmpty())
            return false;
        if (!VerifyFile(dir_nomacro_inc + wxFILE_SEP_PATH + _T("GLFW"), _T("glfw3.h"), _("GLFW's include"))) return false;

        // verify library dependencies
        local dir_nomacro_lib = GetCompilerLibDir(dir, GlfwPathDefault, GlfwPathDefaultLib);
        if (dir_nomacro_lib.IsEmpty())
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("glfw3"), _("GLFW's"))) return false;


        GlfwPath = dir; // Remember the original selection.

        local is_macro = _T("");

        // try to resolve the include directory as macro
        is_macro = GetCompilerIncludeMacro(dir, GlfwPathDefault, GlfwPathDefaultInc);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real inc path we had computed instead
            GlfwPathDefaultInc = dir_nomacro_inc;
        }

        // try to resolve the library directory as macro
        is_macro = GetCompilerLibMacro(dir, GlfwPathDefault, GlfwPathDefaultLib);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real lib path we had computed instead
            GlfwPathDefaultLib = dir_nomacro_lib;
        }
    }
    return true;
}

function GlfwReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");
    local from = at + needle.Length();
    local rest = report.Mid(from, report.Length() - from);
    local nl = rest.Find(_T("\n"));
    if (nl == -1)
        return rest;
    return rest.Mid(0, nl);
}

function GlfwMacClear()
{
    GlfwMacPrefix = _T("");
    GlfwMacInclude = _T("");
    GlfwMacLib = _T("");
}

// Empty string: this prefix may be written into the project.
// Anything else: do not create a project.
function GlfwMacPrefixDecision(prefix)
{
    GlfwMacClear();
    if (prefix.IsEmpty() || (prefix.Find(_T("/")) != 0))
        return _("GLFW's prefix is not a directory. No project was created.");

    local includeDir = prefix + _T("/include");
    local libDir = prefix + _T("/lib");
    if (!IO.FileExists(includeDir + _T("/GLFW/glfw3.h")))
        return _("GLFW was found, but include/GLFW/glfw3.h is not under ") + prefix + _(". No project was created.");
    if (!IO.FileExists(libDir + _T("/libglfw.dylib")))
        return _("GLFW was found, but libglfw.dylib is not under ") + prefix + _("/lib. No project was created.");

    GlfwMacPrefix = prefix;
    GlfwMacInclude = includeDir;
    GlfwMacLib = libDir;
    return _T("");
}

function GlfwMacBlockReason()
{
    local report = Wizard.MacBrewFormula(_T("glfw"));
    GlfwMacState = GlfwReportField(report, _T("state"));
    GlfwMacAccess = GlfwReportField(report, _T("access"));
    GlfwMacExecutable = GlfwReportField(report, _T("executable"));
    if (GlfwMacState.Matches(_T("installed")))
        return GlfwMacPrefixDecision(GlfwReportField(report, _T("prefix")));
    GlfwMacClear();
    if (GlfwMacState.Matches(_T("missing")))
        return _("Homebrew reports that GLFW is not installed. This wizard will not create a project.");
    if (GlfwMacState.Matches(_T("brew_unavailable")))
        return _("Homebrew could not be used. This wizard will not create a project.");
    return _("Homebrew could not be asked about GLFW. This wizard will not create a project.");
}

function GlfwMacPageText(reason)
{
    local text = _("Some project templates obtain libraries through Homebrew.\n") +
                 _("Code::Blocks does not install Homebrew.\n\n");
    if (GlfwMacAccess.Matches(_T("works")))
    {
        text = text + _("Homebrew\n    Found: ") + GlfwMacExecutable +
               _("\n    Access from Code::Blocks: OK\n\n");
    }
    else if (GlfwMacAccess.Matches(_T("present_unusable")))
    {
        text = text + _("Homebrew\n    Found: ") + GlfwMacExecutable +
               _("\n    Access from Code::Blocks: failed\n") +
               _("That executable was left in place.\n\n");
    }
    else
    {
        text = text + _("Homebrew\n    Not detected\n\n");
    }

    if (GlfwMacState.Matches(_T("missing")))
        text = text + _("GLFW\n    Not installed\n\n");
    else if (GlfwMacAccess.Matches(_T("works")) && !reason.IsEmpty())
        text = text + reason + _("\n\n");

    text = text + _("No project is created from this page.\n");
    if (GlfwMacState.Matches(_T("missing")))
        text = text + _("Press Next to install the glfw formula with Homebrew.\n") +
                      _("Cancel on that dialog does not start the install.\n") +
                      _("Use Cancel on this page to close the wizard.\n");
    else if (GlfwMacAccess.Matches(_T("works")))
        text = text + _("Use Cancel to close the wizard.\n");
    else
        text = text + _("Press Next to choose an existing brew executable, or to open https://brew.sh.\n") +
                      _("Use Cancel to close the wizard.\n");
    return text;
}

// Empty string: the path passed --version and was stored.
// A failed file is not stored, and a previous saved path is left as it was.
function GlfwMacConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacBrewTry(path, true);
    local access = GlfwReportField(report, _T("access"));
    if (access.Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }
    return _("That file did not pass brew --version, so it was not remembered.") +
           _("\n\n") + GlfwReportField(report, _T("executable")) +
           _("\n") + GlfwReportField(report, _T("version"));
}

function GlfwMacOfferInstall()
{
    local explanation = _("This project needs GLFW.\n\n") +
                        _("Code::Blocks will ask Homebrew to install the formula \"glfw\".\n") +
                        _("Nothing is installed until you choose Install GLFW using Homebrew.\n") +
                        _("Cancel on this dialog does not start Homebrew.");
    local report = Wizard.MacBrewInstall(_T("glfw"), explanation, _("Install GLFW using Homebrew"));
    if (GlfwReportField(report, _T("success")).Matches(_T("1")))
    {
        local reason = GlfwMacBlockReason();
        if (reason.IsEmpty())
            return true;
        ShowMessage(GlfwMacPageText(reason));
        return false;
    }
    if (GlfwReportField(report, _T("password")).Matches(_T("1")))
    {
        ShowError(_("Homebrew asked for a password. The install was stopped and is not treated as successful. No project was created."));
        return false;
    }
    if (GlfwReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The install was stopped. That does not undo files Homebrew may already have written. No project was created."));
        return false;
    }
    if (GlfwReportField(report, _T("launched")).Matches(_T("1")))
    {
        ShowError(_("Homebrew did not finish successfully. GLFW was not marked installed. No project was created.\n\n") +
                  GlfwReportField(report, _T("output")));
    }
    return false;
}

function OnLeave_GlfwMacDiag(fwd)
{
    if (!fwd)
        return true;
    if (GlfwMacBlockReason().IsEmpty())
        return true;
    if (!GlfwMacAccess.Matches(_T("works")))
    {
        local choice = Wizard.MacBrewChoice(
            _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
            _("Help me find Homebrew"),
            _("Installation instructions"));
        if (choice == 1)
        {
            local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
            local rejected = GlfwMacConsiderBrew(picked);
            if (!rejected.IsEmpty())
                ShowError(rejected);
        }
        else if (choice == 2)
        {
            wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
        }
        if (GlfwMacBlockReason().IsEmpty())
            return true;
        return false;
    }
    if (GlfwMacState.Matches(_T("missing")))
        return GlfwMacOfferInstall();
    return false;
}

function GlfwMacAllowForward()
{
    if (PLATFORM != PLATFORM_MAC)
        return true;
    local reason = GlfwMacBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowError(reason);
    return false;
}

// The 3.5.1 Windows README names the MinGW-w64 binaries as win32-msvcrt.
// libglfw3.a is that static archive. lib-static-ucrt is a Visual C++ 2019
// DLL, not a MinGW library. The project links libglfw3dll.a and copies
// glfw3.dll, which depends on msvcrt.dll.
function GlfwWinClear()
{
    GlfwWinInclude = _T("");
    GlfwWinLib = _T("");
    GlfwWinDll = _T("");
}

function GlfwWinCompilerMatches(report)
{
    if (!GlfwReportField(report, _T("access")).Matches(_T("works")))
        return false;
    local machine = GlfwReportField(report, _T("machine"));
    return machine.Matches(_T("x86_64-w64-mingw32")) || machine.Matches(_T("i686-w64-mingw32"));
}

function GlfwWinSelectArchive(report)
{
    GlfwWinMachine = GlfwReportField(report, _T("machine"));
    if (GlfwWinMachine.Matches(_T("i686-w64-mingw32")))
    {
        GlfwWinEdition = _T("3.5.1-i686");
        GlfwWinUrl = _T("https://github.com/glfw/glfw/releases/download/3.5.1/glfw-3.5.1.bin.WIN32.zip");
        GlfwWinHash = _T("47ee7ce5307e11f8515a2bb2d6ace6d88ffd6dbcd614b87da21969261f3d0ffe");
    }
    else
    {
        GlfwWinEdition = _T("3.5.1-x86_64");
        GlfwWinUrl = _T("https://github.com/glfw/glfw/releases/download/3.5.1/glfw-3.5.1.bin.WIN64.zip");
        GlfwWinHash = _T("34c6766043e09ad9c6e88b5636a5f34d1f2857aae828768c5bf2016dc8821a93");
    }
}

// Empty string: this tree may be written into the project.
function GlfwWinSuitable(prefix)
{
    GlfwWinClear();
    if (prefix.IsEmpty())
        return _("GLFW's directory is missing. No project was created.");
    local sep = _T("\\");
    local includeDir = prefix + sep + _T("include");
    local libDir = prefix + sep + _T("lib-mingw-w64");
    if (!IO.FileExists(includeDir + sep + _T("GLFW") + sep + _T("glfw3.h")))
        return _("GLFW was found, but include/GLFW/glfw3.h is not under ") + prefix + _(". No project was created.");
    if (!IO.FileExists(libDir + sep + _T("libglfw3dll.a")))
        return _("GLFW was found, but lib-mingw-w64/libglfw3dll.a is not under ") + prefix + _(". No project was created.");
    local dll = libDir + sep + _T("glfw3.dll");
    if (!IO.FileExists(dll))
        return _("GLFW was found, but lib-mingw-w64/glfw3.dll is not under ") + prefix + _(". No project was created.");
    GlfwWinInclude = includeDir;
    GlfwWinLib = libDir;
    GlfwWinDll = dll;
    return _T("");
}

function GlfwWinDecide(prefix, nested)
{
    if (GlfwWinSuitable(prefix).IsEmpty())
        return _T("");
    if (!nested.IsEmpty() && GlfwWinSuitable(nested).IsEmpty())
        return _T("");
    if (!nested.IsEmpty())
        return GlfwWinSuitable(nested);
    return GlfwWinSuitable(prefix);
}

function GlfwWinBlockReason()
{
    local report = Wizard.WinSdkTree(_T("glfw"));
    GlfwWinState = GlfwReportField(report, _T("state"));
    if (GlfwWinState.Matches(_T("installed")))
        return GlfwWinDecide(GlfwReportField(report, _T("prefix")), GlfwReportField(report, _T("nested")));
    GlfwWinClear();
    if (GlfwWinState.Matches(_T("missing")))
        return _("GLFW is not installed. This wizard will not create a project.");
    return _("GLFW could not be checked. This wizard will not create a project.");
}

function GlfwWinPageText(reason)
{
    local text = _("No project is created from this page.\n\n");
    if (GlfwWinState.Matches(_T("missing")))
    {
        text = text + _("GLFW is not installed.\n\n") +
                      _("Press Next to install GLFW.\n") +
                      _("Cancel on that dialog does not start a download.\n") +
                      _("Use Cancel on this page to close the wizard.\n");
    }
    else
    {
        text = text + reason + _("\n\n") +
                      _("Use Cancel to close the wizard.\n");
    }
    return text;
}

function GlfwWinOfferInstall()
{
    local report = Wizard.WinSdkCompiler(Wizard.GetCompilerID());
    if (!GlfwWinCompilerMatches(report))
    {
        ShowError(_("The automatic GLFW install does not apply to this compiler. No project was created."));
        return false;
    }
    GlfwWinSelectArchive(report);
    local explanation = _("This project needs GLFW.\n\n") +
                        _("Nothing is downloaded until you choose Install GLFW.\n") +
                        _("Cancel on this dialog does not start a download.");
    local markers = _T("include/GLFW/glfw3.h;lib-mingw-w64/libglfw3dll.a;lib-mingw-w64/glfw3.dll");
    local staged = Wizard.WinSdkStage(GlfwWinUrl, GlfwWinHash, _T("glfw"), markers, explanation, _("Install GLFW"));
    if (!GlfwReportField(staged, _T("success")).Matches(_T("1")))
    {
        if (GlfwReportField(staged, _T("cancelled")).Matches(_T("1")))
        {
            ShowMessage(_("The download was stopped. Files already written are left in place. No project was created."));
            return false;
        }
        if (GlfwReportField(staged, _T("launched")).Matches(_T("1")))
        {
            ShowError(_("GLFW was not installed. No project was created.\n\n") +
                      GlfwReportField(staged, _T("output")));
        }
        return false;
    }

    local stagedPrefix = GlfwReportField(staged, _T("prefix"));
    local reason = GlfwWinSuitable(stagedPrefix);
    if (!reason.IsEmpty())
    {
        GlfwWinClear();
        ShowError(reason);
        return false;
    }

    local note = _T("library=glfw\nversion=3.5.1\nsource=") + GlfwWinUrl +
                 _T("\nsha256=") + GlfwWinHash +
                 _T("\nsha256_verified=") + GlfwWinHash +
                 _T("\ncompiler=") + GlfwWinMachine;
    local published = Wizard.WinSdkPublish(_T("glfw"), GlfwWinEdition, stagedPrefix, note);
    if (!GlfwReportField(published, _T("success")).Matches(_T("1")))
    {
        GlfwWinClear();
        ShowError(_("GLFW was not installed. No project was created.\n\n") +
                  GlfwReportField(published, _T("output")));
        return false;
    }
    reason = GlfwWinBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowMessage(GlfwWinPageText(reason));
    return false;
}

function OnLeave_GlfwWinDiag(fwd)
{
    if (!fwd)
        return true;
    if (GlfwWinBlockReason().IsEmpty())
        return true;
    if (GlfwWinState.Matches(_T("missing")))
        return GlfwWinOfferInstall();
    return false;
}

function GlfwWinAllowForward()
{
    if (PLATFORM != PLATFORM_MSW || GlfwWinAuto == 0)
        return true;
    if (!GlfwWinCompilerMatches(Wizard.WinSdkCompiler(Wizard.GetCompilerID())))
    {
        ShowError(_("The automatic GLFW install does not apply to this compiler. No project was created."));
        return false;
    }
    local reason = GlfwWinBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowError(reason);
    return false;
}

function OnLeave_ProjectPathPage(fwd)
{
    if (fwd)
    {
        if (!GlfwMacAllowForward())
            return false;
        return GlfwWinAllowForward();
    }
    return true;
}

function OnLeave_CompilerPage(fwd)
{
    if (fwd)
    {
        if (!GlfwMacAllowForward())
            return false;
        return GlfwWinAllowForward();
    }
    return true;
}

// return the files this project contains
function GetFilesDir()
{
    if (PLATFORM == PLATFORM_MAC)
        return _T("glfw/mac");
    if (PLATFORM == PLATFORM_MSW && GlfwWinAuto == 1)
        return _T("glfw/win");
    return _T("glfw/files");
}

// setup the already created project
function SetupProject(project)
{
    if (PLATFORM == PLATFORM_MAC)
    {
        // Prefix was accepted on the way through the wizard. No $(#glfw).
        if (GlfwMacInclude.IsEmpty() || GlfwMacLib.IsEmpty())
            return false;
        project.AddIncludeDir(GlfwMacInclude);
        project.AddLibDir(GlfwMacLib);
        project.AddLinkLib(_T("glfw"));
        // Proposed until a real link of the generated program confirms it.
        project.AddLinkerOption(_T("-framework OpenGL"));
    }
    else if (PLATFORM == PLATFORM_MSW && GlfwWinAuto == 1)
    {
        if (GlfwWinInclude.IsEmpty() || GlfwWinLib.IsEmpty() || GlfwWinDll.IsEmpty())
            return false;
        project.AddIncludeDir(GlfwWinInclude);
        project.AddLibDir(GlfwWinLib);
        project.AddCompilerOption(_T("-DGLFW_DLL"));
        project.AddLinkLib(_T("glfw3dll"));
        project.AddLinkLib(_T("opengl32"));
        project.AddLinkLib(_T("gdi32"));
        project.AddCommandsAfterBuild(_T("cmd /c copy /Y \"") + GlfwWinDll + _T("\" \"$(TARGET_OUTPUT_DIR)glfw3.dll\""));
    }
    else
    {
        // set project options
        project.AddIncludeDir(GlfwPathDefaultInc);
        project.AddLibDir(GlfwPathDefaultLib);

        // add link libraries
        project.AddLinkLib(_T("glfw3"));
        if (PLATFORM == PLATFORM_MSW)
        {
            project.AddLinkLib(_T("opengl32"));
            project.AddLinkLib(_T("glu32"));
            project.AddLinkLib(_T("gdi32"));
        }
        else
        {
            project.AddLinkLib(_T("GL"));
            project.AddLinkLib(_T("GLU"));
            project.AddLinkLib(_T("pthread"));
            project.AddLinkLib(_T("Xxf86vm"));
        }
    }

    // enable compiler warnings (project-wide)
    WarningsOn(project, Wizard.GetCompilerID());

    // Debug
    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly); // ttConsoleOnly: console for debugging
        target.SetOutputFilename(Wizard.GetDebugOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        if (PLATFORM != PLATFORM_MAC && GlfwWinAuto == 0)
            target.SetWorkingDir(GlfwPath + _T("/bin"));
        // enable generation of debugging symbols for target
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    // Release
    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable); // ttExecutable: no console
        target.SetOutputFilename(Wizard.GetReleaseOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        if (PLATFORM != PLATFORM_MAC && GlfwWinAuto == 0)
            target.SetWorkingDir(GlfwPath + _T("/bin"));
        // enable optimizations for target
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

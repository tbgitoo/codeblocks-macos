////////////////////////////////////////////////////////////////////////////////
//
// SDL3 project wizard
//
////////////////////////////////////////////////////////////////////////////////

// globals (Windows location page)
SDL3PathDefault    <- _T("$(#sdl3)");
SDL3PathDefaultInc <- _T("$(#sdl3.include)");
SDL3PathDefaultLib <- _T("$(#sdl3.lib)");
SDL3Path           <- _T("");
// macOS: filled only after the installed SDL3 tree is accepted
SDL3MacPrefix  <- _T("");
SDL3MacInclude <- _T("");
SDL3MacLib     <- _T("");
SDL3MacState   <- _T("");
SDL3MacAccess  <- _T("");
SDL3MacExecutable <- _T("");

function BeginWizard()
{
    local intro_msg = _("Welcome to the new SDL3 project wizard!\n\n") +
                      _("This wizard will guide you to create a new project\nusing the SDL3 library.\n\n") +
                      _("When you're ready to proceed, please click \"Next\"...");

    Wizard.AddInfoPage(_T("SDL3Intro"), intro_msg);
    // A suitable SDL3 install has no dependency page. Anything else stays on this page
    // until Cancel. The location page is not registered on macOS, so $(#sdl3) is not expanded.
    if (PLATFORM == PLATFORM_MAC)
    {
        local reason = SDL3MacBlockReason();
        if (!reason.IsEmpty())
            Wizard.AddInfoPage(_T("SDL3MacDiag"), SDL3MacPageText(reason));
    }
    Wizard.AddProjectPathPage();
    if (PLATFORM == PLATFORM_MSW)
    {
        local sdl3path_descr = _("Please select the folder where SDL3 is installed on your computer.\n") +
                               _("This is either the i686-w64-mingw32 (32-bit) or the x86_64-w64-mingw32 (64-bit)\nfolder under the top-level folder where SDL3 was unpacked.\n\n") +
                               _("To help you, this folder must contain the subfolders \"include\" and \"lib\".\n\n") +
                               _("You can also use a global variable, p.e. $(#sdl3)\n");

        Wizard.AddGenericSelectPathPage(_T("SDL3Path"), sdl3path_descr, _("Please select SDL3's location:"), SDL3PathDefault);
    }
    Wizard.AddCompilerPage(_T(""), _T("*"), true, true);
}

////////////////////////////////////////////////////////////////////////////////
// SDL3's path page (Windows)
////////////////////////////////////////////////////////////////////////////////

function OnLeave_SDL3Path(fwd)
{
    if (fwd)
    {
        local dir         = Wizard.GetTextControlValue(_T("txtFolder")); // txtFolder is the text control in GenericSelectPathPage
        local dir_nomacro = VerifyDirectory(dir);

        if (dir_nomacro.IsEmpty())
            return false;

        // verify include dependencies
        local dir_nomacro_inc = GetCompilerIncludeDir(dir, SDL3PathDefault, SDL3PathDefaultInc);
        if (dir_nomacro_inc.IsEmpty())
            return false;

        // The sample includes <SDL3/SDL.h>, so the include directory is the parent of SDL3/.
        if (!VerifyFile(dir_nomacro_inc, _T("SDL3/SDL.h"), _("SDL3's include")))
            return false;

        // verify library dependencies
        local dir_nomacro_lib = GetCompilerLibDir(dir, SDL3PathDefault, SDL3PathDefaultLib);
        if (dir_nomacro_lib.IsEmpty())
            return false;

        if (!VerifyLibFile(dir_nomacro_lib, _T("SDL3"), _("SDL3's")))
            return false;

        SDL3Path = dir; // Remember the original selection.

        local is_macro = _T("");

        // try to resolve the include directory as macro
        is_macro = GetCompilerIncludeMacro(dir, SDL3PathDefault, SDL3PathDefaultInc);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real inc path we had computed instead
            SDL3PathDefaultInc = dir_nomacro_inc;
        }

        // try to resolve the library directory as macro
        is_macro = GetCompilerLibMacro(dir, SDL3PathDefault, SDL3PathDefaultLib);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real lib path we had computed instead
            SDL3PathDefaultLib = dir_nomacro_lib;
        }
    }
    return true;
}

function SDL3ReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");
    local from = at + needle.Length();
    local rest = report.Mid(from, report.Length() - from);
    local nl = rest.Find(_T("\n"));
    if (nl == -1)
        return rest;
    return rest.Mid(0, nl);
}

function SDL3MacClear()
{
    SDL3MacPrefix = _T("");
    SDL3MacInclude = _T("");
    SDL3MacLib = _T("");
}

// Empty string: this prefix may be written into the project.
// Anything else: do not create a project.
function SDL3MacPrefixDecision(prefix)
{
    SDL3MacClear();
    if (prefix.IsEmpty() || (prefix.Find(_T("/")) != 0))
        return _("SDL3's prefix is not a directory. No project was created.");

    local includeDir = prefix + _T("/include");
    local libDir = prefix + _T("/lib");
    if (!IO.FileExists(includeDir + _T("/SDL3/SDL.h")))
        return _("SDL3 was found, but include/SDL3/SDL.h is not under ") + prefix + _(". No project was created.");
    if (!IO.FileExists(libDir + _T("/libSDL3.dylib")))
        return _("SDL3 was found, but libSDL3.dylib is not under ") + prefix + _("/lib. No project was created.");

    SDL3MacPrefix = prefix;
    SDL3MacInclude = includeDir;
    SDL3MacLib = libDir;
    return _T("");
}

function SDL3MacBlockReason()
{
    local report = Wizard.MacBrewFormula(_T("sdl3"));
    SDL3MacState = SDL3ReportField(report, _T("state"));
    SDL3MacAccess = SDL3ReportField(report, _T("access"));
    SDL3MacExecutable = SDL3ReportField(report, _T("executable"));
    if (SDL3MacState.Matches(_T("installed")))
        return SDL3MacPrefixDecision(SDL3ReportField(report, _T("prefix")));
    SDL3MacClear();
    if (SDL3MacState.Matches(_T("missing")))
        return _("Homebrew reports that SDL3 is not installed. This wizard will not create a project.");
    if (SDL3MacState.Matches(_T("brew_unavailable")))
        return _("Homebrew could not be used. This wizard will not create a project.");
    return _("Homebrew could not be asked about SDL3. This wizard will not create a project.");
}

function SDL3MacPageText(reason)
{
    local text = _("Some project templates obtain libraries through Homebrew.\n") +
                 _("Code::Blocks does not install Homebrew.\n\n");
    if (SDL3MacAccess.Matches(_T("works")))
    {
        text = text + _("Homebrew\n    Found: ") + SDL3MacExecutable +
               _("\n    Access from Code::Blocks: OK\n\n");
    }
    else if (SDL3MacAccess.Matches(_T("present_unusable")))
    {
        text = text + _("Homebrew\n    Found: ") + SDL3MacExecutable +
               _("\n    Access from Code::Blocks: failed\n") +
               _("That executable was left in place.\n\n");
    }
    else
    {
        text = text + _("Homebrew\n    Not detected\n\n");
    }

    if (SDL3MacState.Matches(_T("missing")))
        text = text + _("SDL3\n    Not installed\n\n");
    else if (SDL3MacAccess.Matches(_T("works")) && !reason.IsEmpty())
        text = text + reason + _("\n\n");

    text = text + _("No project is created from this page.\n");
    if (SDL3MacState.Matches(_T("missing")))
        text = text + _("Press Next to install the sdl3 formula with Homebrew.\n") +
                      _("Cancel on that dialog does not start the install.\n") +
                      _("Use Cancel on this page to close the wizard.\n");
    else if (SDL3MacAccess.Matches(_T("works")))
        text = text + _("Use Cancel to close the wizard.\n");
    else
        text = text + _("Press Next to choose an existing brew executable, or to open https://brew.sh.\n") +
                      _("Use Cancel to close the wizard.\n");
    return text;
}

// Empty string: the path passed --version and was stored.
// A failed file is not stored, and a previous saved path is left as it was.
function SDL3MacConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacBrewTry(path, true);
    local access = SDL3ReportField(report, _T("access"));
    if (access.Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }
    return _("That file did not pass brew --version, so it was not remembered.") +
           _("\n\n") + SDL3ReportField(report, _T("executable")) +
           _("\n") + SDL3ReportField(report, _T("version"));
}

function SDL3MacOfferInstall()
{
    local explanation = _("This project needs SDL3.\n\n") +
                        _("Code::Blocks will ask Homebrew to install the formula \"sdl3\".\n") +
                        _("Nothing is installed until you choose Install SDL3 using Homebrew.\n") +
                        _("Cancel on this dialog does not start Homebrew.");
    local report = Wizard.MacBrewInstall(_T("sdl3"), explanation, _("Install SDL3 using Homebrew"));
    if (SDL3ReportField(report, _T("success")).Matches(_T("1")))
    {
        local reason = SDL3MacBlockReason();
        if (reason.IsEmpty())
            return true;
        ShowMessage(SDL3MacPageText(reason));
        return false;
    }
    if (SDL3ReportField(report, _T("password")).Matches(_T("1")))
    {
        ShowError(_("Homebrew asked for a password. The install was stopped and is not treated as successful. No project was created."));
        return false;
    }
    if (SDL3ReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The install was stopped. That does not undo files Homebrew may already have written. No project was created."));
        return false;
    }
    if (SDL3ReportField(report, _T("launched")).Matches(_T("1")))
    {
        ShowError(_("Homebrew did not finish successfully. SDL3 was not marked installed. No project was created.\n\n") +
                  SDL3ReportField(report, _T("output")));
    }
    return false;
}

function OnLeave_SDL3MacDiag(fwd)
{
    if (!fwd)
        return true;
    if (SDL3MacBlockReason().IsEmpty())
        return true;
    if (!SDL3MacAccess.Matches(_T("works")))
    {
        local choice = Wizard.MacBrewChoice(
            _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
            _("Help me find Homebrew"),
            _("Installation instructions"));
        if (choice == 1)
        {
            local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
            local rejected = SDL3MacConsiderBrew(picked);
            if (!rejected.IsEmpty())
                ShowError(rejected);
        }
        else if (choice == 2)
        {
            wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
        }
        if (SDL3MacBlockReason().IsEmpty())
            return true;
        return false;
    }
    if (SDL3MacState.Matches(_T("missing")))
        return SDL3MacOfferInstall();
    return false;
}

function SDL3MacAllowForward()
{
    if (PLATFORM != PLATFORM_MAC)
        return true;
    local reason = SDL3MacBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowError(reason);
    return false;
}

function OnLeave_ProjectPathPage(fwd)
{
    if (fwd)
        return SDL3MacAllowForward();
    return true;
}

function OnLeave_CompilerPage(fwd)
{
    if (fwd)
        return SDL3MacAllowForward();
    return true;
}

// return the files this project contains
function GetFilesDir()
{
    return _T("sdl3/files");
}

// setup the already created project
function SetupProject(project)
{
    if (PLATFORM == PLATFORM_MAC)
    {
        // Prefix was accepted on the way through the wizard. No $(#sdl3).
        if (SDL3MacInclude.IsEmpty() || SDL3MacLib.IsEmpty())
            return false;
        project.AddIncludeDir(SDL3MacInclude);
        project.AddLibDir(SDL3MacLib);
        project.AddLinkLib(_T("SDL3"));
    }
    else if (PLATFORM == PLATFORM_MSW)
    {
        project.AddIncludeDir(SDL3PathDefaultInc);
        project.AddLibDir(SDL3PathDefaultLib);
        project.AddLinkLib(_T("SDL3"));
        project.AddCommandsAfterBuild(_T("XCOPY $(#sdl3)\\bin\\*.dll $(TARGET_OUTPUT_DIR) /D /Y"));
    }
    else
    {
        project.AddCompilerOption(_T("`pkg-config --cflags sdl3`"));
        project.AddLinkerOption(_T("`pkg-config --libs sdl3`"));
    }

    // enable compiler warnings (project-wide)
    WarningsOn(project, Wizard.GetCompilerID());

    // Debug
    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly); // ttConsoleOnly: console for debugging
        target.SetOutputFilename(Wizard.GetDebugOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        // enable generation of debugging symbols for target
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    // Release
    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable); // ttExecutable: no console
        target.SetOutputFilename(Wizard.GetReleaseOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        // enable optimizations for target
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

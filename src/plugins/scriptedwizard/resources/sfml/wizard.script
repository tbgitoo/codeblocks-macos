////////////////////////////////////////////////////////////////////////////////
//
// SFML project wizard
//
////////////////////////////////////////////////////////////////////////////////

// globals
SFMLVersion <- 1	// 0 - SFML 1.6, 1 - SFML 2.0
SFMLLinkType <- 1	// 0 - static library, 1 - dynamic link library
SFMLDebugLib <- 0   // 0 - debug libraries are not available, 1 - debug libraries are available
// windows globals
SFMLPathDefault    <- _T("$(#sfml)");
SFMLPathDefaultInc <- _T("$(#sfml.include)");
SFMLPathDefaultLib <- _T("$(#sfml.lib)");
SFMLPath           <- _T("");
// macOS: filled only after the installed SFML tree is accepted
SFMLMacPrefix  <- _T("");
SFMLMacInclude <- _T("");
SFMLMacLib     <- _T("");
SFMLMacState   <- _T("");
SFMLMacAccess  <- _T("");
SFMLMacExecutable <- _T("");

function BeginWizard()
{
    local intro_msg = _("Welcome to the new SFML project wizard!\n\n") +
                      _("This wizard will guide you to create a new project\nusing the Simple and Fast Multimedia Library.\n\n") +
                      _("When you're ready to proceed, please click \"Next\"...");

    Wizard.AddInfoPage(_T("SFMLIntro"), intro_msg);
    // macOS reads SFML_VERSION_MAJOR from the installed headers. Do not ask 1.6 versus 2.0.
    if (PLATFORM != PLATFORM_MAC)
        Wizard.AddGenericSingleChoiceListPage(_T("SFMLVersionPage"), _("Please select the SFML version you want to use."), _T("SFML 1.6;SFML 2.0"), SFMLVersion);
    if (PLATFORM == PLATFORM_MSW)
        Wizard.AddGenericSingleChoiceListPage(_T("SFMLLinkPage"), _("Please choose the kind of library you want to link to."), _("Static Library;Dynamic Link Library"), SFMLLinkType);

    // A suitable SFML install has no dependency page. Anything else stays on this page
    // until Cancel. Project path is still registered because the wizard requires it.
    if (PLATFORM == PLATFORM_MAC)
    {
        local reason = SfmlMacBlockReason();
        if (!reason.IsEmpty())
            Wizard.AddInfoPage(_T("SFMLMacDiag"), SfmlMacPageText(reason));
    }

    Wizard.AddProjectPathPage();
    if (PLATFORM == PLATFORM_MSW)
    {
        local sfmlpath_descr = _("Please select the location of SFML on your computer.\n") +
                               _("This is the top-level folder where SFML was installed (unpacked).\n") +
                               _("To help you, this folder must contain the subfolders\n\"include\" and \"lib\".\n\n") +
                               _("You can also use a global variable, p.e. $(#sfml)\n");

        Wizard.AddGenericSelectPathPage(_T("SFMLPath"), sfmlpath_descr, _("Please select SFML's location:"), SFMLPathDefault);
    }

    Wizard.AddCompilerPage(_T(""), _T("*"), true, true);
}

////////////////////////////////////////////////////////////////////////////////
// SFML's path page
////////////////////////////////////////////////////////////////////////////////

function OnLeave_SFMLPath(fwd)
{
    if (fwd)
    {
        local dir         = Wizard.GetTextControlValue(_T("txtFolder")); // txtFolder is the text control in GenericSelectPathPage
        local dir_nomacro = VerifyDirectory(dir);

        if (dir_nomacro.IsEmpty())
            return false;

        // verify include dependencies
        local dir_nomacro_inc = GetCompilerIncludeDir(dir, SFMLPathDefault, SFMLPathDefaultInc);
        if (dir_nomacro_inc.IsEmpty())
            return false;
        if (!VerifyFile(dir_nomacro_inc, _T("SFML/Config.hpp"), _("SFML's include")))
            return false;
        if (!VerifyFile(dir_nomacro_inc, _T("SFML/Graphics.hpp"), _("SFML's include")))
            return false;
        if (!VerifyFile(dir_nomacro_inc, _T("SFML/System.hpp"), _("SFML's include")))
            return false;
        if (!VerifyFile(dir_nomacro_inc, _T("SFML/Window.hpp"), _("SFML's include")))
            return false;

        // verify library dependencies
        local dir_nomacro_lib = GetCompilerLibDir(dir, SFMLPathDefault, SFMLPathDefaultLib);
        if (dir_nomacro_lib.IsEmpty())
            return false;

        if (!VerifyLibFile(dir_nomacro_lib, _T("sfml-audio"), _("SFML's")))
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("sfml-graphics"), _("SFML's")))
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("sfml-network"), _("SFML's")))
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("sfml-system"), _("SFML's")))
            return false;
        if (!VerifyLibFile(dir_nomacro_lib, _T("sfml-window"), _("SFML's")))
            return false;

        if (   SilentVerifyLibFile(dir_nomacro_lib, _T("sfml-window-d"))
            || SilentVerifyLibFile(dir_nomacro_lib, _T("sfml-window-s-d")) )
        {
            // assume the other debug files exist if these exist
            SFMLDebugLib = 1;
        }

        SFMLPath = dir; // Remember the original selection.

        local is_macro = _T("");

        // try to resolve the include directory as macro
        is_macro = GetCompilerIncludeMacro(dir, SFMLPathDefault, SFMLPathDefaultInc);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real inc path we had computed instead
            SFMLPathDefaultInc = dir_nomacro_inc;
        }

        // try to resolve the library directory as macro
        is_macro = GetCompilerLibMacro(dir, SFMLPathDefault, SFMLPathDefaultLib);
        if (is_macro.IsEmpty())
        {
            // not possible -> use the real lib path we had computed instead
            SFMLPathDefaultLib = dir_nomacro_lib;
        }
    }
    return true;
}

function SfmlReportField(report, key)
{
    local needle = key + _T("=");
    local at = report.Find(needle);
    if (at == -1)
        return _T("");
    local from = at + needle.Length();
    local rest = report.Mid(from, report.Length() - from);
    local nl = rest.Find(_T("\n"));
    if (nl == -1)
        return rest;
    return rest.Mid(0, nl);
}

// Reads the number after the first SFML_VERSION_MAJOR on its own line.
// Returns 1, 2, 3, or -1 when the macro is missing or not one of those majors.
function SfmlMajorFromConfig(configText)
{
    local key = _T("SFML_VERSION_MAJOR");
    local at = configText.Find(key);
    if (at == -1)
        return -1;
    local from = at + key.Length();
    local rest = configText.Mid(from, configText.Length() - from);
    local i = 0;
    local n = rest.Length();
    while (i < n)
    {
        local ch = rest.Mid(i, 1);
        if (ch.Matches(_T("\n")) || ch.Matches(_T("\r")))
            return -1;
        if (ch.Matches(_T(" ")) || ch.Matches(_T("\t")))
        {
            i = i + 1;
            continue;
        }
        break;
    }
    local digits = _T("");
    while (i < n)
    {
        local ch = rest.Mid(i, 1);
        if (_T("0123456789").Find(ch) == -1)
            break;
        digits = digits + ch;
        i = i + 1;
    }
    if (digits.Matches(_T("1")))
        return 1;
    if (digits.Matches(_T("2")))
        return 2;
    if (digits.Matches(_T("3")))
        return 3;
    return -1;
}

function SfmlMacClear()
{
    SFMLMacPrefix = _T("");
    SFMLMacInclude = _T("");
    SFMLMacLib = _T("");
}

// Empty string: this prefix may be written into the project.
// Anything else: do not create a project.
function SfmlMacPrefixDecision(prefix)
{
    SfmlMacClear();
    if (prefix.IsEmpty() || (prefix.Find(_T("/")) != 0))
        return _("SFML's prefix is not a directory. No project was created.");

    local includeDir = prefix + _T("/include");
    local libDir = prefix + _T("/lib");
    local config = includeDir + _T("/SFML/Config.hpp");
    local graphics = includeDir + _T("/SFML/Graphics.hpp");
    if (!IO.FileExists(graphics))
        return _("SFML was found, but include/SFML/Graphics.hpp is not under ") + prefix + _(". No project was created.");
    if (!IO.FileExists(config))
        return _("SFML was found, but include/SFML/Config.hpp is not under ") + prefix + _(". No project was created.");
    if (   !IO.FileExists(libDir + _T("/libsfml-graphics.dylib"))
        || !IO.FileExists(libDir + _T("/libsfml-window.dylib"))
        || !IO.FileExists(libDir + _T("/libsfml-system.dylib")) )
    {
        return _("SFML was found, but libsfml-graphics, libsfml-window, or libsfml-system is not under ") + prefix + _("/lib. No project was created.");
    }

    local major = SfmlMajorFromConfig(IO.ReadFileContents(config));
    if (major == 2)
    {
        SFMLVersion = 1; // existing sfml/sfml2 sample
        SFMLMacPrefix = prefix;
        SFMLMacInclude = includeDir;
        SFMLMacLib = libDir;
        return _T("");
    }
    if (major == 3)
        return _("SFML 3 was found at ") + prefix + _(". This wizard's sample is for SFML 2, and an SFML 3 sample is not included yet. No project was created.");
    if (major == 1)
        return _("SFML 1 was found at ") + prefix + _(". This wizard does not create an SFML 1 project on macOS. No project was created.");
    return _("SFML was found at ") + prefix + _(", but SFML_VERSION_MAJOR could not be read from include/SFML/Config.hpp. No project was created.");
}

function SfmlMacBlockReason()
{
    local report = Wizard.MacBrewFormula(_T("sfml"));
    SFMLMacState = SfmlReportField(report, _T("state"));
    SFMLMacAccess = SfmlReportField(report, _T("access"));
    SFMLMacExecutable = SfmlReportField(report, _T("executable"));
    if (SFMLMacState.Matches(_T("installed")))
        return SfmlMacPrefixDecision(SfmlReportField(report, _T("prefix")));
    SfmlMacClear();
    if (SFMLMacState.Matches(_T("missing")))
        return _("Homebrew reports that SFML is not installed. This wizard will not create a project.");
    if (SFMLMacState.Matches(_T("brew_unavailable")))
        return _("Homebrew could not be used. This wizard will not create a project.");
    return _("Homebrew could not be asked about SFML. This wizard will not create a project.");
}

function SfmlMacPageText(reason)
{
    local text = _("Some project templates obtain libraries through Homebrew.\n") +
                 _("Code::Blocks does not install Homebrew.\n\n");
    if (SFMLMacAccess.Matches(_T("works")))
    {
        text = text + _("Homebrew\n    Found: ") + SFMLMacExecutable +
               _("\n    Access from Code::Blocks: OK\n\n");
    }
    else if (SFMLMacAccess.Matches(_T("present_unusable")))
    {
        text = text + _("Homebrew\n    Found: ") + SFMLMacExecutable +
               _("\n    Access from Code::Blocks: failed\n") +
               _("That executable was left in place.\n\n");
    }
    else
    {
        text = text + _("Homebrew\n    Not detected\n\n");
    }

    if (SFMLMacState.Matches(_T("missing")))
        text = text + _("SFML\n    Not installed\n\n");
    else if (SFMLMacAccess.Matches(_T("works")) && !reason.IsEmpty())
        text = text + reason + _("\n\n");

    text = text + _("No project is created from this page.\n");
    if (SFMLMacState.Matches(_T("missing")))
        text = text + _("Press Next to install the sfml formula with Homebrew.\n") +
                      _("Cancel on that dialog does not start the install.\n") +
                      _("Use Cancel on this page to close the wizard.\n");
    else if (SFMLMacAccess.Matches(_T("works")))
        text = text + _("Use Cancel to close the wizard.\n");
    else
        text = text + _("Press Next to choose an existing brew executable, or to open https://brew.sh.\n") +
                      _("Use Cancel to close the wizard.\n");
    return text;
}

// Empty string: the path passed --version and was stored.
// A failed file is not stored, and a previous saved path is left as it was.
function SfmlMacConsiderBrew(path)
{
    if (path.IsEmpty())
        return _T("");
    local report = Wizard.MacBrewTry(path, true);
    local access = SfmlReportField(report, _T("access"));
    if (access.Matches(_T("works")))
    {
        GetConfigManager().Write(_T("/macos/homebrew/executable"), path);
        return _T("");
    }
    return _("That file did not pass brew --version, so it was not remembered.") +
           _("\n\n") + SfmlReportField(report, _T("executable")) +
           _("\n") + SfmlReportField(report, _T("version"));
}

function SfmlMacOfferInstall()
{
    local explanation = _("This project needs SFML.\n\n") +
                        _("Code::Blocks will ask Homebrew to install the formula \"sfml\".\n") +
                        _("Nothing is installed until you choose Install SFML using Homebrew.\n") +
                        _("Cancel on this dialog does not start Homebrew.");
    local report = Wizard.MacBrewInstall(_T("sfml"), explanation, _("Install SFML using Homebrew"));
    if (SfmlReportField(report, _T("success")).Matches(_T("1")))
    {
        local reason = SfmlMacBlockReason();
        if (reason.IsEmpty())
            return true;
        ShowMessage(SfmlMacPageText(reason));
        return false;
    }
    if (SfmlReportField(report, _T("password")).Matches(_T("1")))
    {
        ShowError(_("Homebrew asked for a password. The install was stopped and is not treated as successful. No project was created."));
        return false;
    }
    if (SfmlReportField(report, _T("cancelled")).Matches(_T("1")))
    {
        ShowMessage(_("The install was stopped. That does not undo files Homebrew may already have written. No project was created."));
        return false;
    }
    if (SfmlReportField(report, _T("launched")).Matches(_T("1")))
    {
        ShowError(_("Homebrew did not finish successfully. SFML was not marked installed. No project was created.\n\n") +
                  SfmlReportField(report, _T("output")));
    }
    return false;
}

function OnLeave_SFMLMacDiag(fwd)
{
    if (!fwd)
        return true;
    if (SfmlMacBlockReason().IsEmpty())
        return true;
    if (!SFMLMacAccess.Matches(_T("works")))
    {
        local choice = Wizard.MacBrewChoice(
            _("Code::Blocks will not install Homebrew.\n\nChoose an existing brew executable, or open the Homebrew site."),
            _("Help me find Homebrew"),
            _("Installation instructions"));
        if (choice == 1)
        {
            local picked = IO.SelectFile(_("Choose the brew executable"), _T(""), _("All files (*)|*"));
            local rejected = SfmlMacConsiderBrew(picked);
            if (!rejected.IsEmpty())
                ShowError(rejected);
        }
        else if (choice == 2)
        {
            wxLaunchDefaultBrowser(_T("https://brew.sh"), 0);
        }
        if (SfmlMacBlockReason().IsEmpty())
            return true;
        return false;
    }
    if (SFMLMacState.Matches(_T("missing")))
        return SfmlMacOfferInstall();
    return false;
}

function SfmlMacAllowForward()
{
    if (PLATFORM != PLATFORM_MAC)
        return true;
    local reason = SfmlMacBlockReason();
    if (reason.IsEmpty())
        return true;
    ShowError(reason);
    return false;
}

function OnLeave_ProjectPathPage(fwd)
{
    if (fwd)
        return SfmlMacAllowForward();
    return true;
}

function OnLeave_CompilerPage(fwd)
{
    if (fwd)
        return SfmlMacAllowForward();
    return true;
}

function OnEnter_SFMLVersionPage(fwd)
{
    if (fwd)
    {
        SFMLVersion = Wizard.GetListboxSelection(_T("GenericChoiceList"));
    }
    return true;
}

function OnLeave_SFMLVersionPage(fwd)
{
    if (fwd)
    {
        SFMLVersion = Wizard.GetListboxSelection(_T("GenericChoiceList"));
    }
    return true;
}

function OnEnter_SFMLLinkPage(fwd)
{
    if (fwd)
    {
        SFMLLinkType = Wizard.GetListboxSelection(_T("GenericChoiceList"));
    }
    return true;
}

function OnLeave_SFMLLinkPage(fwd)
{
    if (fwd)
    {
        SFMLLinkType = Wizard.GetListboxSelection(_T("GenericChoiceList"));
    }
    return true;
}

// return the files this project contains
function GetFilesDir()
{
    if(SFMLVersion == 1)
        return _T("sfml/sfml2");
    return _T("sfml/sfml1");
}

// setup the already created project
function SetupProject(project)
{
    if (PLATFORM == PLATFORM_MSW)
    {
        project.AddIncludeDir(SFMLPathDefaultInc);
        project.AddLibDir(SFMLPathDefaultLib);

        // add link libraries
        project.AddLinkLib(_T("mingw32"));
        project.AddLinkLib(_T("user32"));
        project.AddLinkLib(_T("gdi32"));
        project.AddLinkLib(_T("winmm"));
        project.AddLinkLib(_T("dxguid"));
        if (SFMLLinkType == 0) // static library
        {
            project.AddCompilerOption(_T("-DSFML_STATIC"));
        }
    }
    else if (PLATFORM == PLATFORM_MAC)
    {
        // Prefix was accepted on the way through the wizard. No -framework SFML.
        if (SFMLMacInclude.IsEmpty() || SFMLMacLib.IsEmpty())
            return false;
        project.AddIncludeDir(SFMLMacInclude);
        project.AddLibDir(SFMLMacLib);
    }
    else
    {
        // unix way
        // TODO: Enable these once SFML gets a sfml.pc
        //project.AddCompilerOption(_T("`pkg-config sfml --cflags`"));
        //project.AddLinkerOption(_T("`pkg-config sfml --libs`"));
    }

    // enable compiler warnings (project-wide)
    WarningsOn(project, Wizard.GetCompilerID());

    // Debug
    local target = project.GetBuildTarget(Wizard.GetDebugName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttConsoleOnly); // ttConsoleOnly: console for debugging
        target.SetOutputFilename(Wizard.GetDebugOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        local suffix = _T("");
        if (SFMLDebugLib == 1)
            suffix = _T("-d");
        if(SFMLLinkType == 1)	// DLL library
        {
            target.AddLinkLib(_T("sfml-graphics") + suffix);
            target.AddLinkLib(_T("sfml-window") + suffix);
            target.AddLinkLib(_T("sfml-system") + suffix);
        }
        else	// static library
        {
            target.AddLinkLib(_T("sfml-graphics-s") + suffix);
            target.AddLinkLib(_T("sfml-window-s") + suffix);
            target.AddLinkLib(_T("sfml-system-s") + suffix);
            target.AddLinkLib(_T("sfml-main") + suffix);
        }
        // enable generation of debugging symbols for target
        DebugSymbolsOn(target, Wizard.GetCompilerID());
    }

    // Release
    target = project.GetBuildTarget(Wizard.GetReleaseName());
    if (!IsNull(target))
    {
        target.SetTargetType(ttExecutable); // ttExecutable: no console
        target.SetOutputFilename(Wizard.GetReleaseOutputDir() + Wizard.GetProjectName() + DOT_EXT_EXECUTABLE);
        if(SFMLLinkType == 1)	// DLL library
        {
            target.AddLinkLib(_T("sfml-graphics"));
            target.AddLinkLib(_T("sfml-window"));
            target.AddLinkLib(_T("sfml-system"));
        }
        else	// static library
        {
            target.AddLinkLib(_T("sfml-graphics-s"));
            target.AddLinkLib(_T("sfml-window-s"));
            target.AddLinkLib(_T("sfml-system-s"));
            target.AddLinkLib(_T("sfml-main"));
        }
        // enable optimizations for target
        OptimizationsOn(target, Wizard.GetCompilerID());
    }

    return true;
}

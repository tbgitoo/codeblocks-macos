diff --git a/src/zziplib/zzip/plugin.c b/src/zziplib/zzip/plugin.c
index ee578f4..0daa56a 100644
--- a/src/zziplib/zzip/plugin.c
+++ b/src/zziplib/zzip/plugin.c
@@ -26,6 +26,25 @@
 #include <zzip/file.h>
 #include <zzip/format.h>
 
+#if defined(__MINGW32__)
+/* The MSVC CRT _read/_write take an unsigned int count. zziplib's plugin
+ * calls use zzip_size_t, which is 64-bit on Win64. GCC 14 rejects the
+ * incompatible function-pointer types. Adapt at the boundary. */
+static zzip_ssize_t zzip_mingw_read(int fd, void *buf, zzip_size_t len)
+{
+    if (len > 0xffffffffu)
+        len = 0xffffffffu;
+    return (zzip_ssize_t) _read(fd, buf, (unsigned int) len);
+}
+
+static zzip_ssize_t zzip_mingw_write(int fd, const void *buf, zzip_size_t len)
+{
+    if (len > 0xffffffffu)
+        len = 0xffffffffu;
+    return (zzip_ssize_t) _write(fd, buf, (unsigned int) len);
+}
+#endif
+
 zzip_off_t
 zzip_filesize(int fd)
 {
@@ -46,11 +65,19 @@ zzip_filesize(int fd)
 static const struct zzip_plugin_io default_io = {
     &open,
     &close,
+#if defined(__MINGW32__)
+    &zzip_mingw_read,
+#else
     &_zzip_read,
+#endif
     &_zzip_lseek,
     &zzip_filesize,
     1, 1,
+#if defined(__MINGW32__)
+    &zzip_mingw_write
+#else
     &_zzip_write
+#endif
 };
 
